; Audited from x17 c900697 examples/lib/mem.sm, 2026-11-08 (docs/x17-import.md).
; No twin: register and Y plumbing only, ISA per the reference.md entries named below.
; Y slots and A registers from scalar registers, shared by the codec libraries.
;
; Moves into A registers go s -> e (x17.mve, +1) -> R (x19.a3 AGU10 fn 2, +1) -> even A
; (x12.aset) -> any A (x03.agu + 0): every step gated (reference.md `x17.mve`, `x19.a3`,
; `x12.aset`, `x03.agu`). They use s13, e6, R7 and A14, and
; x03.agu's X read slot loads s7 (from X:[A0]), so s7 does not survive them.

; e6 = addr: one lde (reference.md `lde`, own-entry: k = 2, 3, 5..15 load e<k> <- #imm16).
.macro yat(addr) {
        lde e6, #addr
}

.macro yld(dst, addr) {
        yat(addr)
        ldy dst, e6
}

; Y:[addr] = s3.
.macro yst(addr) {
        yat(addr)
        x17.sty e6, #3, #0
}

; A<an> = the value in `src` (not s13). Clobbers s7.
.macro amov(an, src) {
        ldi s13, #2
        alu s13, src, s13, #OP_SUB
        x17.mve e6, s13
        x19.a3 s0, R7, e6, #25, #2, #0
        x12.aset #7, R7
        x03.agu an, A14, #0, #0, A0
}

.macro aimm(an, value) {
        ldi s12, #value
        amov(an, s12)
}
