; Audited from x17 2f5d48b examples/lib/dequant.sm, 2026-11-08 (docs/x17-import.md).
; Twin: ref/dsp/aac/dequant.zig; ISO/IEC 14496-3 4.6.1.3 (inverse quantisation, scale factors).
; AAC inverse quantisation: the twin of ref/dsp/aac/dequant.zig `dequantChannel`.
;
; A channel comes out as words with one exponent, value = w * 2^E, the IMDCT's block-floating
; form. Pass 1 finds E from each spectral band's largest |q|; pass 2 writes every coefficient,
; P = round(m * G / 2^23) shifted right (rounded) by E - (em + 2 + floor((sf - 100) / 4)), at
; most 23. |q|^(4/3) = m * 2^em comes from a direct table to 128, above it from the reference's
; Q13 interpolation with s found by comparisons (dq_mant).
;
; Needs lib/bits.sm (constants, nop, s14 = 1), lib/mem.sm and lib/sections.sm (the
; band lists at AAC_BOOK and AAC_SF). Tables, loaded by the host:
;   X DQ_D   k^(4/3) for k = 0..128 as pairs m, em (m in [2^22, 2^23))
;   X DQ_IT  round(j^(4/3) * 2^13), j = 64..128
;   X DQ_G   round(2^(rem / 3 + b / 4) * 2^21), indexed 4 rem + b
;   Y DQ_IE  floor(4s / 3) - 13 and Y DQ_IR 4 (s mod 3), s = 0..7
;   Y DQ_OFF swb_offset for the window size
; Shape slots in Y: DQ_GRP groups, DQ_MAX max_sfb, DQ_WIN window length (1024 or 128),
; DQ_GLEN group lengths. Spectrum q in X at DQ_SPEC (sign-extended words), words out at DQ_OUT,
; E out at Y DQ_E. Uses every s register but s14, s15; e6..e11; A2, A3, A8, A9 and mem.sm's.

.const DQ_D    = 0x1800
.const DQ_IT   = 0x1910
.const DQ_G    = 0x1960
.const DQ_SPEC = 0x0000
.const DQ_OUT  = 0x0400
.const DQ_IE   = 0x24E4
.const DQ_IR   = 0x24EC
.const DQ_OFF  = 0x2508
.const DQ_Y    = 0x24F4
.const DQ_GRP  = DQ_Y + 0
.const DQ_MAX  = DQ_Y + 1
.const DQ_WIN  = DQ_Y + 2
.const DQ_GLEN = DQ_Y + 3       ; 8 words
.const DQ_E    = DQ_Y + 11
.const DQ_GL   = DQ_Y + 12      ; groups left
.const DQ_SL   = DQ_Y + 13      ; bands left in the group
.const DQ_WB   = DQ_Y + 14      ; the group's first window * window length
.const DQ_WL   = DQ_Y + 15      ; windows left in the band
.const DQ_CW   = DQ_Y + 16      ; this window's base
.const DQ_GB   = DQ_Y + 17      ; DQ_G + b
.const DQ_MQ   = DQ_Y + 18      ; the band's largest |q|
.const DQ_NONE = -32767         ; E before any band

; dq_mant(): s1 = mag (1..16383) -> s2 = m, s3 = em, s5 = 4 rem: |q|^(4/3) = m * 2^em * 2^(rem/3).
; Uses s4, s6, s7, s8, s12, s13, A8 and amov's registers (amov clobbers s7: f is made after it).
.macro dq_mant() {
        ldi s12, #128
        alu s12, s12, s1, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; mag > 128
        jmp #3, #3, big
        ldi s4, #DQ_D           ; (delay slot)
        nop()
        alu s4, s4, s1, #OP_ADD
        alu s4, s4, s1, #OP_ADD ; DQ_D + 2 mag
        amov_e(4, s4)
        x19.xrd s4, #8          ; m
        x02.ainc #8, #8
        x19.xrd s3, #8          ; em
        alu s2, s4, s0, #OP_ADD
        jmp #ALWAYS, #0, done
        ldi s5, #0              ; (delay slot) rem = 0
        nop()
big:    ldi s6, #1              ; s
        ldi s7, #256            ; 2^(7 + s)
more:   alu s12, s1, s7, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, found
        nop()
        nop()
        alu s6, s6, s14, #OP_ADD
        jmp #ALWAYS, #0, more
        alu s7, s7, s7, #OP_ADD ; (delay slot)
        nop()
found:  alu s8, s6, s14, #OP_SUB
        x19.alu s8, s14, s8, #SHIFT ; 2^(s-1)
        alu s8, s1, s8, #OP_SUB
        alu s12, s0, s6, #OP_SUB
        x19.alu s8, s8, s12, #SHIFT ; j = floor(mag / 2^s)
        ldi s4, #DQ_IT - 64
        alu s4, s4, s8, #OP_ADD
        amov_e(4, s4)            ; (clobbers s7)
        x19.alu s12, s8, s6, #SHIFT
        alu s7, s1, s12, #OP_SUB ; f = mag - j 2^s
        x19.xrd s3, #8          ; lo
        x02.ainc #8, #8
        x19.xrd s4, #8          ; hi
        alu s4, s4, s3, #OP_SUB ; d
        ldi s12, #23
        alu s12, s12, s6, #OP_SUB
        x19.alu s7, s7, s12, #SHIFT ; f 2^(23 - s), below 2^23
        x02.mpy s8, s4, s7      ; round(d f / 2^s)
        alu s2, s3, s8, #OP_ADD ; m
        ldi s13, #DQ_IE - 1
        alu s13, s13, s6, #OP_ADD
        x17.mve e6, s13
        ldy s3, e6              ; em
        ldi s13, #DQ_IR - 1
        alu s13, s13, s6, #OP_ADD
        x17.mve e6, s13
        ldy s5, e6              ; 4 rem
done:
}

; dq_mant's em alone, for pass 1: s1 = mag (1..16383) -> s3 = em. Uses s4, s6, s7, s12, s13,
; A8 and amov's registers.
.macro dq_em() {
        ldi s12, #128
        alu s12, s12, s1, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; mag > 128
        jmp #3, #3, big
        ldi s4, #DQ_D + 1       ; (delay slot)
        nop()
        alu s4, s4, s1, #OP_ADD
        alu s4, s4, s1, #OP_ADD ; DQ_D + 2 mag + 1
        amov_e(4, s4)
        jmp #ALWAYS, #0, done
        x19.xrd s3, #8          ; (delay slot) em
        nop()
big:    ldi s6, #1              ; s
        ldi s7, #256            ; 2^(7 + s)
more:   alu s12, s1, s7, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, found
        nop()
        nop()
        alu s6, s6, s14, #OP_ADD
        jmp #ALWAYS, #0, more
        alu s7, s7, s7, #OP_ADD ; (delay slot)
        nop()
found:  ldi s13, #DQ_IE - 1
        alu s13, s13, s6, #OP_ADD
        x17.mve e6, s13
        ldy s3, e6              ; em
done:
}

; s7 = floor((sf - 100) / 4) + 2 and s6 = (sf - 100) mod 4, sf at Y:[e8]. Uses s4, s12.
.macro dq_sh() {
        ldy s6, e8
        ldi s4, #100
        alu s6, s6, s4, #OP_SUB ; t
        ldi s4, #2
        alu s7, s6, s4, #OP_SUB
        ldi s12, #-2
        x19.alu s7, s7, s12, #SHIFT ; floor(t / 4)
        x19.alu s12, s7, s4, #SHIFT
        alu s6, s6, s12, #OP_SUB ; b
        alu s7, s7, s4, #OP_ADD ; + 2
}

; RD = s<src> (mem.sm's amov R path). Uses s13, e6.
.macro dq_rset(src, RD) {
        ldi s13, #2
        alu s13, src, s13, #OP_SUB
        x17.mve e6, s13
        x19.a3 s0, RD, e6, #25, #2, #0
}

; Pass 2's run constants: s9 = 129, s11 = 23, s12 = 2^23 - 1, s13 = G = X[Y:[DQ_GB]] (rem 0),
; A12 = DQ_D, R5 = DQ_OUT - DQ_SPEC - 1. Uses s3, s4 and amov's registers.
.macro dq_fset() {
        ldi s9, #129
        ldi s11, #22
        x19.alu s12, s14, s11, #SHIFT ; 2^22
        alu s3, s12, s14, #OP_SUB
        alu s12, s12, s3, #OP_ADD ; 2^23 - 1
        ldi s11, #23
        yld(s4, DQ_GB)
        amov(A9, s4)
        x19.xrd s13, #9         ; G
        aimm_e(6, DQ_D)
        rimm R5, #DQ_OUT - DQ_SPEC - 1
}

; The group and band walk both passes share: e7 books, e8 scale factors, e9/e11 the band's
; offsets, e10 the group length. dq_walk_start() resets them.
.macro dq_walk_start() {
        ldi s13, #AAC_BOOK - 1
        x17.mve e7, s13
        ldi s13, #AAC_SF - 1
        x17.mve e8, s13
        ldi s13, #DQ_GLEN - 1
        x17.mve e10, s13
        yld(s3, DQ_GRP)
        yst(DQ_GL)
        ldi s3, #0
        yst(DQ_WB)
}

; Pass 1: Y DQ_E = the largest coefficient exponent, or DQ_NONE.
.macro dq_pass1() {
        ldi s3, #DQ_NONE
        yst(DQ_E)
        dq_walk_start()
grp:    ldi s13, #DQ_OFF - 1
        x17.mve e9, s13
        ldi s13, #DQ_OFF
        x17.mve e11, s13
        yld(s3, DQ_MAX)
        yst(DQ_SL)
band:   yld(s4, DQ_SL)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, gdone
        nop()
        nop()
        ldy s4, e7
        alu s4, s4, s14, #OP_SUB
        ptst p3, s0, #LT4, #PTST ; book 0
        jmp #3, #3, bnext
        ldi s12, #10            ; (delay slot) book 12 never reaches here
        alu s4, s12, s4, #OP_SUB ; (delay slot) 11 - book
        ptst p3, s0, #LT4, #PTST ; noise or intensity
        jmp #3, #3, bnext
        ldy s3, e10             ; (delay slot)
        nop()
        yst(DQ_WL)
        yld(s3, DQ_WB)
        yst(DQ_CW)
        ldi s3, #0
        yst(DQ_MQ)
win:    yld(s4, DQ_WL)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, wdone
        nop()
        nop()
        ldy s5, e9
        ldy s6, e11
        alu s9, s6, s5, #OP_SUB ; coefficients in the band
        yld(s7, DQ_CW)
        alu s7, s7, s5, #OP_ADD
        ldi s4, #DQ_SPEC
        alu s7, s7, s4, #OP_ADD
        amov_e(1, s7)
        alu s7, s7, s9, #OP_ADD
        dq_rset(s7, R4)         ; the run's end
        yld(s10, DQ_MQ)
        ldi s7, #0
mx:     pk(s1, A2, s0, s0, s0, 3, s0, s7, 7, 0) ; q; s3 = |the previous|
        x18.max s10, s10, s3
        pk(s4, A2, s0, s0, s0, 3, s0, s1, 7, 0)
        x18.max s10, s10, s3
        pk(s5, A2, s0, s0, s0, 3, s0, s4, 7, 0)
        x18.max s10, s10, s3
        pk(s7, A2, s0, s0, s0, 3, s0, s5, 7, 0)
        pcond p3, R4, A2, #30   ; more: A2 != the end (bands are multiples of 4)
        jmp #3, #3, mx
        x18.max s10, s10, s3    ; (delay slot)
        nop()
        pk(s0, A0, s0, s0, s0, 3, s0, s7, 7, 0)
        x18.max s10, s10, s3
        alu s3, s10, s0, #OP_ADD
        yst(DQ_MQ)
        yld(s3, DQ_CW)
        yld(s4, DQ_WIN)
        alu s3, s3, s4, #OP_ADD
        yst(DQ_CW)
        yld(s3, DQ_WL)
        alu s3, s3, s14, #OP_SUB
        yst(DQ_WL)
        jmp #ALWAYS, #0, win
        nop()
        nop()
wdone:  yld(s1, DQ_MQ)
        alu s4, s1, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST ; an all-zero band sets nothing
        jmp #3, #3, bnext
        nop()
        nop()
        dq_em()
        dq_sh()
        alu s3, s3, s7, #OP_ADD ; e = em + 2 + floor(t / 4)
        yld(s5, DQ_E)
        alu s4, s5, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, bnext
        nop()
        nop()
        yst(DQ_E)
bnext:  x18.eagu e7, e7, #AGU_INC
        x18.eagu e8, e8, #AGU_INC
        x18.eagu e9, e9, #AGU_INC
        x18.eagu e11, e11, #AGU_INC
        yld(s3, DQ_SL)
        alu s3, s3, s14, #OP_SUB
        yst(DQ_SL)
        jmp #ALWAYS, #0, band
        nop()
        nop()
gdone:  ldy s5, e10
        yld(s6, DQ_WIN)
        yld(s3, DQ_WB)
gw:     alu s4, s5, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, gw2
        nop()
        nop()
        alu s3, s3, s6, #OP_ADD
        jmp #ALWAYS, #0, gw
        alu s5, s5, s14, #OP_SUB ; (delay slot)
        nop()
gw2:    yst(DQ_WB)
        x18.eagu e10, e10, #AGU_INC
        yld(s3, DQ_GL)
        alu s3, s3, s14, #OP_SUB
        yst(DQ_GL)
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, grp
        nop()
        nop()
}

; Pass 2: every coefficient of every spectral band to DQ_OUT, shifted to E.
.macro dq_pass2() {
        dq_walk_start()
grp:    ldi s13, #DQ_OFF - 1
        x17.mve e9, s13
        ldi s13, #DQ_OFF
        x17.mve e11, s13
        yld(s3, DQ_MAX)
        yst(DQ_SL)
band:   yld(s4, DQ_SL)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, gdone
        nop()
        nop()
        ldy s4, e7
        alu s4, s4, s14, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, bnext
        ldi s12, #10            ; (delay slot)
        alu s4, s12, s4, #OP_SUB ; (delay slot)
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, bnext
        nop()
        nop()
        dq_sh()
        ldi s3, #DQ_G
        alu s3, s3, s6, #OP_ADD
        yst(DQ_GB)
        yld(s10, DQ_E)
        alu s10, s10, s7, #OP_SUB ; base = E - 2 - floor(t / 4)
        ldy s3, e10
        yst(DQ_WL)
        yld(s3, DQ_WB)
        yst(DQ_CW)
win:    yld(s4, DQ_WL)
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, bnext
        nop()
        nop()
        ldy s5, e9
        ldy s6, e11
        alu s9, s6, s5, #OP_SUB
        yld(s7, DQ_CW)
        alu s8, s7, s5, #OP_ADD
        ldi s4, #DQ_SPEC
        alu s4, s8, s4, #OP_ADD
        amov_e(1, s4)
        alu s8, s4, s9, #OP_ADD
        dq_rset(s8, R4)         ; the run's end
        jmp #ALWAYS, #0, fsx    ; the constants, then the first q at cnext
        nop()
        nop()
co:     ptst p3, s0, #EQ8, #PTST
        jmp #IF_NOT, #3, nz
        x02.aa A3, A2, R5, #2, A0, A0 ; (delay slot) A3 = q's DQ_OUT word
        nop()                   ; (delay slot)
cnext:  pcond p3, R4, A2, #30   ; more: A2 != the end
        jmp #3, #3, co
        pk(s8, A2, s0, s0, s0, 0, s0, s0, 0, 0) ; (delay slot) the next q
        nop()                   ; (delay slot)
        jmp #ALWAYS, #0, cod
        nop()
        nop()
        ; |q| <= 128: m, em from DQ_D at 2 |q| (x17.styr, x02.aa), P = rnd(m G) (G = s13, rem 0),
        ; v = rshr(P, min(base - em, 23)) by x02.vc code 7, and the sign as an exact product:
        ; rnd(v * (2^23 - 1) / 2^23) = v for v < 2^22, rnd(v * -2^23 / 2^23) = -v, the factor
        ; 2^23 - 1 - asr(q, 23) (code 6, fact 730).
nz:     pk(s0, A0, s0, s0, s0, 1, s0, s8, 7, 0) ; |q|
        pk(s0, A0, s0, s0, s0, 4, s1, s9, 5, 0) ; |q| - 129
        x17.styr R6, s1, #1, e6, #0 ; R6 = 2 |q|
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, big
        x02.aa A9, A12, R6, #2, A0, A0 ; (delay slot) A9 = DQ_D + 2 |q|
        pk(s0, A0, s0, s0, s0, 4, s11, s8, 0, 6) ; (delay slot) asr(q, 23)
        pk(s2, A9, s0, s0, s0, 4, s12, s4, 5, 0) ; m; the sign factor
        pk(s3, A9, s0, s0, s0, 0, s0, s0, 0, 0) ; em
        pk(s0, A0, s6, s2, s13, 5, s10, s3, 5, 0) ; P; n = base - em
        x18.min s5, s5, s11
        pk(s0, A0, s0, s0, s0, 6, s5, s6, 0, 7) ; v = rshr(P, n)
        pk(s0, A0, s6, s6, s4, 0, s0, s0, 0, 0) ; the sign
        jmp #ALWAYS, #0, cnext
        pks(6, A3, 0, s0, s0, 0) ; (delay slot)
        nop()                   ; (delay slot)
big:    alu s11, s8, s0, #OP_ADD
        dq_mant()
        yld(s4, DQ_GB)
        alu s4, s4, s5, #OP_ADD
        amov(A9, s4)
        x19.xrd s4, #9          ; G
        x02.mpy s6, s2, s4      ; P
        alu s12, s10, s3, #OP_SUB ; n = E - e
        ldi s4, #24
        alu s4, s12, s4, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, nok
        nop()
        nop()
        ldi s12, #23            ; P < 2^21.75, so any n >= 23 gives 0
nok:    alu s12, s0, s12, #OP_SUB
        x19.alu s6, s6, s12, #SHIFT ; rshr(P, n)
        alu s4, s11, s0, #OP_ADD
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, put
        nop()
        nop()
        alu s6, s0, s6, #OP_SUB
put:    stx A3, s6
fsx:    dq_fset()
        jmp #ALWAYS, #0, cnext
        nop()
        nop()
cod:    yld(s3, DQ_CW)
        yld(s4, DQ_WIN)
        alu s3, s3, s4, #OP_ADD
        yst(DQ_CW)
        yld(s3, DQ_WL)
        alu s3, s3, s14, #OP_SUB
        yst(DQ_WL)
        jmp #ALWAYS, #0, win
        nop()
        nop()
bnext:  x18.eagu e7, e7, #AGU_INC
        x18.eagu e8, e8, #AGU_INC
        x18.eagu e9, e9, #AGU_INC
        x18.eagu e11, e11, #AGU_INC
        yld(s3, DQ_SL)
        alu s3, s3, s14, #OP_SUB
        yst(DQ_SL)
        jmp #ALWAYS, #0, band
        nop()
        nop()
gdone:  ldy s5, e10
        yld(s6, DQ_WIN)
        yld(s3, DQ_WB)
gw:     alu s4, s5, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, gw2
        nop()
        nop()
        alu s3, s3, s6, #OP_ADD
        jmp #ALWAYS, #0, gw
        alu s5, s5, s14, #OP_SUB ; (delay slot)
        nop()
gw2:    yst(DQ_WB)
        x18.eagu e10, e10, #AGU_INC
        yld(s3, DQ_GL)
        alu s3, s3, s14, #OP_SUB
        yst(DQ_GL)
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, grp
        nop()
        nop()
}

; dq_channel(): clears DQ_OUT, then both passes; E = 0 when no band has a non-zero value.
.macro dq_channel() {
        xzero(DQ_OUT, 1024)
        dq_pass1()
        yld(s4, DQ_E)
        ldi s12, #DQ_NONE
        alu s4, s4, s12, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, run2
        nop()
        nop()
        ldi s3, #0
        yst(DQ_E)
        jmp #ALWAYS, #0, end
        nop()
        nop()
run2:   dq_pass2()
end:
}
