; Audited from x17 2f5d48b examples/lib/imdct.sm, 2026-11-08 (docs/x17-import.md).
; Twin: ref/dsp/aac/imdct.zig; ISO/IEC 14496-3 4.6.11.3.2 (IMDCT), by a DCT-IV through an FFT.
; AAC IMDCT: the twin of ref/dsp/aac/imdct.zig `imdct`.
;
; n2 words w with value w * 2^E become 2 n2 samples in PCM units as Q7 words. The words are
; brought to a largest |x| in [2^21, 2^22) (one rounded halving, or doublings counted by
; comparisons), then a pre-twiddle into an n2/2-point complex FFT in bit-reversed order, the
; FFT's stages (radix 2 first when log2 n4 is odd, then radix 4), a post-twiddle and the fold.
; cmul is two rounded products summed. Before each stage the fewest redundant sign bits among
; its inputs (x01.norm, tracked with x18.min as the stage before stores them) decide a rounded
; right shift down to 2^20 (radix 4) or 2^21 (radix 2), the shifts joining the exponent. The
; output shift
; scaled + E' - log2 n2 + 7 is one 0x19 op-23 shift (reference.md `x19`), which saturates as the model's comparisons
; do.
;
; imdct(N2, N4, LOGN2, STAGES, IN, Z, OUT, PRE, POST, TW, REV, ESLOT), N4 = n2 / 2 (the FFT's
; points, not a quarter), LOGN2 = log2 n2, STAGES = log2 N4: long (1024, 512, 10, 9), short
; (128, 64, 7, 6).
;   X IN   n2 words in, rewritten (normalised words, then the DCT-IV result u)
;   X Z    n2 words: n4 = n2/2 complex points, re then im
;   X OUT  2 n2 samples out
;   X PRE  exp(-j pi (n + 1/4) / n2), n4 pairs; X POST exp(-j pi k / n2), n4 pairs
;   X TW   the radix-4 twiddles (the twin's tw4): per stage of block size l, for j < l, the
;          pairs exp(-j 2 pi m j / (4 l)), m = 1, 2, 3 (1020 words long, 126 short)
;   Y REV  Z + 2 rev(n) - 2 for n = 0 .. n4 - 1 (rev: log2 n4 bits reversed)
;   Y ESLOT E
; imdct takes an odd STAGES (a radix-2 stage first, the long block), imdct_even an even one.
; Needs lib/bits.sm (s0 = 0, s14 = 1) and lib/mem.sm. x02.ainc's template also writes
; s2 (its w2 multiply slot) and x02.mpy steps A1, so nothing lives in s2 or A1 here. Uses every s register but s0
; and s14 (s15 is left 16 for bits.sm), e6..e8, R1..R7, A2..A6, A8..A10, A12, A14 and Y
; IM_Y .. IM_Y + 7.

.const IM_Y    = 0x2548
.const IM_EX   = IM_Y + 0       ; E of the normalised words
.const IM_SC   = IM_Y + 1       ; FFT scaling so far
.const IM_HALF = IM_Y + 2       ; the radix-4 stage's block size l
.const IM_GRPS = IM_Y + 3       ; the stage's groups, n4 / (4 l)
.const IM_PJ   = IM_Y + 4       ; the stage's twiddles in TW
.const IM_STG  = IM_Y + 5       ; stages left
.const IM_J    = IM_Y + 6       ; groups left in the stage

; s10 = max |X[BASE ..]| over COUNT words, a multiple of 4: pk loads with the third slot's
; |b| (x02.vc code 0 op 7, fact 730) and x18.max (708). Uses s1, s3, s4, s5, s7, A8, R4, p3.
.macro im_scan(BASE, COUNT) {
        aimm_e(4, BASE)
        rimm R4, #BASE + COUNT
        ldi s10, #0
        ldi s7, #0
mm:     pk(s1, A8, s0, s0, s0, 3, s0, s7, 7, 0)
        x18.max s10, s10, s3
        pk(s4, A8, s0, s0, s0, 3, s0, s1, 7, 0)
        x18.max s10, s10, s3
        pk(s5, A8, s0, s0, s0, 3, s0, s4, 7, 0)
        x18.max s10, s10, s3
        pk(s7, A8, s0, s0, s0, 3, s0, s5, 7, 0)
        pcond p3, R4, A8, #30   ; more: A8 != BASE + COUNT
        jmp #3, #3, mm
        x18.max s10, s10, s3    ; (delay slot)
        nop()
        pk(s0, A0, s0, s0, s0, 3, s0, s7, 7, 0)
        x18.max s10, s10, s3
}

; Normalise IN's scale: s9 = c, the right shift im_pre's loads take (1: one rounded halving when
; max |x| >= 2^22; -k: k doublings while it is below 2^21), IM_EX = E + c. The zero block clears
; OUT and jumps to SILENT.
.macro im_norm(N2, IN, OUT, ESLOT, SILENT) {
        im_scan(IN, N2)
        alu s4, s10, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, nonzero
        nop()
        nop()
        aimm_o(4, OUT)
        ldi s9, #2 * N2
        alu s4, s0, s0, #OP_ADD ; stx An, s0 stores the X latch (x17 fact 709)
clr:    stx A9, s4
        x02.ainc #9, #9
        alu s9, s9, s14, #OP_SUB
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, clr
        alu s4, s0, s0, #OP_ADD ; (delay slot) 0 again for the store
        nop()
        jmp #ALWAYS, #0, SILENT
        nop()
        nop()
nonzero: ldi s3, #-22
        alu s3, s3, s14, #ASRRS ; 2^22
        alu s4, s10, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, scale  ; max >= 2^22: one halving
        ldi s9, #1              ; (delay slot)
        ldi s3, #-21            ; (delay slot)
        alu s3, s3, s14, #ASRRS ; 2^21
        ldi s9, #0
dbl:    alu s4, s10, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, scale
        nop()
        nop()
        alu s10, s10, s10, #OP_ADD
        jmp #ALWAYS, #0, dbl
        alu s9, s9, s14, #OP_SUB ; (delay slot)
        nop()
scale:  yld(s3, ESLOT)
        alu s3, s3, s9, #OP_ADD
        yst(IM_EX)              ; E' = E + c
}

; s15 = min(s15, norm(V)), the fewest redundant sign bits so far (x01.norm, x18.min: x17
; handbook §10, fact 708). Uses T.
.macro im_trk(V, T) {
        x01.norm T, V
        x18.min s15, s15, T
}

; The stage's scaling from s15 (the twin's stageShift): s6 = max(0, 23 - LIM - s15), the rounded
; right shift its loads take; IM_SC += s6, s15 = 24 again. Uses s3.
.macro im_dec(LIM) {
        ldi s6, #23 - LIM
        alu s6, s6, s15, #OP_SUB
        x18.max s6, s6, s0
        yld(s3, IM_SC)
        alu s3, s3, s6, #OP_ADD
        yst(IM_SC)
        ldi s15, #24
}

; A<2k> = the value s<src> + 2 (mem.sm's amov path without its first two steps): e6, R7.
.macro im_aset(src, k) {
        x17.mve e6, src
        x19.a3 s0, R7, e6, #25, #2, #0
        x12.aset #k, R7
}

; Z[rev n] = (IN[2n], IN[n2 - 1 - 2n]) >> s9 * PRE[n], tracking the fewest redundant sign bits
; in s15. Y REV holds Z + 2 rev(n). Point n's loads and products (pk, A4 up and A6 down by
; agu_xr fns 2 and 3 with R2 = 2, fact 738; the shift by x02.vc code 7, 730) overlap the
; finish of point n - 1, which x03.acp's A10 <- Y:[e7] (fact 193) then scatters; x03.acp's
; template also loads s7 with that Y word (facts 190, 748).
.macro im_pre5(N2, IN) {
        pkf(s1, A4, s10, s3, s4, 0, s0, s0, 0, 0, 2, R2) ; xr; s10 = xi pr
        pk(s4, A8, s6, s3, s5, 1, s9, s1, 0, 7) ; pr; s6 = xi pi; xr >>= c
        pkf(s3, A6, s2, s1, s4, 6, s2, s6, 5, 0, 3, R2) ; xi; s2 = xr pr; s6 = re
        pk(s5, A8, s0, s0, s0, 3, s9, s3, 0, 7) ; pi; xi >>= c
        pk(s0, A0, s13, s1, s5, 10, s13, s10, 0, 0) ; s13 = xr pi; s10 = im
}

.macro im_pre(N2, N4, IN, PRE, REV) {
        aimm_e(2, IN)
        ldi s12, #IN + N2 - 1
        amov_e(3, s12)
        aimm_e(4, PRE)
        lde e7, #REV
        rimm R2, #2
        rimm R4, #IN + N2 + 2
        ldi s15, #24
        im_pre5(N2, IN)
pre:    im_pre5(N2, IN)
        x03.acp A10, A0, e7, #1
        pks(6, A10, 0, s0, s0, 0)
        pks(10, A10, 0, s0, s0, 0)
        x01.norm s8, s6
        x18.min s15, s15, s8
        x01.norm s8, s10
        pcond p3, R4, A4, #30   ; more: A4 != IN + N2 + 2
        jmp #3, #3, pre
        x18.min s15, s15, s8    ; (delay slot)
        x18.eagu e7, e7, #AGU_INC ; (delay slot)
}

; RD = s<src> (the R write path of mem.sm's amov). Uses s13, e6.
.macro im_rset(src, RD) {
        ldi s13, #2
        alu s13, src, s13, #OP_SUB
        x17.mve e6, s13
        x19.a3 s0, RD, e6, #25, #2, #0
}

; The FFT (the twin's `fft`): in place over Z's N4 complex points in bit-reversed order, a
; radix-2 first stage when log2 N4 is odd, then radix-4 stages. Each stage first takes its
; shift from the outputs the stage before tracked (im_dec), and its loads apply it. Loads are
; x03.tap0 into s0's product (a pure X load and step, fact 709); x02.ainc steps the stores.

; Radix 2 over adjacent pairs, N4 / 2 butterflies. Uses s1, s3..s9, s13, A4, A10.
.macro im_r2(N4, Z) {
        aimm_e(2, Z)
        aimm_e(5, Z)
        ldi s4, #N4 / 2
        x03.tap0 s1, #4, s0, s0, s0 ; ar
r2:     x03.tap0 s3, #4, s0, s0, s0 ; ai
        x03.tap0 s5, #4, s0, s0, s0 ; br
        x03.tap0 s7, #4, s0, s0, s0 ; bi
        alu s1, s6, s1, #ASRRS
        alu s3, s6, s3, #ASRRS
        alu s5, s6, s5, #ASRRS
        alu s7, s6, s7, #ASRRS
        alu s8, s1, s5, #OP_ADD
        alu s9, s3, s7, #OP_ADD
        alu s1, s1, s5, #OP_SUB
        alu s3, s3, s7, #OP_SUB
        stx A10, s8
        x02.ainc #10, #10
        stx A10, s9
        x02.ainc #10, #10
        stx A10, s1
        x02.ainc #10, #10
        stx A10, s3
        x02.ainc #10, #10
        im_trk(s8, s13)
        im_trk(s9, s13)
        im_trk(s1, s13)
        x01.norm s13, s3
        alu s4, s4, s14, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, r2
        x18.min s15, s15, s13   ; (delay slot)
        x03.tap0 s1, #4, s0, s0, s0 ; (delay slot) the next ar; past the end, a dummy
}

; The radix-4 stages: STG of them from l = L0 (block size), groups N4 / (4 l), twiddles from TW
; (the twin's tw4, a triple per j). Loads step A4, A6, A8, A10 (Z + 8 l g + {0, 2, 4, 6} l + 2 j)
; and stores step A5, A7, A9, A11 over the same words, so no pointer goes back; twiddles at A12;
; R6 = 2 l, R5 = 6 l, R4 the group's end for A10, R2 the stage's twiddles. s12 holds the stage's
; right shift (positive) for x02.vc's asrrs.
;
; A butterfly runs its three complex products as overlapping five-bundle phases (pk: X load,
; multiply, third slot per bundle): phase k at bundle 5k loads the block's words into s1, s3 and
; the twiddle into s4, s5, shifts the words, and makes RE = rnd(s1 wr) - rnd(s3 wi), IM =
; rnd(s1 wi) + rnd(s3 wr) through s2 and s13, the twin's cmul. F1 W^j lands in s6, s7, F2 W^2j in
; s8, s9, F3 W^3j in s10, s11, then F0 in s1, s3.
.macro im_r4(N4, Z, TW, L0, STG) {
        ldi s3, #L0
        yst(IM_HALF)
        ldi s3, #N4 / (4 * L0)
        yst(IM_GRPS)
        ldi s3, #TW
        yst(IM_PJ)
        ldi s3, #STG
        yst(IM_STG)
stage:  im_dec(20)
        alu s12, s6, s0, #OP_ADD ; the shift, positive for asrrs
        yld(s1, IM_HALF)
        alu s1, s1, s1, #OP_ADD ; 2 l
        im_rset(s1, R6)
        alu s3, s1, s1, #OP_ADD
        alu s1, s1, s3, #OP_ADD ; 6 l
        im_rset(s1, R5)
        yld(s1, IM_PJ)
        im_rset(s1, R2)
        aimm_e(2, Z)
        x18.rag101 s0, R3, A4, R6, #2
        x12.aset #3, R3         ; A6 = Z + 2 l
        x18.rag101 s0, R3, A6, R6, #2
        x12.aset #4, R3         ; A8
        x18.rag101 s0, R3, A8, R6, #2
        x12.aset #5, R3         ; A10
        x02.aa A4, A4, R0, #2, A5, A0 ; the store pointers on the load pointers
        x02.aa A6, A6, R0, #2, A7, A0
        x02.aa A8, A8, R0, #2, A9, A0
        x02.aa A10, A10, R0, #2, A11, A0
        yld(s3, IM_GRPS)
        yst(IM_J)
        ldi s13, #IM_J - 1
        x17.mve e8, s13
grp:    x18.rag101 s0, R4, A10, R6, #2 ; the group's end for A10
        x12.aset #6, R2         ; A12 = the stage's twiddles
        ; phase 0: F1 (A8) into s6, s7
bf:     pk(s1, A8, s0, s0, s0, 0, s0, s0, 0, 0)
        pk(s4, A12, s0, s0, s0, 1, s12, s1, 0, 7)
        pk(s3, A8, s2, s1, s4, 0, s0, s0, 0, 0)
        pk(s5, A12, s0, s0, s0, 3, s12, s3, 0, 7)
        pk(s0, A0, s13, s1, s5, 0, s0, s0, 0, 0)
        ; phase 1 from here: F2 (A6) into s8, s9
        pk(s1, A6, s7, s3, s4, 0, s0, s0, 0, 0)
        pk(s4, A12, s6, s3, s5, 1, s12, s1, 0, 7)
        pk(s3, A6, s2, s1, s4, 6, s2, s6, 5, 0) ; s6 = F1W re
        pk(s5, A12, s0, s0, s0, 3, s12, s3, 0, 7)
        pk(s0, A0, s13, s1, s5, 7, s13, s7, 0, 0) ; s7 = F1W im
        ; phase 2: F3 (A10) into s10, s11
        pk(s1, A10, s9, s3, s4, 0, s0, s0, 0, 0)
        pk(s4, A12, s8, s3, s5, 1, s12, s1, 0, 7)
        pk(s3, A10, s2, s1, s4, 8, s2, s8, 5, 0) ; s8 = F2W2 re
        pk(s5, A12, s0, s0, s0, 3, s12, s3, 0, 7)
        pk(s0, A0, s13, s1, s5, 9, s13, s9, 0, 0) ; s9 = F2W2 im
        ; F0 (A4) into s1, s3 beside phase 2's tail
        pk(s1, A4, s11, s3, s4, 0, s0, s0, 0, 0)
        pk(s0, A0, s10, s3, s5, 1, s12, s1, 0, 7)
        pk(s3, A4, s0, s0, s0, 10, s2, s10, 5, 0) ; s10 = F3W3 re
        pk(s0, A0, s0, s0, s0, 3, s12, s3, 0, 7)
        pk(s0, A0, s0, s0, s0, 11, s13, s11, 0, 0) ; s11 = F3W3 im
        alu s2, s1, s8, #OP_ADD ; p = F0 + F2 W^2j
        alu s1, s1, s8, #OP_SUB ; q
        alu s8, s3, s9, #OP_ADD
        alu s3, s3, s9, #OP_SUB
        alu s9, s6, s10, #OP_ADD ; r = F1 W^j + F3 W^3j
        alu s6, s6, s10, #OP_SUB ; s
        alu s10, s7, s11, #OP_ADD
        alu s7, s7, s11, #OP_SUB
        alu s11, s2, s9, #OP_ADD ; p + r
        pks(11, A5, 2, s2, s9, 5) ; p - r
        pks(2, A9, 9, s8, s10, 0)
        pks(9, A5, 8, s8, s10, 5)
        pks(8, A9, 10, s1, s7, 0) ; q - j s
        pks(10, A7, 1, s1, s7, 5) ; q + j s
        pks(1, A11, 7, s3, s6, 5)
        pks(7, A7, 3, s3, s6, 0)
        pks(3, A11, 0, s0, s0, 0)
        im_trk(s11, s4)
        im_trk(s2, s4)
        im_trk(s9, s4)
        im_trk(s8, s4)
        im_trk(s10, s4)
        im_trk(s1, s4)
        im_trk(s7, s4)
        x01.norm s4, s3
        pcond p3, R4, A10, #30  ; more in the group: A10 != R4
        jmp #3, #3, bf
        x18.min s15, s15, s4    ; (delay slot)
        nop()
        x02.aa A4, A4, R5, #2, A5, A0 ; the next group: every block + 6 l
        x02.aa A6, A6, R5, #2, A7, A0
        x02.aa A8, A8, R5, #2, A9, A0
        x02.aa A10, A10, R5, #2, A11, A0
        ldy s4, e8
        alu s4, s4, s14, #OP_SUB
        x17.sty e8, #4, #0
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, grp
        nop()
        nop()
        yld(s1, IM_HALF)
        alu s4, s1, s1, #OP_ADD
        alu s4, s4, s1, #OP_ADD
        alu s4, s4, s4, #OP_ADD ; 6 l: this stage's l triples
        yld(s3, IM_PJ)
        alu s3, s3, s4, #OP_ADD
        yst(IM_PJ)
        alu s3, s1, s1, #OP_ADD
        alu s3, s3, s3, #OP_ADD ; l * 4
        yst(IM_HALF)
        yld(s3, IM_GRPS)
        ldi s4, #2
        alu s3, s4, s3, #ASRRS  ; groups / 4 (a multiple of 4 until the last stage: exact)
        yst(IM_GRPS)
        yld(s3, IM_STG)
        alu s3, s3, s14, #OP_SUB
        yst(IM_STG)
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, stage
        nop()
        nop()
}


; u[2k] = re(Z[k] POST[k]), u[n2 - 1 - 2k] = -im(Z[k] POST[k]), u over IN. Point k's loads and
; products (pk) overlap point k - 1's finish, whose stores step A10 up and A12 down by agu_xr
; fns 2 and 3 with R2 = 2 (pksf, fact 738), the first store's third slot negating im.
.macro im_post5() {
        pk(s1, A4, s10, s3, s4, 0, s0, s0, 0, 0) ; er; s10 = ei pr
        pk(s4, A8, s6, s3, s5, 0, s0, s0, 0, 0) ; pr; s6 = ei pi
        pk(s3, A4, s2, s1, s4, 6, s2, s6, 5, 0) ; ei; s2 = er pr; s6 = re
        pk(s5, A8, s0, s0, s0, 0, s0, s0, 0, 0) ; pi
        pk(s0, A0, s13, s1, s5, 10, s13, s10, 0, 0) ; s13 = er pi; s10 = im
}

.macro im_post(N2, N4, Z, IN, POST) {
        aimm_e(2, Z)
        aimm_e(4, POST)
        aimm_e(5, IN)
        ldi s12, #IN + N2 - 1
        amov_e(6, s12)
        rimm R2, #2
        rimm R4, #Z + N2 + 2
        im_post5()
post:   im_post5()
        pcond p3, R4, A4, #30   ; more: A4 != Z + N2 + 2
        jmp #3, #3, post
        pksf(6, A10, 10, s0, s10, 5, 2, R2) ; (delay slot) u[2k] = re; s10 = -im
        pksf(10, A12, 0, s0, s0, 0, 3, R2) ; (delay slot)
}

; One run of the fold: samples to A9 on until A9 passes END (R4), A8 stepping by agu_xr FN with
; R5 (0: up; 2 with R5 = +1 or -1), each rshr(op(X[A8]), s12): a pk (load, shift by x02.vc code
; 7, fact 730) and a pks (store, its third slot's op XOP: 0 +, 5 negate) per sample, four to a
; pass. One load past the run's last is harmless.
.macro im_frun(FN, OP, XOP) {
        pkf(s1, A8, s0, s0, s0, 0, s0, s0, 0, 0, FN, R5)
        alu s5, s0, s1, OP
fq:     pkf(s1, A8, s0, s0, s0, 3, s12, s5, 0, 7, FN, R5)
        pks(3, A9, 5, s0, s1, XOP)
        pkf(s1, A8, s0, s0, s0, 3, s12, s5, 0, 7, FN, R5)
        pks(3, A9, 5, s0, s1, XOP)
        pkf(s1, A8, s0, s0, s0, 3, s12, s5, 0, 7, FN, R5)
        pks(3, A9, 5, s0, s1, XOP)
        pcond p3, R4, A9, #30   ; more: A9 != END
        jmp #3, #3, fq
        pkf(s1, A8, s0, s0, s0, 3, s12, s5, 0, 7, FN, R5) ; (delay slot)
        pks(3, A9, 5, s0, s1, XOP) ; (delay slot)
}

; im_frun with the shift by the alu head's ASRRS (s6 left, which saturates as shiftSat does; x17
; fact 774): three bundles per sample, the store's third slot idle. Sets s12 = -s6.
.macro im_frunx(FN, XOP) {
        alu s12, s0, s6, #OP_SUB
        pkf(s1, A8, s0, s0, s0, 0, s0, s0, 0, 0, FN, R5)
fx:     pkf(s1, A8, s0, s0, s0, 5, s0, s1, XOP, 0, FN, R5)
        alu s3, s12, s5, #ASRRS
        pks(3, A9, 0, s0, s0, 0)
        pkf(s1, A8, s0, s0, s0, 5, s0, s1, XOP, 0, FN, R5)
        alu s3, s12, s5, #ASRRS
        pks(3, A9, 0, s0, s0, 0)
        pkf(s1, A8, s0, s0, s0, 5, s0, s1, XOP, 0, FN, R5)
        alu s3, s12, s5, #ASRRS
        pks(3, A9, 0, s0, s0, 0)
        pkf(s1, A8, s0, s0, s0, 5, s0, s1, XOP, 0, FN, R5)
        alu s3, s12, s5, #ASRRS
        pcond p3, R4, A9, #30   ; more: A9 != END
        jmp #3, #3, fx
        pks(3, A9, 0, s0, s0, 0) ; (delay slot)
        nop()
}

; After a negated run: s9 = 1 (the first, falling, run done) sets up the rising run of -u[0 ..]
; and jumps to AGAIN; s9 = 0 falls through. Uses s4, p3.
.macro im_fnext(N2, IN, OUT, AGAIN) {
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #3, #3, fin
        ldi s9, #0              ; (delay slot)
        rimm R5, #1             ; (delay slot)
        aimm_e(4, IN)
        rimm R4, #OUT + 2 * N2 - 1
        jmp #ALWAYS, #0, AGAIN
        nop()
        nop()
fin:
}

; OUT[n] = shiftSat(fold(u)[n], scaled + E' - log2 n2 + 7): OUT[0 .. n2/2) = u[n2/2 ..], then
; -u falling from u[n2 - 1], then -u[0 .. n2/2). A right shift of 0..23 runs packed (im_frun); a
; left shift, which saturates, or one of 24 and more, takes im_frunx.
.macro im_fold(N2, LOGN2, IN, OUT) {
        yld(s6, IM_SC)
        yld(s3, IM_EX)
        alu s6, s6, s3, #OP_ADD
        ldi s3, #7 - LOGN2
        alu s6, s6, s3, #OP_ADD
        aimm_o(4, OUT)
        aimm_e(4, IN + N2 / 2)
        rimm R4, #OUT + N2 / 2 - 1
        alu s4, s6, s0, #OP_ADD
        ptst p3, s0, #LE4, #PTST
        jmp #IF_NOT, #3, slow   ; a left shift
        ldi s3, #-23            ; (delay slot)
        ldi s9, #1              ; (delay slot)
        alu s4, s6, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #3, #3, slow        ; s6 <= -24
        alu s12, s0, s6, #OP_SUB ; (delay slot) the right shift
        nop()
        im_frun(0, #OP_ADD, 0)
        ldi s12, #IN + N2 - 1
        amov_e(4, s12)
        alu s12, s0, s6, #OP_SUB
        rimm R5, #-1
        rimm R4, #OUT + 3 * N2 / 2 - 1
fneg:   im_frun(2, #OP_SUB, 5)
        im_fnext(N2, IN, OUT, fneg)
        jmp #ALWAYS, #0, done
        nop()
        nop()
slow:   im_frunx(0, 0)
        ldi s12, #IN + N2 - 1
        amov_e(4, s12)
        rimm R5, #-1
        rimm R4, #OUT + 3 * N2 / 2 - 1
sneg:   im_frunx(2, 5)
        im_fnext(N2, IN, OUT, sneg)
done:
}

.macro imdct(N2, N4, LOGN2, STAGES, IN, Z, OUT, PRE, POST, TW, REV, ESLOT) {
        im_norm(N2, IN, OUT, ESLOT, silent)
        im_pre(N2, N4, IN, PRE, REV)
        ldi s3, #0
        yst(IM_SC)
        im_dec(21)
        im_r2(N4, Z)
        im_r4(N4, Z, TW, 2, (STAGES / 2))
        im_post(N2, N4, Z, IN, POST)
        im_fold(N2, LOGN2, IN, OUT)
silent: ldi s15, #16
}

; The same for an even STAGES (the short block): radix 4 throughout.
.macro imdct_even(N2, N4, LOGN2, STAGES, IN, Z, OUT, PRE, POST, TW, REV, ESLOT) {
        im_norm(N2, IN, OUT, ESLOT, silent)
        im_pre(N2, N4, IN, PRE, REV)
        ldi s3, #0
        yst(IM_SC)
        im_r4(N4, Z, TW, 1, (STAGES / 2))
        im_post(N2, N4, Z, IN, POST)
        im_fold(N2, LOGN2, IN, OUT)
silent: ldi s15, #16
}
