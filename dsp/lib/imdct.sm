; Audited from x17 2f5d48b examples/lib/imdct.sm, 2026-11-08 (docs/x17-import.md).
; Twin: ref/dsp/aac/imdct.zig; ISO/IEC 14496-3 4.6.11.3.2 (IMDCT), by a DCT-IV through an FFT.
; AAC IMDCT: the twin of ref/dsp/aac/imdct.zig `imdct`.
;
; n2 words w with value w * 2^E become 2 n2 samples in PCM units as Q7 words. The words are
; brought to a largest |x| in [2^21, 2^22) (one rounded halving, or doublings counted by
; comparisons), then a pre-twiddle into an n2/2-point complex FFT in bit-reversed order, the
; FFT's stages (radix 2 first when log2 n4 is odd, then radix 4), a post-twiddle and the fold.
; cmul is two rounded products summed. Before each stage the fewest redundant sign bits among
; its inputs (x01.norm, tracked with x18.min as the stage before stores them) decide a rounded
; right shift down to 2^20 (radix 4) or 2^21 (radix 2), the shifts joining the exponent. The
; output shift
; scaled + E' - log2 n2 + 7 is one 0x19 op-23 shift (reference.md `x19`), which saturates as the model's comparisons
; do.
;
; imdct(N2, N4, LOGN2, STAGES, IN, Z, OUT, PRE, POST, TW, REV, ESLOT), N4 = n2 / 2 (the FFT's
; points, not a quarter), LOGN2 = log2 n2, STAGES = log2 N4: long (1024, 512, 10, 9), short
; (128, 64, 7, 6).
;   X IN   n2 words in, rewritten (normalised words, then the DCT-IV result u)
;   X Z    n2 words: n4 = n2/2 complex points, re then im
;   X OUT  2 n2 samples out
;   X PRE  exp(-j pi (n + 1/4) / n2), n4 pairs; X POST exp(-j pi k / n2), n4 pairs
;   X TW   the radix-4 twiddles (the twin's tw4): per stage of block size l, for j < l, the
;          pairs exp(-j 2 pi m j / (4 l)), m = 1, 2, 3 (1020 words long, 126 short)
;   Y REV  Z + 2 rev(n) - 2 for n = 0 .. n4 - 1 (rev: log2 n4 bits reversed)
;   Y ESLOT E
; imdct takes an odd STAGES (a radix-2 stage first, the long block), imdct_even an even one.
; Needs lib/bits.sm (s0 = 0, s14 = 1) and lib/mem.sm. x02.ainc's template also writes
; s2 (its w2 multiply slot) and x02.mpy steps A1, so nothing lives in s2 or A1 here. Uses every s register but s0
; and s14 (s15 is left 16 for bits.sm), e6..e8, R1..R7, A2..A6, A8..A10, A12, A14 and Y
; IM_Y .. IM_Y + 7.

.const IM_Y    = 0x2380
.const IM_EX   = IM_Y + 0       ; E of the normalised words
.const IM_SC   = IM_Y + 1       ; FFT scaling so far
.const IM_HALF = IM_Y + 2       ; the radix-4 stage's block size l
.const IM_GRPS = IM_Y + 3       ; the stage's groups, n4 / (4 l)
.const IM_PJ   = IM_Y + 4       ; the stage's twiddles in TW
.const IM_STG  = IM_Y + 5       ; stages left
.const IM_J    = IM_Y + 6       ; groups left in the stage

; s10 = max(0, X[BASE ..]), s11 = min(0, X[BASE ..]) over COUNT words. Uses s1, s4, s9, A8, p3.
.macro im_scan(BASE, COUNT) {
        aimm_e(4, BASE)
        ldi s9, #COUNT
        ldi s10, #0
        ldi s11, #0
mm:     x19.xrd s1, #8
        x02.ainc #8, #8
        alu s4, s1, s10, #OP_SUB
        ptst p3, s0, #LE4, #PTST
        psel s10, s4, s10, p3, #0, #4 ; x > max: max + (x - max)
        alu s4, s1, s11, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        psel s11, s4, s11, p3, #1, #4 ; x < min: min + (x - min)
        alu s9, s9, s14, #OP_SUB
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, mm
        nop()
        nop()
}

; s6 = 2 when MX >= 2^22 or MN <= -2^22, else 1 when MX >= 2^21 or MN <= -2^21, else 0.
; Uses s3, s4, p3.
.macro im_decide(MX, MN) {
        ldi s3, #22
        x19.alu s3, s14, s3, #SHIFT ; 2^22
        alu s4, MX, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, two    ; max >= 2^22
        alu s4, MN, s3, #OP_ADD ; (delay slot)
        nop()
        ptst p3, s0, #LE4, #PTST
        jmp #3, #3, two         ; min <= -2^22
        ldi s3, #21             ; (delay slot)
        x19.alu s3, s14, s3, #SHIFT ; (delay slot) 2^21
        alu s4, MX, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, one
        alu s4, MN, s3, #OP_ADD ; (delay slot)
        nop()
        ptst p3, s0, #LE4, #PTST
        jmp #3, #3, one
        nop()
        nop()
        jmp #ALWAYS, #0, done
        ldi s6, #0              ; (delay slot)
        nop()
two:    jmp #ALWAYS, #0, done
        ldi s6, #2              ; (delay slot)
        nop()
one:    ldi s6, #1
done:
}

; X[BASE ..] = shift23(X[BASE ..], s6) over COUNT words: s6 < 0 a rounded right shift. Uses s1,
; s4, s9, A8, A9 and aimm's registers.
.macro im_shift(BASE, COUNT) {
        aimm_e(4, BASE)
        aimm_o(4, BASE)
        ldi s9, #COUNT
sl:     x19.xrd s1, #8
        x02.ainc #8, #8
        x19.alu s1, s1, s6, #SHIFT
        stx A9, s1
        x02.ainc #9, #9
        alu s9, s9, s14, #OP_SUB
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, sl
        nop()
        nop()
}

; Normalise IN; the zero block clears OUT and jumps to SILENT.
.macro im_norm(N2, IN, OUT, ESLOT, SILENT) {
        im_scan(IN, N2)
        alu s1, s0, s11, #OP_SUB ; -min
        alu s4, s1, s10, #OP_SUB
        ptst p3, s0, #LE4, #PTST
        jmp #3, #3, havebig
        alu s5, s10, s0, #OP_ADD ; (delay slot) big = max
        nop()
        alu s5, s1, s0, #OP_ADD ; big = -min
havebig: alu s4, s5, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, nonzero
        nop()
        nop()
        aimm_o(4, OUT)
        ldi s9, #2 * N2
        alu s4, s0, s0, #OP_ADD ; stx An, s0 stores the X latch (x17 fact 709)
clr:    stx A9, s4
        x02.ainc #9, #9
        alu s9, s9, s14, #OP_SUB
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, clr
        alu s4, s0, s0, #OP_ADD ; (delay slot) 0 again for the store
        nop()
        jmp #ALWAYS, #0, SILENT
        nop()
        nop()
nonzero: im_decide(s10, s11)
        ldi s4, #2
        alu s4, s6, s4, #OP_SUB
        ptst p3, s0, #EQ4, #PTST ; big >= 2^22: one rounded halving
        jmp #3, #3, scale
        ldi s6, #-1             ; (delay slot)
        nop()
        ldi s6, #0
        ldi s3, #21
        x19.alu s3, s14, s3, #SHIFT ; 2^21
dbl:    alu s4, s5, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, scale
        nop()
        nop()
        alu s5, s5, s5, #OP_ADD
        jmp #ALWAYS, #0, dbl
        alu s6, s6, s14, #OP_ADD ; (delay slot)
        nop()
scale:  yld(s3, ESLOT)
        alu s3, s3, s6, #OP_SUB
        yst(IM_EX)              ; E' = E - count
        im_shift(IN, N2)
}

; s15 = min(s15, norm(V)), the fewest redundant sign bits so far (x01.norm, x18.min: x17
; handbook §10, fact 708). Uses T.
.macro im_trk(V, T) {
        x01.norm T, V
        x18.min s15, s15, T
}

; The stage's scaling from s15 (the twin's stageShift): s6 = max(0, 23 - LIM - s15), s12 = -s6
; (the rounded right shift its loads take), IM_SC += s6, s15 = 24 again. Uses s3.
.macro im_dec(LIM) {
        ldi s6, #23 - LIM
        alu s6, s6, s15, #OP_SUB
        x18.max s6, s6, s0
        alu s12, s0, s6, #OP_SUB
        yld(s3, IM_SC)
        alu s3, s3, s6, #OP_ADD
        yst(IM_SC)
        ldi s15, #24
}

; A<2k> = the value s<src> + 2 (mem.sm's amov path without its first two steps): e6, R7.
.macro im_aset(src, k) {
        x17.mve e6, src
        x19.a3 s0, R7, e6, #25, #2, #0
        x12.aset #k, R7
}

; Z[rev n] = (IN[2n], IN[n2 - 1 - 2n]) * PRE[n], tracking the fewest redundant sign bits in s15.
; Y REV holds Z + 2 rev(n) - 2.
.macro im_pre(N2, N4, IN, PRE, REV) {
        ldi s12, #IN
        amov_e(2, s12)
        ldi s12, #IN + N2 - 1
        amov_e(3, s12)
        aimm_e(4, PRE)
        ldi s13, #REV - 1
        x17.mve e7, s13         ; e7 = REV
        rimm R2, #-2
        ldi s11, #N4
        ldi s15, #24
pre:    x19.xrd s1, #4          ; xr
        x02.ainc #4, #4
        x02.ainc #4, #4
        x19.xrd s12, #6         ; xi
        x18.rag101 s0, R3, A6, R2, #2
        x12.aset #3, R3
        x19.xrd s3, #8          ; pr
        x02.ainc #8, #8
        x19.xrd s5, #8          ; pi
        x02.ainc #8, #8
        x02.mpy s6, s1, s3
        x02.mpy s8, s12, s5
        alu s6, s6, s8, #OP_SUB ; re
        x02.mpy s8, s1, s5
        x02.mpy s9, s12, s3
        alu s8, s8, s9, #OP_ADD ; im
        ldy s10, e7
        x18.eagu e7, e7, #AGU_INC
        im_aset(s10, 6)
        stx A12, s6
        x02.ainc #12, #12
        stx A12, s8
        im_trk(s6, s7)
        im_trk(s8, s7)
        alu s11, s11, s14, #OP_SUB
        alu s4, s11, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, pre
        nop()
        nop()
}

; RD = s<src> (the R write path of mem.sm's amov). Uses s13, e6.
.macro im_rset(src, RD) {
        ldi s13, #2
        alu s13, src, s13, #OP_SUB
        x17.mve e6, s13
        x19.a3 s0, RD, e6, #25, #2, #0
}

; The FFT (the twin's `fft`): in place over Z's N4 complex points in bit-reversed order, a
; radix-2 first stage when log2 N4 is odd, then radix-4 stages. Each stage first takes its
; shift from the outputs the stage before tracked (im_dec), and its loads apply it. Loads are
; x03.tap0 into s0's product (a pure X load and step, fact 709); x02.ainc steps the stores.

; Radix 2 over adjacent pairs, N4 / 2 butterflies. Uses s1, s3..s9, s13, A4, A10.
.macro im_r2(N4, Z) {
        aimm_e(2, Z)
        aimm_e(5, Z)
        ldi s4, #N4 / 2
        x03.tap0 s1, #4, s0, s0, s0 ; ar
r2:     x03.tap0 s3, #4, s0, s0, s0 ; ai
        x03.tap0 s5, #4, s0, s0, s0 ; br
        x03.tap0 s7, #4, s0, s0, s0 ; bi
        x19.alu s1, s1, s12, #SHIFT
        x19.alu s3, s3, s12, #SHIFT
        x19.alu s5, s5, s12, #SHIFT
        x19.alu s7, s7, s12, #SHIFT
        alu s8, s1, s5, #OP_ADD
        alu s9, s3, s7, #OP_ADD
        alu s1, s1, s5, #OP_SUB
        alu s3, s3, s7, #OP_SUB
        stx A10, s8
        x02.ainc #10, #10
        stx A10, s9
        x02.ainc #10, #10
        stx A10, s1
        x02.ainc #10, #10
        stx A10, s3
        x02.ainc #10, #10
        im_trk(s8, s13)
        im_trk(s9, s13)
        im_trk(s1, s13)
        x01.norm s13, s3
        alu s4, s4, s14, #OP_SUB
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, r2
        x18.min s15, s15, s13   ; (delay slot)
        x03.tap0 s1, #4, s0, s0, s0 ; (delay slot) the next ar; past the end, a dummy
}

; One block's two words from A an into D1, D2, shifted by s12.
.macro im_ld2(D1, D2, an) {
        x03.tap0 D1, #an, s0, s0, s0
        x03.tap0 D2, #an, s0, s0, s0
        x19.alu D1, D1, s12, #SHIFT
        x19.alu D2, D2, s12, #SHIFT
}

; (RE, IM) = (A1, A2) * W, W = the next twiddle pair from A12. Uses s4, s5, A1 (x02.mpy).
.macro im_cm(RE, IM, A1, A2) {
        x03.tap0 s4, #12, s0, s0, s0 ; wr
        x03.tap0 s5, #12, s0, s0, s0 ; wi
        x02.mpy RE, A1, s4
        x02.mpy IM, A2, s5
        alu RE, RE, IM, #OP_SUB
        x02.mpy IM, A1, s5
        x02.mpy A1, A2, s4
        alu IM, IM, A1, #OP_ADD
}

; The radix-4 stages: STG of them from l = L0 (block size), groups N4 / (4 l), twiddles from TW
; (the twin's tw4, a triple per j). Blocks at A4, A6, A8, A10 (Z + 8 l g + {0, 2, 4, 6} l + 2 j),
; twiddles at A12; R6 = 2 l, R5 = 6 l, R4 the group's end for A10, R2 the stage's twiddles,
; R1 = -2.
.macro im_r4(N4, Z, TW, L0, STG) {
        ldi s3, #L0
        yst(IM_HALF)
        ldi s3, #N4 / (4 * L0)
        yst(IM_GRPS)
        ldi s3, #TW
        yst(IM_PJ)
        ldi s3, #STG
        yst(IM_STG)
        rimm R1, #-2
stage:  im_dec(20)
        yld(s1, IM_HALF)
        alu s1, s1, s1, #OP_ADD ; 2 l
        im_rset(s1, R6)
        alu s3, s1, s1, #OP_ADD
        alu s1, s1, s3, #OP_ADD ; 6 l
        im_rset(s1, R5)
        yld(s1, IM_PJ)
        im_rset(s1, R2)
        aimm_e(2, Z)
        x18.rag101 s0, R3, A4, R6, #2
        x12.aset #3, R3         ; A6 = Z + 2 l
        x18.rag101 s0, R3, A6, R6, #2
        x12.aset #4, R3         ; A8
        x18.rag101 s0, R3, A8, R6, #2
        x12.aset #5, R3         ; A10
        yld(s3, IM_GRPS)
        yst(IM_J)
        ldi s13, #IM_J - 1
        x17.mve e8, s13
grp:    x18.rag101 s0, R4, A10, R6, #2 ; the group's end for A10
        x12.aset #6, R2         ; A12 = the stage's twiddles
bf:     im_ld2(s1, s3, 8)       ; F1 = block 2
        im_cm(s6, s7, s1, s3)   ; F1 W^j
        im_ld2(s1, s3, 6)       ; F2 = block 1
        im_cm(s8, s9, s1, s3)   ; F2 W^2j
        im_ld2(s1, s3, 10)      ; F3 = block 3
        im_cm(s10, s11, s1, s3) ; F3 W^3j
        im_ld2(s1, s3, 4)       ; F0
        x18.rag101 s0, R3, A4, R1, #2 ; every block back to its j (R1 = -2)
        x12.aset #2, R3
        x18.rag101 s0, R3, A6, R1, #2
        x12.aset #3, R3
        x18.rag101 s0, R3, A8, R1, #2
        x12.aset #4, R3
        x18.rag101 s0, R3, A10, R1, #2
        x12.aset #5, R3
        alu s4, s1, s8, #OP_ADD ; p = F0 + F2 W^2j
        alu s5, s3, s9, #OP_ADD
        alu s1, s1, s8, #OP_SUB ; q
        alu s3, s3, s9, #OP_SUB
        alu s8, s6, s10, #OP_ADD ; r = F1 W^j + F3 W^3j
        alu s9, s7, s11, #OP_ADD
        alu s6, s6, s10, #OP_SUB ; s
        alu s7, s7, s11, #OP_SUB
        alu s10, s4, s8, #OP_ADD ; p + r
        alu s11, s5, s9, #OP_ADD
        alu s4, s4, s8, #OP_SUB ; p - r
        alu s5, s5, s9, #OP_SUB
        alu s8, s1, s7, #OP_ADD ; q - j s
        alu s9, s3, s6, #OP_SUB
        alu s1, s1, s7, #OP_SUB ; q + j s
        alu s3, s3, s6, #OP_ADD
        stx A4, s10
        x02.ainc #4, #4
        stx A4, s11
        x02.ainc #4, #4
        stx A6, s8
        x02.ainc #6, #6
        stx A6, s9
        x02.ainc #6, #6
        stx A8, s4
        x02.ainc #8, #8
        stx A8, s5
        x02.ainc #8, #8
        stx A10, s1
        x02.ainc #10, #10
        stx A10, s3
        x02.ainc #10, #10
        im_trk(s10, s6)
        im_trk(s11, s6)
        im_trk(s8, s6)
        im_trk(s9, s6)
        im_trk(s4, s6)
        im_trk(s5, s6)
        im_trk(s1, s6)
        x01.norm s6, s3
        pcond p3, R4, A10, #30  ; more in the group: A10 != R4
        jmp #3, #3, bf
        x18.min s15, s15, s6    ; (delay slot)
        nop()
        x18.rag101 s0, R3, A4, R5, #2
        x12.aset #2, R3         ; the next group: every block + 6 l
        x18.rag101 s0, R3, A6, R5, #2
        x12.aset #3, R3
        x18.rag101 s0, R3, A8, R5, #2
        x12.aset #4, R3
        x18.rag101 s0, R3, A10, R5, #2
        x12.aset #5, R3
        ldy s4, e8
        alu s4, s4, s14, #OP_SUB
        x17.sty e8, #4, #0
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, grp
        nop()
        nop()
        yld(s1, IM_HALF)
        alu s4, s1, s1, #OP_ADD
        alu s4, s4, s1, #OP_ADD
        alu s4, s4, s4, #OP_ADD ; 6 l: this stage's l triples
        yld(s3, IM_PJ)
        alu s3, s3, s4, #OP_ADD
        yst(IM_PJ)
        alu s3, s1, s1, #OP_ADD
        alu s3, s3, s3, #OP_ADD ; l * 4
        yst(IM_HALF)
        yld(s3, IM_GRPS)
        ldi s4, #-2
        x19.alu s3, s3, s4, #SHIFT ; groups / 4 (a multiple of 4 until the last stage: exact)
        yst(IM_GRPS)
        yld(s3, IM_STG)
        alu s3, s3, s14, #OP_SUB
        yst(IM_STG)
        alu s4, s3, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, stage
        nop()
        nop()
}

; u[2k] = re(Z[k] POST[k]), u[n2 - 1 - 2k] = -im(Z[k] POST[k]), u over IN.
.macro im_post(N2, N4, Z, IN, POST) {
        aimm_e(2, Z)
        aimm_e(4, POST)
        ldi s12, #IN
        amov_e(5, s12)
        ldi s12, #IN + N2 - 1
        amov_e(6, s12)
        rimm R2, #-2
        ldi s11, #N4
post:   x19.xrd s1, #4          ; er
        x02.ainc #4, #4
        x19.xrd s12, #4         ; ei
        x02.ainc #4, #4
        x19.xrd s3, #8          ; pr
        x02.ainc #8, #8
        x19.xrd s5, #8          ; pi
        x02.ainc #8, #8
        x02.mpy s6, s1, s3
        x02.mpy s8, s12, s5
        alu s6, s6, s8, #OP_SUB ; re
        x02.mpy s8, s1, s5
        x02.mpy s9, s12, s3
        alu s8, s8, s9, #OP_ADD ; im
        stx A10, s6
        x02.ainc #10, #10
        x02.ainc #10, #10
        alu s8, s0, s8, #OP_SUB
        stx A12, s8
        x18.rag101 s0, R3, A12, R2, #2
        x12.aset #6, R3
        alu s11, s11, s14, #OP_SUB
        alu s4, s11, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, post
        nop()
        nop()
}

; COUNT samples OUT.. <- shift23(v, s6), v = alu(X, Y, OP) of s1 = X[A8], A8 stepping by R2.
.macro im_fold_run(COUNT, X, Y, OP) {
        ldi s9, #COUNT
fr:     x19.xrd s1, #8
        x18.rag101 s0, R3, A8, R2, #2
        x12.aset #4, R3
        alu s1, X, Y, OP
        x19.alu s1, s1, s6, #SHIFT
        stx A9, s1
        x02.ainc #9, #9
        alu s9, s9, s14, #OP_SUB
        alu s4, s9, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, fr
        nop()
        nop()
}

; OUT[n] = shiftSat(fold(u)[n], scaled + E' - log2 n2 + 7).
.macro im_fold(N2, LOGN2, IN, OUT) {
        yld(s6, IM_SC)
        yld(s3, IM_EX)
        alu s6, s6, s3, #OP_ADD
        ldi s3, #7 - LOGN2
        alu s6, s6, s3, #OP_ADD
        aimm_o(4, OUT)
        ldi s12, #IN + N2 / 2
        amov_e(4, s12)
        rimm R2, #1
        im_fold_run(N2 / 2, s1, s0, #OP_ADD)
        ldi s12, #IN + N2 - 1
        amov_e(4, s12)
        rimm R2, #-1
        im_fold_run(N2, s0, s1, #OP_SUB)
        aimm_e(4, IN)
        rimm R2, #1
        im_fold_run(N2 / 2, s0, s1, #OP_SUB)
}

.macro imdct(N2, N4, LOGN2, STAGES, IN, Z, OUT, PRE, POST, TW, REV, ESLOT) {
        im_norm(N2, IN, OUT, ESLOT, silent)
        im_pre(N2, N4, IN, PRE, REV)
        ldi s3, #0
        yst(IM_SC)
        im_dec(21)
        im_r2(N4, Z)
        im_r4(N4, Z, TW, 2, (STAGES / 2))
        im_post(N2, N4, Z, IN, POST)
        im_fold(N2, LOGN2, IN, OUT)
silent: ldi s15, #16
}

; The same for an even STAGES (the short block): radix 4 throughout.
.macro imdct_even(N2, N4, LOGN2, STAGES, IN, Z, OUT, PRE, POST, TW, REV, ESLOT) {
        im_norm(N2, IN, OUT, ESLOT, silent)
        im_pre(N2, N4, IN, PRE, REV)
        ldi s3, #0
        yst(IM_SC)
        im_r4(N4, Z, TW, 1, (STAGES / 2))
        im_post(N2, N4, Z, IN, POST)
        im_fold(N2, LOGN2, IN, OUT)
silent: ldi s15, #16
}
