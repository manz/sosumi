; Audited from x17 1160023 examples/lib/bits.sm, 2026-11-08 (docs/x17-import.md).
; Twin: ref/dsp/bits.zig; ISO/IEC 14496-3 bit order (bslbf, MSB first). ISA: x17 docs/sm1/reference.md entries named below.
; MSB-first bit reader over the host's input stream (specs/aac.md input contract, facts 783,
; 784): the packet's bytes arrive through x16.getb, one stream across packets, never realigned.
; The twin of ref/dsp/bits.zig, streaming instead of random access:
;
;   s9   cache: the `avail` unread bits, right-aligned (below 2^23)
;   s10  avail
;   s14  1, s15 16 (constants); unconditional jumps use mode 1 (`jmp #ALWAYS, #0`):
;        an x19alu sets p2 on silicon, so no predicate is assumed clear
;   s6, s11, s12, s13 scratch; s0 stays 0
;
; refill(): one stream byte, cache = cache * 2^8 + the byte, avail + 8. The reader takes a byte
; only when it needs one of its bits, so it never reads into the next packet (a read past the
; armed bytes would wait for the next arm, 784); the bits left in the cache after a packet's
; last element are its byte padding, dropped by the next bits_init. Uses s13, A15; x02.asrc
; also steps A1 on silicon (fact 795), so A1 holds nothing across a read.
;
; getbits(dst, k), k in 0..15 (getbits_s takes k in s11; k = 0 reads 0): refill a byte at a
; time while avail < k (the cache stays below 2^23), then dst = floor(cache / 2^sh),
; sh = avail - k, by the alu head's arithmetic shift (fact 774). Every form used is gated on silicon.

.const OP_ADD  = 14
.const OP_SUB  = 0x10
.const SHIFT   = 23
.const ASR     = 6               ; alu head: b >> a, a negative a shifts left (fact 774)
.const ASRRS   = 7               ; the same, rounding right, saturating left
.const AGU_INC = 2
.const PTST    = 0x0B
; ptst conditions (reference.md `ptst`, own-ptst-c1-*; c1 = a <= -s4 on silicon, 7 of 7): the b-only rows,
; b = s<4 * c[1:0]>, a ignored, each gated on silicon (own-ptst-c10..c31). Each test puts its value in s4, s8 or
; s12 (s0 as a register is OPEN).
.const LT4    = 13              ; s4 < 0
.const LT8    = 14              ; s8 < 0
.const LT12   = 15              ; s12 < 0
.const LE4    = 9               ; s4 <= 0
.const LE8    = 10              ; s8 <= 0
.const LE12   = 11              ; s12 <= 0
.const EQ4    = 29              ; s4 == 0
.const EQ8    = 30              ; s8 == 0
.const EQ12   = 31              ; s12 == 0
.const IF_NOT = 2               ; jmp mode: taken when the predicate is clear
.const ALWAYS = 1               ; jmp mode: always taken (reference.md `jmp`, own-jmp)

.const BITS_ON = 0x2EFE         ; DSP-only Y: the stream is enabled; 0 until the first packet

; Each packet: an empty cache and the constants; the stream enabled once per stream (783: the
; enable survives re-arms, a second one misbehaves). Uses s3, s12, e6, A13, p2, p3.
.macro bits_init() {
        lde e6, #BITS_ON
        ldy s12, e6
        ptst p3, s0, #EQ12, #PTST ; p3 = not yet enabled
        jmp #IF_NOT, #3, on
        nop()
        nop()
        ldi s12, #1
        ldi s14, #4
        ld0e.sen #0, #3         ; the enable: s12 = 1, s14 = 4 (783); A13 <- 0
        ldi s3, #1
        x17.sty e6, #3, #0      ; BITS_ON = 1
on:     ldi s9, #0
        ldi s10, #0
        ldi s14, #1
        ldi s15, #16
        ldi s12, #0
        ptst p2, s0, #LT12, #PTST ; p2 = 0: the always-false predicate
}

.macro nop() {
        alu s0, s0, s0, #0
}

.macro refill() {
        x16.getb #7, #7         ; A15 <- the next 8 stream bits (783)
        ldi s13, #-8
        alu s9, s13, s9, #ASR   ; cache << 8 (alu asr, a negative count shifts left: fact 774)
        x02.asrc s13, A15       ; A15 + 1 (own-x02asrc; fresh from the read on, fact 789); A1 clobbered (795)
        alu s13, s13, s14, #OP_SUB ; the byte
        alu s9, s9, s13, #OP_ADD
        ldi s13, #8
        alu s10, s10, s13, #OP_ADD ; avail += 8
}

.macro getbits(dst, k) {
        ldi s11, #k
        getbits_s(dst)
}

; dst = floor(c / 2^sh) by alu's asr (fact 774), then the cache keeps c - dst * 2^sh. dst is
; not s6, s9, s10 or s12.
.macro getbits_s(dst) {
need:   alu s12, s10, s11, #OP_SUB ; sh = avail - k
        ptst p3, s0, #LT12, #PTST ; p3 = avail < k
        jmp #IF_NOT, #3, have
        ldi s13, #-8            ; (delay slot)
        nop()                   ; (delay slot)
        x16.getb #7, #7         ; a byte at a time (refill's steps): k may pass 8
        alu s9, s13, s9, #ASR   ; cache << 8
        ldi s12, #8
        x02.asrc s13, A15       ; the byte + 1, two bundles after the read
        alu s13, s13, s14, #OP_SUB
        jmp #ALWAYS, #0, need
        alu s9, s9, s13, #OP_ADD ; (delay slot)
        alu s10, s10, s12, #OP_ADD ; (delay slot) avail += 8
have:   alu dst, s12, s9, #ASR  ; dst = floor(c / 2^sh)
        alu s6, s0, s12, #OP_SUB ; -sh
        alu s6, s6, dst, #ASR   ; dst << sh
        alu s9, s9, s6, #OP_SUB ; the cache keeps the low sh bits
        alu s10, s12, s0, #OP_ADD ; avail = sh
}

; readn(dst), n in s7 (0..24, consumed): dst = the next n bits, read 8 at a time. Uses s5.
.macro readn(dst) {
        alu dst, s0, s0, #OP_ADD
more:   alu s12, s7, s14, #OP_SUB ; n - 1
        ptst p3, s0, #LT12, #PTST ; p3 = n == 0
        jmp #3, #3, done
        nop()
        ldi s11, #8             ; (second delay slot, harmless)
        alu s12, s7, s11, #OP_SUB ; n - 8
        ptst p3, s0, #LT12, #PTST
        jmp #IF_NOT, #3, full   ; n >= 8: take 8, n - 8 left
        nop()
        nop()
        alu s11, s7, s0, #OP_ADD ; n < 8: take n
        alu s12, s0, s0, #OP_ADD ;        none left
full:   alu s7, s12, s0, #OP_ADD
        getbits_s(s5)
        alu s6, s0, s11, #OP_SUB
        alu dst, s6, dst, #ASR  ; dst << taken
        alu dst, dst, s5, #OP_ADD
        jmp #ALWAYS, #0, more
        nop()
        nop()
done:
}
