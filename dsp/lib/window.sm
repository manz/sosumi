; Audited from x17 dd66f03 examples/lib/window.sm, 2026-11-08 (docs/x17-import.md).
; Twin: ref/dsp/aac/window.zig; ISO/IEC 14496-3 4.6.11.3.3 (windowing, block switching).
; AAC window, overlap-add and PCM: the twin of ref/dsp/aac/window.zig.
;
; The IMDCT's 2048 Q7 words times the window halves, stored as w / 4 in Q23 so one rounded
; multiply gives Q5 words whose sums never wrap. PCM = clamp(rshr(overlap + block, 5)) to
; 16 bits; the shift comes first, so the clamp's differences stay within 2^18.
;
; Needs lib/bits.sm (s0 = 0, s14 = 1) and lib/mem.sm. x02.ainc's template also writes s2 and
; x02.mpy steps A1, so nothing lives in them. The overlap's X address is a Y slot, WIN_OVL, and
; so are the window halves': WIN_R the rising side's (the previous shape, long for only_long and
; long_start, else short), WIN_F the falling side's (the current shape, long for only_long and
; long_stop, else short; eight_short's later windows rise on it too). So one copy of the code
; serves every channel and shape.

.const WIN_OVL = 0x2388
.const WIN_R   = 0x2389
.const WIN_F   = 0x238A

; A6 = Y:[SLOT] (x03.acp, fact 193). x03.acp's template zeroes s7. Uses e6.
.macro win_a6(SLOT) {
        lde e6, #SLOT
        x03.acp A6, A0, e6, #1
}

; A6 = Y:[SLOT] + OFF (x02.aa fn 2, 403). Uses e6, R7.
.macro win_a6o(SLOT, OFF) {
        win_a6(SLOT)
        rimm R7, #OFF
        x02.aa A6, A6, R7, #2, A0, A0
}

; A8 = Y:[WIN_OVL]. Uses s12 and amov_e's registers.
.macro win_a8ovl() {
        yld(s12, WIN_OVL)
        amov_e(4, s12)
}

; win_long(T, PCM): an only_long block.
;   X T    the IMDCT's 2048 words
;   X Y:[WIN_R] the previous shape's rising half, 1024 words; X Y:[WIN_F] the current shape's
;   X OVL  1024 overlap words at Y:[WIN_OVL], read then rewritten with the block's second half
;   Y PCM  1024 samples out
; Uses s1, s3 .. s13, e6, e7, R2, R3, R7, A4, A6, A8, A10, A14, p3 (all the macros here).
.macro win_long(T, PCM) {
        aimm_e(2, T)
        win_a6(WIN_R)
        win_a8ovl()
        rimm R4, #0             ; set below: A8's end
        lde e7, #PCM
        ldi s9, #32767
        ldi s10, #-32768
        yld(s12, WIN_OVL)
        ldi s13, #1024
        alu s12, s12, s13, #OP_ADD
        win_rset(s12, R4)       ; R4 = OVL + 1024
        pk(s1, A4, s0, s0, s0, 0, s0, s0, 0, 0) ; t
first:  pk(s3, A6, s0, s0, s0, 0, s0, s0, 0, 0) ; w
        pk(s6, A8, s5, s1, s3, 0, s0, s0, 0, 0) ; overlap; t w
        pkn(s1, A4, s0, s0, s0, 5, s5, s6, 0, 4, 5) ; the next t; rshr(t w + overlap, 5)
        x18.min s5, s5, s9
        pcond p3, R4, A8, #30
        jmp #3, #3, first
        x18.max s5, s5, s10     ; (delay slot)
        x17.styi e7, #5, #0, e7 ; (delay slot)
        ; s1 holds T[1024], A4 = T + 1025
        win_a6o(WIN_F, 1023)     ; the current shape, falling
        win_a8ovl()
        rimm R4, #T + 2048      ; A4's end
second: x19.xrd s3, #6          ; w
        x02.aa A6, A6, R0, #1, A0, A0 ; A6 - 1 (fn 1, 403)
        pk(s0, A0, s5, s1, s3, 0, s0, s0, 0, 0) ; t w
        pcond p3, R4, A4, #30
        jmp #3, #3, second
        pks(5, A8, 0, s0, s0, 0) ; (delay slot)
        pk(s1, A4, s0, s0, s0, 0, s0, s0, 0, 0) ; (delay slot) the next t
}

; RD = s<src> (mem.sm's amov R path). Uses s13, e6.
.macro win_rset(src, RD) {
        ldi s13, #2
        alu s13, src, s13, #OP_SUB
        x17.mve e6, s13
        x19.a3 s0, RD, e6, #25, #2, #0
}

; The other sequences build the Q5 block in X B (2048 words) from runs, then win_out.

; B.. = rnd(T.. * W.. / 2^23) over COUNT words (even), W = Y:[SLOT] rising: two samples a
; pass of eight bundles, t alternating between s1 and s7 so no bundle loads a register its
; product reads. Uses s1, s3, s5 .. s7, R4, A4, A6, A8 and aimm's registers.
.macro win_run(COUNT, T, SLOT, B) {
        aimm_e(2, T)
        win_a6(SLOT)
        aimm_e(4, B)
        rimm R4, #T + 1 + COUNT ; A4's end
        pk(s1, A4, s0, s0, s0, 0, s0, s0, 0, 0)
wr:     pk(s3, A6, s0, s0, s0, 0, s0, s0, 0, 0)
        pk(s7, A4, s5, s1, s3, 0, s0, s0, 0, 0)
        pk(s3, A6, s0, s0, s0, 0, s0, s0, 0, 0)
        pk(s1, A4, s6, s7, s3, 0, s0, s0, 0, 0)
        pcond p3, R4, A4, #30
        jmp #3, #3, wr
        pks(5, A8, 0, s0, s0, 0) ; (delay slot)
        pks(6, A8, 0, s0, s0, 0) ; (delay slot)
}

; The same with W falling from Y:[SLOT] + OFF (x02.aa fn 1 steps A6 down, 403, 738).
.macro win_rund(COUNT, T, SLOT, OFF, B) {
        aimm_e(2, T)
        win_a6o(SLOT, OFF)
        aimm_e(4, B)
        rimm R4, #T + 1 + COUNT
        pk(s1, A4, s0, s0, s0, 0, s0, s0, 0, 0)
wd:     x19.xrd s3, #6
        x02.aa A6, A6, R0, #1, A0, A0
        pk(s7, A4, s5, s1, s3, 0, s0, s0, 0, 0)
        x19.xrd s3, #6
        x02.aa A6, A6, R0, #1, A0, A0
        pk(s1, A4, s6, s7, s3, 0, s0, s0, 0, 0)
        pcond p3, R4, A4, #30
        jmp #3, #3, wd
        pks(5, A8, 0, s0, s0, 0) ; (delay slot)
        pks(6, A8, 0, s0, s0, 0) ; (delay slot)
}

; B.. += rnd(T.. * W.. / 2^23), W rising: the short windows' overlapping halves, two samples a
; pass of ten bundles. Uses win_run's registers and s8, A10.
.macro win_acc(COUNT, T, SLOT, B) {
        aimm_e(2, T)
        win_a6(SLOT)
        aimm_e(4, B)
        aimm_e(5, B)
        rimm R4, #T + 1 + COUNT
        pk(s1, A4, s0, s0, s0, 0, s0, s0, 0, 0)
wa:     pk(s3, A6, s0, s0, s0, 0, s0, s0, 0, 0)
        pk(s7, A4, s5, s1, s3, 0, s0, s0, 0, 0)
        pk(s6, A8, s0, s0, s0, 0, s0, s0, 0, 0)
        pk(s3, A6, s0, s0, s0, 5, s5, s6, 0, 0)
        pk(s1, A4, s8, s7, s3, 0, s0, s0, 0, 0)
        pk(s6, A8, s0, s0, s0, 0, s0, s0, 0, 0)
        pcond p3, R4, A4, #30
        jmp #3, #3, wa
        pks(5, A10, 8, s8, s6, 0) ; (delay slot)
        pks(8, A10, 0, s0, s0, 0) ; (delay slot)
}

; B.. = rshr(T.., 2) over COUNT >= 2 words: the stretches where the window is 1, on x03's
; counted loop (ak_xrep's shape) with pkn's rounded shift in its slot. Uses s1, s3, s12, s13,
; e11, p3, A4, A8.
.macro win_quarter(COUNT, T, B) {
        aimm_e(2, T)
        aimm_e(4, B)
        pk(s1, A4, s0, s0, s0, 0, s0, s0, 0, 0)
        pkn(s1, A4, s0, s0, s0, 3, s1, s0, 0, 4, 2) ; s3 = rshr(t0, 2), s1 = t1
        ldi s12, #COUNT - 2
        x17.mve e11, s12        ; e11 = COUNT - 1
        alu s12, s0, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; p3 = 1
        x03.rep p3
        pkn(s1, A4, s0, s0, s0, 3, s1, s0, 0, 4, 2) ; (delay slot) the next
        nop()                   ; (delay slot)
}

; B.. = 0 over COUNT >= 2 words, on x03's counted loop. Uses s3, s12, e11, p3, A8.
.macro win_zero(COUNT, B) {
        aimm_e(4, B)
        ldi s3, #0
        ldi s12, #COUNT - 2
        x17.mve e11, s12
        alu s12, s0, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        x03.rep p3
        nop()                   ; (delay slot)
        nop()                   ; (delay slot)
}

; PCM = clamp(rshr(OVL + B[0 .. 1023], 5)); OVL = B[1024 .. 2047].
.macro win_out(B, PCM) {
        aimm_e(2, B)
        win_a8ovl()
        lde e7, #PCM
        ldi s9, #32767
        ldi s10, #-32768
        yld(s12, WIN_OVL)
        ldi s13, #1024
        alu s12, s12, s13, #OP_ADD
        win_rset(s12, R4)       ; R4 = OVL + 1024
        pk(s5, A4, s0, s0, s0, 0, s0, s0, 0, 0)
wo:     pk(s6, A8, s0, s0, s0, 0, s0, s0, 0, 0)
        pkn(s5, A4, s0, s0, s0, 7, s5, s6, 0, 4, 5) ; the next; rshr(b + overlap, 5)
        x18.min s7, s7, s9
        pcond p3, R4, A8, #30
        jmp #3, #3, wo
        x18.max s7, s7, s10     ; (delay slot)
        x17.styi e7, #7, #0, e7 ; (delay slot)
        ldi s5, #B + 1024       ; the second half to the overlap
        ldi s6, #1024
        yld(s12, WIN_OVL)
        amov_e(4, s12)
        amov_e(2, s5)
        win_xrep()
}

; X[A8 ..] = X[A4 ..], s6 >= 2 words on x03's counted loop (aac.sm's ak_xrep). Uses s3, s12,
; s13, e11, p3.
.macro win_xrep() {
        x19.xrd s3, #4
        x02.ainc #4, #4
        alu s12, s6, s14, #OP_SUB
        alu s12, s12, s14, #OP_SUB
        x17.mve e11, s12
        alu s12, s0, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        x03.rep p3
        x03.tap0 s3, #4, s0, s12, s13 ; (delay slot) the next word
        nop()                   ; (delay slot)
}

; long_start: the previous long shape rising, the current short one falling.
.macro win_start(T, B, PCM) {
        win_run(1024, T, WIN_R, B)
        win_quarter(448, T + 1024, B + 1024)
        win_rund(128, T + 1472, WIN_F, 127, B + 1472)
        win_zero(448, B + 1600)
        win_out(B, PCM)
}

; long_stop: the previous short shape rising, the current long one falling.
.macro win_stop(T, B, PCM) {
        win_zero(448, B)
        win_run(128, T + 448, WIN_R, B + 448)
        win_quarter(448, T + 576, B + 576)
        win_rund(1024, T + 1024, WIN_F, 1023, B + 1024)
        win_out(B, PCM)
}

; One short window w of eight_short: T the eight IMDCTs' 256 words each, contiguous. Its rising
; half (the current shape's) adds onto window w - 1's falling half (window 0 lands on nothing);
; the falling half lands on words nothing has written yet.
.macro win_short1(T, B, w) {
        win_acc(128, T + 256 * w, WIN_F, B + 448 + 128 * w)
        win_rund(128, T + 256 * w + 128, WIN_F, 127, B + 576 + 128 * w)
}

; eight_short: the previous short shape rising for window 0's left, else the current one.
.macro win_short(T, B, PCM) {
        win_zero(448, B)
        win_run(128, T, WIN_R, B + 448)
        win_rund(128, T + 128, WIN_F, 127, B + 576)
        win_short1(T, B, 1)
        win_short1(T, B, 2)
        win_short1(T, B, 3)
        win_short1(T, B, 4)
        win_short1(T, B, 5)
        win_short1(T, B, 6)
        win_short1(T, B, 7)
        win_zero(448, B + 1600)
        win_out(B, PCM)
}
