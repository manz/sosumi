; Audited from x17 4619771 examples/lib/window.sm, 2026-11-08 (docs/x17-import.md).
; Twin: ref/dsp/aac/window.zig; ISO/IEC 14496-3 4.6.11.3.3 (windowing, block switching).
; AAC window, overlap-add and PCM: the twin of ref/dsp/aac/window.zig.
;
; The IMDCT's 2048 Q7 words times the window halves, as w / 4 in Q23 so one rounded multiply
; gives Q5 words whose sums never wrap. PCM = clamp(rshr(overlap + block, 5)) to 16 bits; the
; shift comes first, so the clamp's differences stay within 2^18.
;
; The halves come from the shared tables (docs/aac-mode0.md, ref/dsp/aac/sine.zig): the sine
; shape from X SINE, sin(k pi / 4096) in Q23 (the odd k at SINE, the multiples of 4 at SINE4)
; with a rounded shift by 2, the KBD shape from Y, w / 4 / 2^6 in 16 bits, shifted back up by 6.
; Each half multiplies the words in place (win_mul), then the sequence's runs add up.
;
; Needs lib/bits.sm (s0 = 0, s14 = 1) and lib/mem.sm. x02.ainc's template also writes s2 and
; x02.mpy steps A1, so nothing lives in them. The overlap's X address is a Y slot, WIN_OVL, and
; the shapes are Y slots too (0 sine, 1 KBD): WIN_R the rising side's (the previous shape),
; WIN_F the falling side's (the current one; eight_short's later windows rise on it too). So one
; copy of the code serves every channel and shape.

.const WIN_OVL = 0x2350
.const WIN_R   = 0x2351
.const WIN_F   = 0x2352
.const WIN_PCM = 0x2E40          ; the PCM base - 1
.const WIN_S   = 0x2E41          ; eight_short: the rising shape of the window being done
.const WIN_OUT = 0x2E42          ; eight_short: where its words add in B
.const SINE    = 0x1400          ; X: sin(k pi / 4096), k = 1, 3 .. 2047 (1024 words)
.const SINE4   = SINE + 1024     ; X: k = 0, 4 .. 2048 (513 words)
.const KBD_L   = 0x28F4          ; Y: the long KBD rise, w / 4 / 2^6
.const KBD_S   = KBD_L + 1024    ; Y: the short one
.const AGU_DEC = 4               ; x18.eagu op 4: e - 1 (x17 isa.toml, x18 class 000)

; A6 = Y:[SLOT] (x03.acp, fact 193). x03.acp also loads s7 with that word (facts 190, 748). Uses e6, s7.
.macro win_a6(SLOT) {
        lde e6, #SLOT
        x03.acp A6, A0, e6, #1
}

; A6 = Y:[SLOT] + OFF (x02.aa fn 2, 403). Uses e6, R7.
.macro win_a6o(SLOT, OFF) {
        win_a6(SLOT)
        rimm R7, #OFF
        x02.aa A6, A6, R7, #2, A0, A0
}

; A8 = Y:[WIN_OVL]. Uses s12 and amov_e's registers.
.macro win_a8ovl() {
        yld(s12, WIN_OVL)
        amov_e(4, s12)
}

; e7 = Y:[WIN_PCM] + 1 (x17.mve adds 1), the first PCM word. Uses s12, e6.
.macro win_pcm() {
        yld(s12, WIN_PCM)
        x17.mve e7, s12
}

; RD = s<src> (mem.sm's amov R path). Uses s13, e6.
.macro win_rset(src, RD) {
        ldi s13, #2
        alu s13, src, s13, #OP_SUB
        x17.mve e6, s13
        x19.a3 s0, RD, e6, #25, #2, #0
}

; X[T .. T + COUNT) = rnd(X[..] * w / 2^23) in place, w the half's w / 4 in Q23: the shape in
; Y:[SLOT] (0 sine, 1 KBD), LONG 1 for 1024 words (else 128), FALL 1 for the falling side (the
; table read backwards). The start address is s9. Uses s1, s3 .. s7, s9, s12, s13, e6, R4, R7,
; A4, A6, A8, p3 (amov_e and win_rset take s13).

.macro win_mulr(COUNT, SLOT, LONG, FALL) {
        amov_e(2, s9)
        amov_e(4, s9)
        ldi s12, #COUNT
        alu s12, s9, s12, #OP_ADD
        win_rset(s12, R4)       ; R4 = T + COUNT, A4's end
        yld(s4, SLOT)
        ptst p3, s0, #EQ4, #PTST
        jmp #IF_NOT, #3, kbd
        nop()
        nop()
        ; sine: A6 steps R7 through SINE (long) or SINE4 + 2 by 4 (short); pk's third slot
        ; rounds w down by 2 (asrrs, fact 730)
        aimm_e(3, SINE + LONG * (FALL * 1023) + (1 - LONG) * (SINE4 - SINE + 2 + FALL * 508))
        rimm R7, #(1 - 2 * FALL) * (LONG + 4 * (1 - LONG))
        ldi s12, #2
        pkf(s3, A6, s0, s0, s0, 0, s0, s0, 0, 0, 2, R7) ; w
sl:     pk(s1, A4, s0, s0, s0, 4, s12, s3, 0, 7) ; t; s4 = rshr(w, 2)
        pkf(s3, A6, s5, s1, s4, 0, s0, s0, 0, 0, 2, R7) ; the next w; t w
        pk(s1, A4, s0, s0, s0, 4, s12, s3, 0, 7)
        pks(5, A8, 0, s0, s0, 0)
        pkf(s3, A6, s5, s1, s4, 0, s0, s0, 0, 0, 2, R7)
        pk(s1, A4, s0, s0, s0, 4, s12, s3, 0, 7)
        pks(5, A8, 0, s0, s0, 0)
        pkf(s3, A6, s5, s1, s4, 0, s0, s0, 0, 0, 2, R7)
        pk(s1, A4, s0, s0, s0, 4, s12, s3, 0, 7)
        pks(5, A8, 0, s0, s0, 0)
        pkf(s3, A6, s5, s1, s4, 0, s0, s0, 0, 0, 2, R7)
        pcond p3, R4, A4, #30   ; more: A4 != T + COUNT (four words a pass)
        jmp #3, #3, sl
        pks(5, A8, 0, s0, s0, 0) ; (delay slot)
        nop()                   ; (delay slot)
        jmp #ALWAYS, #0, done
        nop()
        nop()
        ; KBD: Y from e6, w << 6 in the same third slot (a negative count shifts left)
; Pipelined: each pk loads a t and shifts its w while multiplying the word before, t and w
; alternating between s1, s4 and s7, s6 (no bundle loads a register its product reads), so the
; first word goes ahead of the loop (pairs) and the last after it.
kbd:    ldi s12, #COUNT - 1
        alu s12, s9, s12, #OP_ADD
        win_rset(s12, R4)       ; R4 = T + COUNT - 1
        lde e6, #LONG * KBD_L + (1 - LONG) * KBD_S + FALL * (COUNT - 1)
        ldi s12, #-6
        ldy s3, e6
        x18.eagu e6, e6, #AGU_INC + FALL * (AGU_DEC - AGU_INC)
        pk(s1, A4, s0, s0, s0, 4, s12, s3, 0, 7) ; t; s4 = w << 6
kl:     ldy s3, e6
        x18.eagu e6, e6, #AGU_INC + FALL * (AGU_DEC - AGU_INC)
        pk(s7, A4, s5, s1, s4, 6, s12, s3, 0, 7) ; the next t and w; t w
        pks(5, A8, 0, s0, s0, 0)
        ldy s3, e6
        x18.eagu e6, e6, #AGU_INC + FALL * (AGU_DEC - AGU_INC)
        pk(s1, A4, s5, s7, s6, 4, s12, s3, 0, 7)
        pcond p3, R4, A4, #30   ; more: A4 != T + COUNT - 1 (two words a pass)
        jmp #3, #3, kl
        pks(5, A8, 0, s0, s0, 0) ; (delay slot)
        nop()                   ; (delay slot)
        ldy s3, e6
        nop()
        pk(s7, A4, s5, s1, s4, 6, s12, s3, 0, 7)
        pks(5, A8, 0, s0, s0, 0)
        pk(s0, A0, s5, s7, s6, 0, s0, s0, 0, 0)
        pks(5, A8, 0, s0, s0, 0)
done:
}

; win_mulr at T through its subroutine L, one of winsubs.sm's five shapes. Uses win_mulr's registers.
.macro win_call(T, L) {
        ldi s9, #T
        call(L)
}

; win_mulr's five shapes as subroutines: winsubs.sm, which the program includes once after its
; last halt (labels a macro defines stay local to its expansion), its entry marked dsp_entry.
.macro win_sub(COUNT, SLOT, LONG, FALL) {
        win_mulr(COUNT, SLOT, LONG, FALL)
        ret()
}

; B.. = rshr(T.., 2) over COUNT >= 2 words: the stretches where the window is 1, on x03's
; counted loop (ak_xrep's shape) with pkn's rounded shift in its slot. Uses s1, s3, s12, s13,
; e11, p3, A4, A8.
.macro win_quarter(COUNT, T, B) {
        aimm_e(2, T)
        aimm_e(4, B)
        pk(s1, A4, s0, s0, s0, 0, s0, s0, 0, 0)
        pkn(s1, A4, s0, s0, s0, 3, s1, s0, 0, 4, 2) ; s3 = rshr(t0, 2), s1 = t1
        ldi s12, #COUNT - 2
        x17.mve e11, s12        ; e11 = COUNT - 1
        alu s12, s0, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; p3 = 1
        x03.rep p3
        pkn(s1, A4, s0, s0, s0, 3, s1, s0, 0, 4, 2) ; (delay slot) the next
        nop()                   ; (delay slot)
}

; B.. = 0 over COUNT >= 2 words, on x03's counted loop. Uses s3, s12, e11, p3, A8.
.macro win_zero(COUNT, B) {
        aimm_e(4, B)
        ldi s3, #0
        ldi s12, #COUNT - 2
        x17.mve e11, s12
        alu s12, s0, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        x03.rep p3
        nop()                   ; (delay slot)
        nop()                   ; (delay slot)
}

; PCM = clamp(rshr(OVL + B[0 .. 1023], 5)); OVL = B[1024 .. 2047]. The clamp to 16 bits is the
; head ALU's asrrs by -8, saturating at 24 bits, then asr by 8 (fact 774): x18.min / x18.max
; return b when b is 0x7FFF or -0x8000 on silicon (fact 950).
.macro win_out(B) {
        aimm_e(2, B)
        win_a8ovl()
        win_pcm()
        ldi s9, #-8             ; the clamp's counts
        ldi s10, #8
        yld(s12, WIN_OVL)
        ldi s13, #1024
        alu s12, s12, s13, #OP_ADD
        win_rset(s12, R4)       ; R4 = OVL + 1024
        pk(s5, A4, s0, s0, s0, 0, s0, s0, 0, 0)
wo:     pk(s6, A8, s0, s0, s0, 0, s0, s0, 0, 0)
        pkn(s5, A4, s0, s0, s0, 7, s5, s6, 0, 4, 5) ; the next; rshr(b + overlap, 5)
        alu s7, s9, s7, #ASRRS  ; v << 8, saturated at 24 bits
        pcond p3, R4, A8, #30
        jmp #3, #3, wo
        alu s7, s10, s7, #ASR   ; (delay slot) >> 8: clamp(v)
        x17.stys e7, #7, #0, e7, R6 ; (delay slot)
        ldi s5, #B + 1024       ; the second half to the overlap
        ldi s6, #1024
        yld(s12, WIN_OVL)
        amov_e(4, s12)
        amov_e(2, s5)
        win_xrep()
}

; X[A8 ..] = X[A4 ..], s6 >= 2 words on x03's counted loop (aac.sm's ak_xrep). Uses s3, s12,
; s13, e11, p3.
.macro win_xrep() {
        x19.xrd s3, #4
        x02.ainc #4, #4
        alu s12, s6, s14, #OP_SUB
        alu s12, s12, s14, #OP_SUB
        x17.mve e11, s12
        alu s12, s0, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        x03.rep p3
        x03.tap0 s3, #4, s0, s12, s13 ; (delay slot) the next word
        nop()                   ; (delay slot)
}


; only_long: both halves long.
.macro win_long(T) {
        win_call(T, wm_lr)
        win_call(T + 1024, wm_lf)
        win_out(T)
}

; long_start: the previous long shape rising, the current short one falling.
.macro win_start(T) {
        win_call(T, wm_lr)
        win_quarter(448, T + 1024, T + 1024)
        win_call(T + 1472, wm_sf)
        win_zero(448, T + 1600)
        win_out(T)
}

; long_stop: the previous short shape rising, the current long one falling.
.macro win_stop(T) {
        win_zero(448, T)
        win_call(T + 448, wm_sr)
        win_quarter(448, T + 576, T + 576)
        win_call(T + 1024, wm_lf)
        win_out(T)
}

; eight_short, one window at a time (docs/aac-mode0.md "IMDCT in place"): win_sinit, then
; win_sone for each window's 256 IMDCT words at T, then win_send. Window w is windowed in place
; (rising on the previous shape for w = 0, else the current one; falling on the current), its
; first half added at B + 448 + 128 w, its second half stored after it; so B + 448 + 128 w ..
; is written only after window w's words are read, wherever they sit below it.
.macro win_sinit(B) {
        win_zero(128, B + 448)
        yld(s3, WIN_R)
        yst(WIN_S)
        ldi s3, #B + 448
        yst(WIN_OUT)
}

; One window: T in place, then B[o .. o + 128) += T[0 .. 128), B[o + 128 .. o + 256) =
; T[128 .. 256), o = Y:[WIN_OUT] (then + 128). Uses win_mul's registers and s6, s7, A10.
.macro win_sone(T) {
        win_call(T, wm_ss)
        win_call(T + 128, wm_sf)
        yld(s3, WIN_F)
        yst(WIN_S)
        aimm_e(2, T)
        yld(s7, WIN_OUT)
        amov_e(4, s7)
        amov_e(5, s7)
        rimm R4, #T + 129       ; A4 runs one ahead
        pk(s1, A4, s0, s0, s0, 0, s0, s0, 0, 0)
sa:     pk(s6, A8, s0, s0, s0, 0, s0, s0, 0, 0)
        pk(s1, A4, s0, s0, s0, 7, s1, s6, 0, 0) ; the next t; t + b
        pks(7, A10, 0, s0, s0, 0)
        pk(s6, A8, s0, s0, s0, 0, s0, s0, 0, 0)
        pk(s1, A4, s0, s0, s0, 7, s1, s6, 0, 0)
        pks(7, A10, 0, s0, s0, 0)
        pk(s6, A8, s0, s0, s0, 0, s0, s0, 0, 0)
        pk(s1, A4, s0, s0, s0, 7, s1, s6, 0, 0)
        pks(7, A10, 0, s0, s0, 0)
        pk(s6, A8, s0, s0, s0, 0, s0, s0, 0, 0)
        pk(s1, A4, s0, s0, s0, 7, s1, s6, 0, 0)
        pcond p3, R4, A4, #30   ; four words a pass
        jmp #3, #3, sa
        pks(7, A10, 0, s0, s0, 0) ; (delay slot)
        nop()                   ; (delay slot)
        yld(s7, WIN_OUT)
        ldi s3, #128
        alu s7, s7, s3, #OP_ADD
        alu s3, s7, s0, #OP_ADD
        yst(WIN_OUT)
        amov_e(4, s7)
        aimm_e(2, T + 128)
        ldi s6, #128
        win_xrep()
}

; After the eighth window: B's untouched ends to 0, then the overlap and PCM.
.macro win_send(B) {
        win_zero(448, B)
        win_zero(448, B + 1600)
        win_out(B)
}
