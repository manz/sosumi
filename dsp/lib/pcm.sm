; Audited from x17 2f5d48b examples/lib/pcm.sm, 2026-11-08 (docs/x17-import.md).
; No ref twin: 16-bit PCM passthrough, byte order per WAV (little-endian) and AIFF (big-endian).
; PCM passthrough: one packet of 16-bit samples (WAV little-endian or AIFF big-endian) copied
; into the host's output ring (lib/ring.sm). Needs lib/bits.sm, lib/mem.sm and lib/ring.sm
; first; bits_init must point the reader at the packet.
;
; Parked: the device's PCM modes (2, 4, 6) use another host interface, its output not yet
; measured (specs/questions.md 18). This program keeps the AAC ring meanwhile.
; Contract (OURS, on x17's host model, src/host.zig; the ring and status are specs/aac.md's
; output contract):
;   Y:0x3FFF   packet length in bytes (host Q2 stub), even: whole 16-bit samples
;   Y:0x4000   packet bytes, two per word, big-endian pairs (host Q2 stub)
;   Y:0xFD81   sample byte order, OURS: 0 big-endian (AIFF), 1 little-endian (WAV)
;   PCM_OSL    the ring slot this packet fills, 0 at start, flipped per packet (DSP-only Y)
; Samples stay interleaved as the file has them, at most RING_SLOT a packet; the slot's length
; is the sample count.
;
; Registers: s1 samples left, s2 shift counts, s3 store source, s4 first byte, s5 sample count,
; s8 byte order, e7 the output pointer, e6 address scratch; bits.sm scratch as it documents.

.const PCM_FMT   = 0xFD81
.const PCM_OSL   = 0x2EFF

.macro pcm_packet() {
        yld(s1, 0x3FFF)
        ldi s2, #1
        alu s1, s2, s1, #ASR    ; samples = bytes / 2 (even, so exact)
        yld(s8, PCM_FMT)
        ring_base(s3, PCM_OSL)
        x17.mve e7, s3          ; e7 = OUTY + RING_SLOT PCM_OSL
        alu s5, s1, s0, #OP_ADD ; keep the sample count for the entry
        ldi s2, #-8             ; ASR by -8: << 8
pcm_loop:
        alu s12, s1, s0, #OP_ADD
        ptst p3, s0, #LE12, #PTST ; none left
        jmp #3, #3, pcm_done
        nop()
        nop()
        getbits(s4, 8)          ; first byte
        getbits(s3, 8)          ; second byte
        alu s12, s8, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST ; big-endian (after getbits, which uses p3)
        jmp #3, #3, pcm_be
        nop()
        nop()
        alu s3, s2, s3, #ASR    ; little-endian: hi = second byte
        alu s3, s3, s4, #OP_ADD
        jmp #ALWAYS, #0, pcm_put
        nop()
        nop()
pcm_be: alu s4, s2, s4, #ASR    ; big-endian: hi = first byte
        alu s3, s4, s3, #OP_ADD
pcm_put:
        x17.sty e7, #3, #0
        x18.eagu e7, e7, #AGU_INC
        alu s1, s1, s14, #OP_SUB
        jmp #ALWAYS, #0, pcm_loop
        nop()
        nop()
pcm_done:
        alu s7, s5, s0, #OP_ADD ; length in words
        ring_publish(PCM_OSL)
}
