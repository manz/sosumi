; Audited from x17 116d9e1 examples/lib/unmix.sm, 2026-11-08 (docs/x17-import.md).
; Twin: ref/dsp/alac/decoder.zig (the unmix and low-byte loop); Apple ALAC matrix_dec.c (Apache 2.0), unmix16.
; ALAC's stereo unmix and shifted low bytes: the twin of the output loop in
; ref/dsp/alac/decoder.zig. Needs lib/bits.sm, lib/rice.sm and lib/predictor.sm first.
;
; Arrays (24-bit X words, walked upward):
;   A2   lane 0 (u)              A3   lane 1 (v), pairs only
;   A4   low bytes, lane-interleaved, when shifted != 0
;   A7   output, lane-interleaved; `gap` words are skipped after each frame (nch > lanes)
;
; Y slots (unmix_slots(base), which remaps e1..e4 and e7..e10; call each stage's slots
; macro before that stage):
;   e1  Y:base+0  n
;   e12 Y:base+1  mix_bits (0..31)
;   e3  Y:base+2  mix_res as its 8 bits (0..255; read back signed)
;   e4  Y:base+3  shifted: 0, 8 or 16
;   e7  Y:base+4  depth (8..24)
;   e8  Y:base+5  lanes: 1 or 2
;   e9  Y:base+6  scratch: samples left
;   e10 Y:base+7  gap
;
; For a pair with mix_res != 0: l = u + v - floor(mix_res * v / 2^mix_bits), r = l - v,
; the product exact (mulWide). Then x = (x << shifted) + low, sign-extended from depth.

.macro unmix_slots(base) {
        ldi s5, #base - 1
        x17.mve e1, s5
        ldi s5, #base
        x17.mve e12, s5
        ldi s5, #base + 1
        x17.mve e3, s5
        ldi s5, #base + 2
        x17.mve e4, s5
        ldi s5, #base + 3
        x17.mve e7, s5
        ldi s5, #base + 4
        x17.mve e8, s5
        ldi s5, #base + 5
        x17.mve e9, s5
        ldi s5, #base + 6
        x17.mve e10, s5
}

; s4 = floor(a * v / 2^s) modulo 2^24, a = mix_res (signed 8), v in s8, s = mix_bits.
; Uses s1, s2, s3, s5, s6, s11, s12.
.macro mulshr() {
        ldy s1, e3
        ldi s3, #128
        alu s12, s1, s3, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; below 128: positive
        jmp #3, #3, apos
        ldi s3, #256            ; (delay slot)
        nop()
        alu s1, s1, s3, #OP_SUB ; a -= 256
apos:   alu s2, s8, s0, #OP_ADD
        x02.x3 #0, #0, s0, s0, #5, #0, s0, #1, s5 ; s5 = (2av) mod 2^24 (x17 reference.md x02 mode 5 second multiply)
        ldi s3, #0x7FFF
        alu s3, s3, s3, #OP_ADD
        alu s3, s3, s14, #OP_ADD
        x18.and s5, s5, s3      ; (2av)[15:0]
        ldi s3, #8
        x19.alu s3, s1, s3, #SHIFT
        x02.mpy s4, s3, s2      ; round((a << 8) * v / 2^23)
        alu s3, s0, s14, #OP_SUB
        x19.alu s5, s5, s3, #SHIFT ; lo
        floorshr(s3, s5, 14)
        alu s4, s4, s3, #OP_SUB ; hi
        ldy s3, e12
        ldi s11, #15
        alu s11, s11, s3, #OP_SUB ; 15 - s
        alu s12, s11, s0, #OP_ADD
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, big
        nop()
        nop()
        ldi s13, #9             ; s <= 15: hi << (15 - s) + floor(lo / 2^s), hi
        alu s13, s13, s3, #OP_ADD ; wrapped to 9 + s bits first so the shift stays in 24
        sxr(s4, s13)
        x19.alu s4, s4, s11, #SHIFT
        floorn(s12, s5, s3)
        alu s4, s4, s12, #OP_ADD
        jmp #ALWAYS, #0, done
        nop()
        nop()
big:    alu s11, s0, s11, #OP_SUB ; s > 15: floor(hi / 2^(s - 15))
        floorn(s12, s4, s11)
        alu s4, s12, s0, #OP_ADD
done:
}

; One output word from x: low bytes on, sign-extended from depth, stored. Uses s3, s6, s12,
; s13. With low bytes, x is sign-extended from depth - shifted first, so x << shifted fits
; in depth bits (no saturation) and adding the low byte cannot carry out of them.
.macro emit(x) {
        ldy s3, e4
        alu s12, s3, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; shifted == 0
        jmp #3, #3, plain
        ldy s13, e7             ; (delay slot) depth
        nop()
        alu s13, s13, s3, #OP_SUB
        sxr(x, s13)
        x19.alu x, x, s3, #SHIFT
        x19.xrd s3, #4
        x02.ainc #4, #4
        alu x, x, s3, #OP_ADD
        jmp #ALWAYS, #0, store
        nop()
        nop()
plain:  sxr(x, s13)
store:  stx A7, x
        x02.ainc #7, #7
}

.macro unmix() {
        ldy s3, e1
        x17.sty e9, #3, #0      ; left = n
frame:  ldy s3, e9
        alu s12, s3, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, finish
        alu s3, s3, s14, #OP_SUB ; (delay slot)
        x17.sty e9, #3, #0      ; (delay slot) left -= 1
        x19.xrd s7, #2          ; u
        x02.ainc #2, #2
        ldy s3, e8
        alu s12, s3, s14, #OP_SUB
        alu s12, s12, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; one lane
        jmp #3, #3, mono
        nop()
        nop()
        x19.xrd s8, #3          ; v
        x02.ainc #3, #3
        ldy s3, e3
        alu s12, s3, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; mix_res == 0
        jmp #3, #3, lanes
        nop()
        nop()
        mulshr()
        alu s7, s7, s8, #OP_ADD
        alu s7, s7, s4, #OP_SUB ; l = u + v - floor(a * v / 2^s)
        alu s8, s7, s8, #OP_SUB ; r = l - v
lanes:  emit(s7)
        emit(s8)
        jmp #ALWAYS, #0, gap
        nop()
        nop()
mono:   emit(s7)
gap:    ldy s3, e10
skip:   alu s12, s3, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, frame
        nop()
        nop()
        x02.ainc #7, #7
        alu s3, s3, s14, #OP_SUB
        jmp #ALWAYS, #0, skip
        nop()
        nop()
finish:
}

; unmix_y: unmix with 16-bit output to Y:[e11] instead of X:[A7], for depth <= 16 and
; shifted = 0 (the caller refuses the rest). The sample is sign-extended from depth, so its
; low 16 bits are the sample. Gap words are skipped in Y. Uses e11 (the output pointer, set
; with x17.mve e11 to the first address - 1) and emit's registers. One lane reads u from
; X:[A2]; a pair reads u from Y:[e13] (16-bit words, sign-extended) and v from X:[A3], so a
; frame needs only one lane in X.
.macro emit_y(x) {
        ldy s13, e7             ; depth
        sxr(x, s13)
        alu s3, x, s0, #OP_ADD
        x17.styi e11, #3, #0, e11
}

; emit_y at depth 16: the store keeps the low 16 bits, which sign extension from 16 leaves
; alone.
.macro emit_y16(x) {
        alu s3, x, s0, #OP_ADD
        x17.styi e11, #3, #0, e11
}

.macro unmix_y() {
        ldy s3, e1
        x17.sty e9, #3, #0      ; left = n
frame:  ldy s3, e9
        alu s12, s3, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, finish
        alu s3, s3, s14, #OP_SUB ; (delay slot)
        x17.sty e9, #3, #0      ; (delay slot) left -= 1
        ldy s3, e8
        alu s12, s3, s14, #OP_SUB
        alu s12, s12, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; one lane
        jmp #3, #3, mono
        nop()
        nop()
        ldy s7, e13             ; u
        x18.eagu e13, e13, #AGU_INC
        x19.xrd s8, #3          ; v
        x02.ainc #3, #3
        ldy s3, e3
        alu s12, s3, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; mix_res == 0
        jmp #3, #3, lanes
        nop()
        nop()
        mulshr()
        alu s7, s7, s8, #OP_ADD
        alu s7, s7, s4, #OP_SUB ; l = u + v - floor(a * v / 2^s)
        alu s8, s7, s8, #OP_SUB ; r = l - v
lanes:  emit_y(s7)
        emit_y(s8)
        jmp #ALWAYS, #0, gap
        nop()
        nop()
mono:   x19.xrd s7, #2          ; u
        x02.ainc #2, #2
        emit_y(s7)
gap:    ldy s3, e10
skip:   alu s12, s3, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, frame
        nop()
        nop()
        x18.eagu e11, e11, #AGU_INC
        alu s3, s3, s14, #OP_SUB
        jmp #ALWAYS, #0, skip
        nop()
        nop()
finish:
}

; unmix_y for depth 16 (emit_y16). A pair with no gap takes a loop of its own: only the low
; 16 bits of l and r are stored, so floor(a v / 2^s) is needed only modulo 2^16, i.e. bits
; s .. s + 15 of a v (mix_res = 0 stores u and v as they are: ipair). With s <= 7, x02.x3's 2 a v mod 2^24 holds bits 0 .. 22 of a v
; exactly, and one arithmetic shift by s + 1 (alu code 6, fact 774) gives them (fpair). With
; s >= 8, a << (24 - s) fits in 24 bits and x18.mpy's high product of it and v is
; floor(a v / 2^s) itself (wpair); v has 17 bits at depth 16, so |a v| <= 2^23 and every
; s >= 24 floors to the sign alone, as s = 24 does. The loops run while A3 (v) != R4 = A3 + n. Also uses s1,
; s2, s5, s6, e6, R4, R7.
.macro unmix_y16() {
        ldy s3, e8
        ldi s4, #2
        alu s4, s3, s4, #OP_SUB
        ptst p3, s0, #EQ4, #PTST ; a pair
        jmp #IF_NOT, #3, gen
        ldy s4, e10             ; (delay slot) gap
        ldy s1, e3              ; (delay slot) a's 8 bits
        ptst p3, s0, #EQ4, #PTST ; no gap
        jmp #IF_NOT, #3, gen
        ldy s13, e1             ; (delay slot) n
        ldi s12, #-2            ; (delay slot)
        alu s13, s12, s13, #OP_SUB
        x17.mve e6, s13         ; e6 = -n - 1 (x17.mve adds 1)
        x19.a3 s0, R7, e6, #25, #2, #0 ; R7 = -n
        ragu R4, A3, R7, #29    ; A3 + n
        ldi s4, #-16
        alu s1, s4, s1, #ASR    ; << 16, wrapping
        ldi s4, #16
        alu s1, s4, s1, #ASR    ; a, sign-extended from 8 bits
        alu s4, s1, s0, #OP_ADD
        ptst p3, s0, #EQ4, #PTST ; mix_res == 0: l = u, r = v (ipair)
        jmp #3, #3, ipair
        ldy s3, e12             ; (delay slot) s = mix_bits
        ldi s4, #7              ; (delay slot)
        alu s4, s4, s3, #OP_SUB
        ptst p3, s0, #LT4, #PTST ; s > 7
        jmp #IF_NOT, #3, fpair
        alu s6, s3, s14, #OP_ADD ; (delay slot) s + 1
        ldi s4, #24             ; (delay slot)
        alu s4, s3, s4, #OP_SUB ; s - 24
        x18.min s4, s4, s0      ; min(s, 24) - 24 (fact 951)
        alu s1, s4, s1, #ASR    ; a << (24 - min(s, 24)): |a| <= 2^7, so it fits for s >= 8
wpair:  pcond p3, R4, A3, #30   ; more: A3 != R4
        jmp #IF_NOT, #3, finish
        ldy s7, e13             ; (delay slot) u
        x18.eagu e13, e13, #AGU_INC ; (delay slot)
        x19.xrd s8, #3          ; v
        x02.ainc #3, #3
        x18.mpy s0, s5, s1, s8  ; floor(a v / 2^s), the high product (x17 reference.md x18.mpy)
        alu s7, s7, s8, #OP_ADD
        alu s7, s7, s5, #OP_SUB ; l
        alu s8, s7, s8, #OP_SUB ; r = l - v
        x17.styi e11, #7, #0, e11
        jmp #ALWAYS, #0, wpair
        alu s3, s8, s0, #OP_ADD ; (delay slot)
        x17.styi e11, #3, #0, e11 ; (delay slot)
ipair:  pcond p3, R4, A3, #30   ; more: A3 != R4
        jmp #IF_NOT, #3, finish
        ldy s3, e13             ; (delay slot) u
        x18.eagu e13, e13, #AGU_INC ; (delay slot)
        x19.xrd s8, #3          ; v
        x02.ainc #3, #3
        x17.styi e11, #3, #0, e11
        jmp #ALWAYS, #0, ipair
        alu s3, s8, s0, #OP_ADD ; (delay slot)
        x17.styi e11, #3, #0, e11 ; (delay slot)
fpair:  pcond p3, R4, A3, #30   ; more: A3 != R4
        jmp #IF_NOT, #3, finish
        ldy s7, e13             ; (delay slot) u
        x18.eagu e13, e13, #AGU_INC ; (delay slot)
        x19.xrd s8, #3          ; v
        x02.ainc #3, #3         ; (writes s2)
        alu s2, s8, s0, #OP_ADD
        x02.x3 #0, #0, s0, s0, #5, #0, s0, #1, s5 ; s5 = 2 a v mod 2^24 (as mulshr)
        alu s5, s6, s5, #ASR    ; floor(a v / 2^s), its low 16 bits
        alu s7, s7, s8, #OP_ADD
        alu s7, s7, s5, #OP_SUB ; l
        alu s8, s7, s8, #OP_SUB ; r = l - v
        x17.styi e11, #7, #0, e11
        jmp #ALWAYS, #0, fpair
        alu s3, s8, s0, #OP_ADD ; (delay slot)
        x17.styi e11, #3, #0, e11 ; (delay slot)
gen:    ldy s3, e1
        x17.sty e9, #3, #0      ; left = n
frame:  ldy s3, e9
        alu s12, s3, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, finish
        alu s3, s3, s14, #OP_SUB ; (delay slot)
        x17.sty e9, #3, #0      ; (delay slot) left -= 1
        ldy s3, e8
        alu s12, s3, s14, #OP_SUB
        alu s12, s12, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; one lane
        jmp #3, #3, mono
        nop()
        nop()
        ldy s7, e13             ; u
        x18.eagu e13, e13, #AGU_INC
        x19.xrd s8, #3          ; v
        x02.ainc #3, #3
        ldy s3, e3
        alu s12, s3, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; mix_res == 0
        jmp #3, #3, lanes
        nop()
        nop()
        mulshr()
        alu s7, s7, s8, #OP_ADD
        alu s7, s7, s4, #OP_SUB ; l = u + v - floor(a * v / 2^s)
        alu s8, s7, s8, #OP_SUB ; r = l - v
lanes:  emit_y16(s7)
        emit_y16(s8)
        jmp #ALWAYS, #0, gap
        nop()
        nop()
mono:   x19.xrd s7, #2          ; u
        x02.ainc #2, #2
        emit_y16(s7)
gap:    ldy s3, e10
skip:   alu s12, s3, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, frame
        nop()
        nop()
        x18.eagu e11, e11, #AGU_INC
        alu s3, s3, s14, #OP_SUB
        jmp #ALWAYS, #0, skip
        nop()
        nop()
finish:
}
