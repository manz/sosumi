; Audited from x17 b95e52f examples/lib/predictor.sm, 2026-11-08 (docs/x17-import.md).
; Twin: ref/dsp/alac/predictor.zig; Apple ALAC dp_dec.c (Apache 2.0), unpc_block.
; ALAC's adaptive predictor: the twin of `unpredict` in ref/dsp/alac/predictor.zig.
; Needs lib/bits.sm (constants, nop, s14 = 1) and lib/rice.sm (floorshr) first.
;
; Arrays are 24-bit X words walked upward through A registers:
;   A2   residuals pc[0..n)           (read)
;   A3   samples out[0..n)            (written)
;   A10  coefficients, REVERSED: X:[A10 + i] = coefs[order - 1 - i], adapted in place, then
;        zeros from i = order to 35
; Walking the coefficients reversed lets every access ascend: the sum over k does not
; care about order, and the adaptation visits k = order - 1 down to 0, i.e. i upward.
; A4, A7, A8, A9, A11 are scratch. A1 is avoided: every x02 bundle runs its A slot, and the
; multiply templates name A1 there, so each x02.mpy / x02.x3 also does A1 += 1 (own-x02mpy-a1).
;
; Y slots (pred_slots(base)), filled by the caller:
;   e11 Y:base+0  n
;   e12 Y:base+1  order (0..31)
;   e13 Y:base+2  den_shift (0..15)
;   e14 Y:base+3  chan_bits (8..23, with den_shift + chan_bits <= 32, chan_bits <= 18 + den_shift)
;   e15 Y:base+4  scratch: samples left
;
; Keeps the bit reader (e5, s9, s10) and s14, s15. Uses every other s register; unpredict
; parks s9 and s10 at X:[A10 + 40], +41 (past the coefficients and their zeros up to +35; Y
; is 16 bits, the cache is not), and keeps two constants at +42, +43 through A12, A13 to free them for the tap and the adaptation, through A5. It also writes R6, R7, e6
; and p3.
; Left shifts by a runtime count that must wrap go through sxr first, so the 0x19 shift
; (which saturates) never overflows.

.macro pred_slots(base) {
        ldi s5, #base - 1
        x17.mve e11, s5
        ldi s5, #base
        x17.mve e12, s5
        ldi s5, #base + 1
        x17.mve e13, s5
        ldi s5, #base + 2
        x17.mve e14, s5
        ldi s5, #base + 3
        x17.mve e15, s5
}

; x = x sign-extended from its low k bits, k (8..24) in register `k` (left at k - 1).
; Uses s12. q = rshr(x, k) = round(x / 2^k), half up; x - q * 2^k is then in
; [-2^(k-1), 2^(k-1)) and congruent to x. q * 2^k goes in two halves of at most 2^22 each,
; so the 0x19 shift never saturates (q reaches 2^(23-k)). k = 24 gives q = 0.
.macro sxr(x, k) {
        alu s12, s0, k, #OP_SUB ; -k
        x19.alu s12, x, s12, #SHIFT ; q
        alu k, k, s14, #OP_SUB  ; k - 1
        x19.alu s12, s12, k, #SHIFT ; q * 2^(k-1)
        alu x, x, s12, #OP_SUB
        alu x, x, s12, #OP_SUB
}

; sxr with k from the Y slot `slot`. Uses s12, s13.
.macro sxe(x, slot) {
        ldy s13, slot
        sxr(x, s13)
}

; sxe from chan_bits.
.macro sxcb(x) {
        sxe(x, e14)
}

; dst = floor(v / 2^n), n (0..15) in a register: rshr(v - h, n), h = rshr(2^n - 1, 1).
; v must leave room for the subtraction (|v| < 2^23 - 2^14). Uses s6.
.macro floorn(dst, v, n) {
        x19.alu s6, s14, n, #SHIFT ; 2^n
        alu s6, s6, s14, #OP_SUB
        alu dst, s0, s14, #OP_SUB ; -1 (dst is free until the end)
        x19.alu s6, s6, dst, #SHIFT ; h
        alu dst, v, s6, #OP_SUB
        alu s6, s0, n, #OP_SUB
        x19.alu dst, dst, s6, #SHIFT
}

; buf[j] = buf[j] + buf[j - 1] sign-extended from chan_bits, in place over X:[A2..A2+n)
; (mode != 0, the twin of `predictor.integrate`). Reads the pred_slots n and chan_bits; leaves
; A2 past the buffer. Uses s1, s3, s4, s6, s12, s13; counts in s1 (x02.ainc writes s2).
.macro integrate() {
        ldy s1, e11
        alu s4, s1, s14, #OP_SUB
        ptst p3, s0, #LT4, #PTST ; n == 0
        jmp #3, #3, done
        nop()
        nop()
        x19.xrd s4, #2          ; prev = buf[0]
        x02.ainc #2, #2
        alu s1, s1, s14, #OP_SUB
next:   alu s12, s1, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, done
        nop()
        nop()
        x19.xrd s3, #2
        alu s3, s3, s4, #OP_ADD
        sxcb(s3)
        stx A2, s3
        x02.ainc #2, #2
        alu s4, s3, s0, #OP_ADD
        alu s1, s1, s14, #OP_SUB
        jmp #ALWAYS, #0, next
        nop()
        nop()
done:
}

; The adaptation's registers: A9 = out[j - order], A11 = the reversed coefficients,
; s8 = order steps, s9 = h = rshr(2^ds - 1, 1), s10 = -ds (floor(v / 2^ds) = rshr(v - h, ds)),
; both from X:[A12], X:[A13] (the window computes them once), s6 = 2^15 - 1, s5 = w = 1,
; s3 = the first out. Uses s2.
; D (set before, in s4) is tested directly: s4 <= 0.
.macro adapt_init() {
        x19.aagu A9, A7, #5, #0
        x19.aagu A11, A10, #5, #0
        ldy s8, e12
        x19.xrd s9, #12         ; h (window)
        x19.xrd s10, #13        ; -ds (window)
        ldi s6, #0x7FFF
        alu s5, s14, s0, #OP_ADD ; w = 1
        x19.xrd s3, #9
        x02.ainc #9, #9
}

.macro unpredict() {
        x03.agu A5, A10, #40, #0, A0 ; park the bit reader
        stx A5, s9
        x02.ainc #5, #5
        stx A5, s10
        ldy s7, e11
        alu s12, s7, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; n == 0
        jmp #3, #3, finish
        x19.aagu A4, A3, #5, #0 ; (delay slot) A4 = out base
        nop()
        x19.xrd s1, #2          ; out[0] = pc[0]
        x02.ainc #2, #2
        stx A3, s1
        x02.ainc #3, #3
        alu s7, s7, s14, #OP_SUB ; left = n - 1
        ldy s8, e12             ; warm-up count = order
        ; out[j] = sx(pc[j] + out[j - 1]) for j = 1 .. min(order, n - 1)
warm:   alu s12, s7, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; nothing left
        jmp #3, #3, finish
        nop()
        nop()
        ptst p3, s0, #LE8, #PTST ; warm-up done
        jmp #3, #3, main
        nop()
        nop()
        x19.xrd s3, #2
        x02.ainc #2, #2
        alu s1, s3, s1, #OP_ADD
        sxcb(s1)
        stx A3, s1
        x02.ainc #3, #3
        alu s7, s7, s14, #OP_SUB
        alu s8, s8, s14, #OP_SUB
        jmp #ALWAYS, #0, warm
        nop()
        nop()
        ; order == 0 lands here with j = 1 and copies (the sum below is empty, so
        ; out[j] = sx(pc[j] + top); handled apart to match the reference's plain copy)
main:   x17.sty e15, #7, #0     ; left
        ldy s8, e12
        ptst p3, s0, #LE8, #PTST ; order == 0
        jmp #IF_NOT, #3, window
        nop()
        nop()
copy:   ldy s7, e15
        alu s12, s7, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, finish
        nop()
        nop()
        x19.xrd s1, #2
        x02.ainc #2, #2
        stx A3, s1
        x02.ainc #3, #3
        alu s7, s7, s14, #OP_SUB
        x17.sty e15, #7, #0
        jmp #ALWAYS, #0, copy
        nop()
        nop()
window: x19.aagu A8, A4, #5, #0 ; top: out[j - order - 1]
        x19.aagu A7, A4, #5, #0
        x02.ainc #7, #7         ; history: out[j - order]
        ; R6 = A10 + M, M = order rounded up to 4: the taps run in fours over the coefficients,
        ; zero from order to +35 (alac.sm zeroes the lane's 36 words before copying them in)
        ldy s13, e12
        ldi s12, #3
        alu s13, s13, s12, #OP_ADD
        ldi s12, #-4
        x18.and s13, s13, s12   ; M
        ldi s12, #2
        alu s13, s0, s13, #OP_SUB
        alu s13, s13, s12, #OP_SUB
        x17.mve e6, s13         ; e6 = -M - 1
        x19.a3 s0, R7, e6, #25, #2, #0 ; R7 = -M
        ragu R6, A10, R7, #29   ; A10 - R7
        ; the adaptation's h = rshr(2^ds - 1, 1) and -ds, once: X:[A10 + 42], +43
        x03.agu A12, A10, #42, #0, A0
        x03.agu A13, A10, #43, #0, A0
        ldy s2, e13
        x19.alu s9, s14, s2, #SHIFT ; 2^ds
        alu s10, s0, s2, #OP_SUB ; -ds
        alu s9, s9, s14, #OP_SUB
        alu s2, s0, s14, #OP_SUB
        x19.alu s9, s9, s2, #SHIFT ; h
        stx A12, s9
        stx A13, s10
sample: ldy s7, e15
        alu s12, s7, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, finish
        x19.xrd s7, #8          ; (delay slot) top; finish ignores s7 and A9
        x19.aagu A9, A7, #5, #0 ; (delay slot)
        ; sum = sum_k c_k (out[j - 1 - k] - top) = sum_k c_k out[j - 1 - k] - top sum_k c_k, on
        ; x03.tap's exact running sum {s2:s3} += 2 a b, 24 x 24 into 48 bits (x17 reference.md
        ; x03.tap, 672, 701). A tap multiplies the value the bundle before loaded, then loads
        ; the next: the history taps load out[] through A9 against a coefficient register; the
        ; coefficient loads (A11) multiply the register's old coefficient by -top as they
        ; replace it, so every c_k meets -top once. The first two loads multiply by s0, the
        ; first L2, L3 a zeroed s8, s9; the padding's zeros end the chain.
        x19.aagu A11, A10, #5, #0
        alu s4, s0, s7, #OP_SUB ; -top
        ldi s8, #0
        ldi s9, #0
        x03.tap0 s1, #9, s0, s2, s3 ; {s2:s3} = 0 (mode 4: 2 s1 s0, old sum ignored, 702); s1 = out[j - order]
        x03.tap s5, #11, s0, s2, s3
        x03.tap s6, #11, s0, s2, s3
ptap:   x03.tap s8, #11, s4, s2, s3
        x03.tap s9, #11, s4, s2, s3
        x03.tap s1, #9, s5, s2, s3
        x03.tap s1, #9, s6, s2, s3
        x03.tap s1, #9, s8, s2, s3
        x03.tap s1, #9, s9, s2, s3
        pcond p3, R6, A11, #30  ; four more: A11 != R6
        jmp #3, #3, ptap
        x03.tap s5, #11, s4, s2, s3 ; (delay slot)
        x03.tap s6, #11, s4, s2, s3 ; (delay slot)
        x03.tap s8, #11, s4, s2, s3
        x03.tap s9, #11, s4, s2, s3
        ; acc = 2 sum = hi 2^24 + lo (lo's 24 bits unsigned, L = lo read signed). ALAC's
        ; pred = floor((sum + 2^(ds-1)) / 2^ds) = rshr(acc, ds + 1), the shifter's half-up
        ; right shift; with H = hi + [L < 0], rshr(acc, ds + 1) = H 2^(23-ds) + rshr(L, ds + 1),
        ; and only its low chan_bits <= 23 bits count: (H mod 2^ds) << (23 - ds) stays in 23.
        alu s12, s3, s0, #OP_ADD
        ptst p3, s0, #LT12, #PTST ; L < 0
        jmp #IF_NOT, #3, hpos
        ldy s10, e13            ; (delay slot) ds
        ldi s11, #-1            ; (delay slot)
        alu s2, s2, s14, #OP_ADD
hpos:   alu s11, s11, s10, #OP_SUB ; -(ds + 1)
        x19.alu s13, s14, s10, #SHIFT ; 2^ds
        alu s13, s13, s14, #OP_SUB
        ldi s12, #23
        alu s12, s12, s10, #OP_SUB ; 23 - ds
        x18.and s2, s2, s13     ; H mod 2^ds
        x19.alu s2, s2, s12, #SHIFT
        x19.alu s3, s3, s11, #SHIFT ; rshr(L, ds + 1)
        alu s4, s2, s3, #OP_ADD ; pred
        x19.xrd s1, #2          ; res
        x02.ainc #2, #2
        alu s3, s1, s7, #OP_ADD
        alu s3, s3, s4, #OP_ADD
        sxcb(s3)
        stx A3, s3              ; out[j]
        x02.ainc #3, #3
        ldy s5, e15
        alu s5, s5, s14, #OP_SUB
        x17.sty e15, #5, #0     ; left -= 1
        alu s12, s1, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; res <= 0
        jmp #IF_NOT, #3, adp    ; res > 0
        alu s4, s1, s0, #OP_ADD ; (delay slot) D = res
        alu s12, s1, s0, #OP_ADD ; (delay slot)
        ptst p3, s0, #LT12, #PTST ; res < 0
        jmp #3, #3, adn
        alu s4, s0, s1, #OP_SUB ; (delay slot) D = -res
        nop()
        jmp #ALWAYS, #0, sample ; res == 0: no adaptation
        x02.ainc #7, #7         ; (delay slot) advance
        x02.ainc #8, #8         ; (delay slot)
        ; adaptation: i = 0 .. order - 1 (k = order - 1 - i), weight w = i + 1, one loop per
        ; sign of res. With D = +-del0 both stop at D <= 0:
        ;   res > 0: dd > 0: c -= 1, D -= w * floor(dd / 2^ds); dd < 0: c += 1, -dd instead
        ;   res < 0: dd > 0: c += 1, D += w * floor(-dd / 2^ds); dd < 0: c -= 1, dd instead
        ; Only the direction c moved can leave 16 bits, so each branch tests that one.
adp:    adapt_init()
pstep:  alu s3, s7, s3, #OP_SUB ; dd = top - out
        alu s12, s0, s3, #OP_SUB ; -dd
        ptst p3, s0, #LE12, #PTST ; dd >= 0
        jmp #IF_NOT, #3, pneg
        x19.xrd s13, #11        ; (delay slot) c
        alu s2, s3, s9, #OP_SUB ; (delay slot) dd - h
        ptst p3, s0, #LT12, #PTST ; dd > 0
        jmp #IF_NOT, #3, pput   ; dd == 0: m = 0, c kept
        x19.alu s3, s2, s10, #SHIFT ; (delay slot) m = floor(dd / 2^ds)
        nop()
        alu s13, s13, s14, #OP_SUB ; c -= 1
        alu s12, s13, s6, #OP_ADD
        alu s12, s12, s14, #OP_ADD ; c + 2^15 < 0: c = 2^15 - 1
        ptst p3, s0, #LT12, #PTST
        jmp #IF_NOT, #3, pput
        nop()
        nop()
        alu s13, s6, s0, #OP_ADD
pput:   stx A11, s13
        x02.ainc #11, #11       ; (overwrites s2)
        x18.mpy s12, s0, s5, s3 ; w m, |w m| < 2^23 (x17 reference.md x18.mpy, low product)
        alu s4, s4, s12, #OP_SUB
        alu s5, s5, s14, #OP_ADD ; w += 1
        alu s8, s8, s14, #OP_SUB
        ptst p3, s0, #LE4, #PTST ; D <= 0: stop
        jmp #3, #3, adone
        x19.xrd s3, #9          ; (delay slot) next out
        x02.ainc #9, #9         ; (delay slot)
        ptst p3, s0, #LE8, #PTST ; every coefficient visited
        jmp #IF_NOT, #3, pstep
        nop()
        nop()
        jmp #ALWAYS, #0, sample
        x02.ainc #7, #7         ; (delay slot) advance
        x02.ainc #8, #8         ; (delay slot)
pneg:   alu s12, s12, s9, #OP_SUB
        x19.alu s3, s12, s10, #SHIFT ; m = floor(-dd / 2^ds)
        alu s13, s13, s14, #OP_ADD ; c += 1
        alu s12, s6, s13, #OP_SUB ; 2^15 - 1 - c < 0: c = -2^15
        ptst p3, s0, #LT12, #PTST
        jmp #IF_NOT, #3, pput
        nop()
        nop()
        alu s13, s0, s6, #OP_SUB
        alu s13, s13, s14, #OP_SUB
        jmp #ALWAYS, #0, pput
        nop()
        nop()
adn:    adapt_init()
nstep:  alu s3, s7, s3, #OP_SUB ; dd = top - out
        alu s12, s0, s3, #OP_SUB ; -dd
        ptst p3, s0, #LE12, #PTST ; dd >= 0
        jmp #IF_NOT, #3, nneg
        x19.xrd s13, #11        ; (delay slot) c
        alu s2, s12, s9, #OP_SUB ; (delay slot) -dd - h
        ptst p3, s0, #LT12, #PTST ; dd > 0
        jmp #IF_NOT, #3, nput   ; dd == 0: m = 0, c kept
        x19.alu s3, s2, s10, #SHIFT ; (delay slot) m = floor(-dd / 2^ds)
        nop()
        alu s13, s13, s14, #OP_ADD ; c += 1
        alu s12, s6, s13, #OP_SUB ; 2^15 - 1 - c < 0: c = -2^15
        ptst p3, s0, #LT12, #PTST
        jmp #IF_NOT, #3, nput
        nop()
        nop()
        alu s13, s0, s6, #OP_SUB
        alu s13, s13, s14, #OP_SUB
nput:   stx A11, s13
        x02.ainc #11, #11       ; (overwrites s2)
        x18.mpy s12, s0, s5, s3 ; w m (m <= 0 here: the low product mod 2^24)
        alu s4, s4, s12, #OP_ADD
        alu s5, s5, s14, #OP_ADD ; w += 1
        alu s8, s8, s14, #OP_SUB
        ptst p3, s0, #LE4, #PTST ; D <= 0: stop
        jmp #3, #3, adone
        x19.xrd s3, #9          ; (delay slot) next out
        x02.ainc #9, #9         ; (delay slot)
        ptst p3, s0, #LE8, #PTST ; every coefficient visited
        jmp #IF_NOT, #3, nstep
        nop()
        nop()
        jmp #ALWAYS, #0, sample
        x02.ainc #7, #7         ; (delay slot) advance
        x02.ainc #8, #8         ; (delay slot)
nneg:   alu s12, s3, s9, #OP_SUB
        x19.alu s3, s12, s10, #SHIFT ; m = floor(dd / 2^ds)
        alu s13, s13, s14, #OP_SUB ; c -= 1
        alu s12, s13, s6, #OP_ADD
        alu s12, s12, s14, #OP_ADD ; c + 2^15 < 0: c = 2^15 - 1
        ptst p3, s0, #LT12, #PTST
        jmp #IF_NOT, #3, nput
        nop()
        nop()
        alu s13, s6, s0, #OP_ADD
        jmp #ALWAYS, #0, nput
        nop()
        nop()
adone:
advance: jmp #ALWAYS, #0, sample
        x02.ainc #7, #7         ; (delay slot)
        x02.ainc #8, #8         ; (delay slot)
finish: x03.agu A5, A10, #40, #0, A0 ; the bit reader back
        x19.xrd s9, #5
        x02.ainc #5, #5
        x19.xrd s10, #5
}
