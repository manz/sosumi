        x03.tapa s4, #8, s0, s2, s3, #2, R3 ; D7
        x03.tapa s5, #9, s4, s2, s3, #2, R4 ; + 2 V7 D7; V8
        x03.tapa s4, #8, s0, s2, s3, #2, R3 ; D8
        x03.tapa s5, #10, s4, s2, s3, #2, R4 ; + 2 V8 D8; V9
        x03.tapa s4, #8, s0, s2, s3, #2, R3 ; D9
        x03.tapa s5, #9, s4, s2, s3, #2, R4 ; + 2 V9 D9; V10
        x03.tapa s4, #8, s0, s2, s3, #2, R3 ; D10
        x03.tapa s5, #10, s4, s2, s3, #2, R4 ; + 2 V10 D10; V11
        x03.tapa s4, #8, s0, s2, s3, #2, R3 ; D11
        x03.tapa s5, #9, s4, s2, s3, #2, R4 ; + 2 V11 D11; V12
        x03.tapa s4, #8, s0, s2, s3, #2, R3 ; D12
        x03.tapa s5, #10, s4, s2, s3, #2, R4 ; + 2 V12 D12; V13
        x03.tapa s4, #8, s0, s2, s3, #2, R3 ; D13
        x03.tapa s5, #9, s4, s2, s3, #3, R2 ; + 2 V13 D13; V14
        x03.tapa s4, #8, s0, s2, s3, #2, R3 ; D14
        x03.tapa s5, #10, s4, s2, s3, #3, R2 ; + 2 V14 D14; V15
        x03.tapa s4, #8, s0, s2, s3, #3, R1 ; D15
        x03.tap s4, #8, s5, s2, s3 ; + 2 D15 V15; pair 1's first D
        alu s13, s7, s3, #ASR   ; -1 when lo < 0 (mp3_rd24)
        alu s1, s2, s13, #OP_SUB
}

; Samples j and 32 - j, j = 1..15 (twin `slot`'s window): each V word read once into s5 (A9 / A10
; as mp3_win16), two taps by D's paired table (X:MP_XD, dsp/mp3/tables.zig: per age,
; d[j], then -+d[32 - j], the sign of V[32 - j] against V[j] folded in), the D stream
; stepping 31 then 1 (R5; the last block steps back by R1 = 479). Samples to Y at e7 (+ nch,
; R7) and e6 (- nch, R6), saturated by s8 / s9. s4 holds the first D on entry and sample
; 16's on exit (one column short: A8 + 31). Uses s1..s13, p3.
.macro mp3_wpair() {
        ldi s12, #15
yp:     pkf(s5, A9, s0, s0, s0, 12, s12, s14, 5, 0, 2, R4) ; V0; one pair less
        x03.tap0a s4, #8, s5, s2, s3, #2, R5 ; j: 2 V0 D; D'
        x03.tap0 s4, #8, s5, s10, s11 ; 32 - j: 2 V0 D'; the next D
        pkf(s5, A10, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V1
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V1 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V1 D'; the next D
        pkf(s5, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V2
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V2 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V2 D'; the next D
        pkf(s5, A10, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V3
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V3 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V3 D'; the next D
        pkf(s5, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V4
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V4 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V4 D'; the next D
        pkf(s5, A10, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V5
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V5 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V5 D'; the next D
        pkf(s5, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V6
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V6 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V6 D'; the next D
        pkf(s5, A10, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V7
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V7 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V7 D'; the next D
        pkf(s5, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V8
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V8 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V8 D'; the next D
        pkf(s5, A10, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V9
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V9 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V9 D'; the next D
        pkf(s5, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V10
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V10 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V10 D'; the next D
        pkf(s5, A10, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V11
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V11 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V11 D'; the next D
        pkf(s5, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V12
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V12 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V12 D'; the next D
        pkf(s5, A10, s0, s0, s0, 0, s0, s0, 0, 0, 2, R4) ; V13
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V13 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V13 D'; the next D
        pkf(s5, A9, s0, s0, s0, 0, s0, s0, 0, 0, 3, R2) ; V14
        x03.tapa s4, #8, s5, s2, s3, #2, R5 ; j: + 2 V14 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V14 D'; the next D
        pkf(s5, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R2) ; V15
        x03.tapa s4, #8, s5, s2, s3, #3, R1 ; j: + 2 V15 D; D'
        x03.tap s4, #8, s5, s10, s11 ; 32 - j: + 2 V15 D'; the next D
        pk(s0, A0, s0, s0, s0, 6, s7, s3, 0, 6) ; rshr(acc, 24) = hi + [lo < 0] (mp3_rd24)
        pk(s0, A0, s0, s0, s0, 1, s2, s6, 5, 0)
        pk(s0, A0, s0, s0, s0, 13, s7, s11, 0, 6)
        pk(s0, A0, s0, s0, s0, 6, s10, s13, 5, 0)
        x18.max s1, s1, s8
        x18.min s1, s1, s9
        x18.max s6, s6, s8
        ptst p3, s0, #EQ12, #PTST
        x18.min s6, s6, s9
        jmp #IF_NOT, #3, yp
        x17.stys e7, #1, #0, e7, R7 ; (delay slot) sample j, then + nch
        x17.stys e6, #6, #0, e6, R6 ; (delay slot) sample 32 - j, then - nch
}

; Synthesis of channel MP_HCH's granule MP_SGR (see above). Uses s1..s13, A8..A14, R1..R7, e6, e7.
.macro mp3_synth() {
        lde e7, #MH_NCH
        ldy s11, e7
        lde e7, #MP_SGR
        ldy s1, e7
        ldi s12, #576
        x18.mpy s1, s0, s1, s12
        x18.mpy s1, s0, s1, s11
        lde e7, #MP_HCH
        ldy s2, e7
        alu s1, s1, s2, #OP_ADD
        lde e7, #MP_OUT
        ldy s2, e7
        alu s1, s1, s2, #OP_ADD
        alu s1, s1, s14, #OP_SUB
        mp3_put(MP_YO, 1)
        ldi s1, #0
        mp3_put(MP_YT, 1)
yslot:  lde e7, #MP_HCH
        ldy s2, e7
        yidx(s1, MP_YP, s2)
        alu s1, s1, s14, #OP_SUB
        ldi s12, #15
        x18.and s1, s1, s12     ; the new block: p - 1 mod 16
        x17.sty e7, #1, #0
        ldi s12, #1024
        x18.mpy s10, s0, s2, s12
        ldi s12, #32
        x18.mpy s3, s0, s1, s12
        alu s10, s10, s3, #OP_ADD
        ldi s12, #MP_XV
        alu s10, s10, s12, #OP_ADD ; its half 0
        amov(A11, s10)
        ; g1 = s[k] + s[31 - k] (X:MP_XZ + 32), h1 = s[k] - s[31 - k] (+ 0)
        ldi s12, #576
        x18.mpy s3, s0, s2, s12
        lde e7, #MP_YT
        ldy s4, e7
        alu s3, s3, s4, #OP_ADD
        ldi s12, #MP_XS
        alu s3, s3, s12, #OP_ADD
        amov(A9, s3)            ; s[0]
        ldi s12, #558
        alu s3, s3, s12, #OP_ADD
        amov(A10, s3)           ; s[31]
        aimm_e(6, MP_XZ + 32)
        aimm_o(6, MP_XZ)
        rimm R5, #18
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pk(s0, A0, s0, s0, s0, 3, s1, s2, 0, 0) ; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 2, R5) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 3, R5) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pks(4, A13, 0, s0, s0, 0) ; h
        ; g2 = g1[k] + g1[15 - k] (+ 24), h2 = g1[k] - g1[15 - k] (+ 16)
        aimm_o(4, MP_XZ + 32)
        aimm_e(5, MP_XZ + 47)
        aimm_e(6, MP_XZ + 24)
        aimm_o(6, MP_XZ + 16)
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 0, R0) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 1, R0) ; b
        pk(s0, A0, s0, s0, s0, 3, s1, s2, 0, 0) ; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 0, R0) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 1, R0) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 0, R0) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 1, R0) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 0, R0) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 1, R0) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 0, R0) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 1, R0) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 0, R0) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 1, R0) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 0, R0) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 1, R0) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pkf(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0, 0, R0) ; a
        pkf(s2, A10, s0, s0, s0, 0, s0, s0, 0, 0, 1, R0) ; b
        pks(4, A13, 3, s1, s2, 0) ; h; g = a + b
        pks(3, A12, 4, s1, s2, 5) ; g; h = a - b
        pks(4, A13, 0, s0, s0, 0) ; h
        ; the 32 rows: V[r], -V[32 - r] (r = 16 + n < 32), V[33 + i], V[63 - i] (n = 15 - i)
        aimm_e(4, MP_XN)
        pk(s10, A8, s0, s0, s0, 0, s0, s0, 0, 0) ; the first c
        mp3_mgrp16n(0, 1, 31, 2, 2)          ; r = 1, 3, .., 15 (h1)
        mp3_mgrp16p(0, 513, 543, 2, 2)       ; i = 0, 2, .., 14 (h1)
        mp3_mgrp8n(16, 2, 30, 4, 1)          ; r = 2, 6, 10, 14 (h2)
        mp3_mgrp8p(16, 514, 542, 4, 1)       ; i = 1, 5, 9, 13 (h2)
        mp3_mgrp8z(24, 0, 28, 4, 1)          ; r = 0, 4, 8, 12 (g2): V[0], V[32], ..
        mp3_mgrp8p(24, 516, 540, 4, 1)       ; i = 3, 7, 11, 15 (g2)
        rimm R5, #16
        x02.aa A12, A11, R5, #2, A0, A0
        ldi s1, #0
        stx A12, s1             ; V[16] = 0
        ; the window: A9 even blocks' half p & 1, A10 odd blocks' other half, A8 D from (16 - p) mod 16
        lde e7, #MP_HCH
        ldy s2, e7
        yidx(s1, MP_YP, s2)
        ldi s12, #1024
        x18.mpy s2, s0, s2, s12
        ldi s12, #MP_XV
        alu s2, s2, s12, #OP_ADD
        x18.and s3, s1, s14
        ldi s12, #512
        x18.mpy s3, s0, s3, s12
        alu s4, s2, s3, #OP_ADD
        amov(A9, s4)
        alu s4, s2, s12, #OP_ADD
        alu s4, s4, s3, #OP_SUB
        ldi s12, #32
        alu s4, s4, s12, #OP_ADD
        amov(A10, s4)
        alu s1, s0, s1, #OP_SUB
        ldi s12, #15
        x18.and s1, s1, s12
        ldi s12, #32
        x18.mpy s1, s0, s1, s12
        ldi s12, #MP_XD
        alu s1, s1, s12, #OP_ADD
        amov(A8, s1)
        lde e7, #MH_NCH
        ldy s11, e7
        amov_e(3, s11)          ; R7 = A6 path: R7 = nch (A6 unused here)
        rimm R4, #64
        rimm R3, #32
        rimm R2, #447
        rimm R1, #479
        ldi s7, #23
        ldi s9, #32767
        alu s8, s0, s9, #OP_SUB
        alu s8, s8, s14, #OP_SUB ; -32768
        lde e7, #MP_YO
        ldy s10, e7
        x17.mve e7, s10         ; the first sample's address
        rimm R5, #31
        x18.una s0, s0, #1, R6, s11 ; R6 = -nch (x17 own-x18alu011)
        ldi s12, #31
        x18.mpy s13, s0, s11, s12
        alu s13, s13, s10, #OP_ADD
        x17.mve e6, s13         ; sample 31's address
        pkf(s4, A8, s0, s0, s0, 0, s0, s0, 0, 0, 2, R3) ; D0 of sample 0
        mp3_win0()
        x18.max s1, s1, s8
        x18.min s3, s1, s9
        x17.stys e7, #3, #0, e7, R7 ; sample 0, then + nch
        mp3_wpair()
        x02.aa A8, A8, R5, #2, A0, A0 ; sample 16's second D
        mp3_win16()
        x18.max s1, s1, s8
        x18.min s3, s1, s9
        x17.stys e7, #3, #0, e7, R7 ; sample 16
        lde e7, #MH_NCH
        ldy s11, e7
        lde e7, #MP_YO
        ldy s10, e7
        ldi s12, #32
        x18.mpy s12, s0, s11, s12
        alu s10, s10, s12, #OP_ADD
        mp3_put(MP_YO, 10)
        lde e7, #MP_YT
        ldy s1, e7
        alu s1, s1, s14, #OP_ADD
        mp3_put(MP_YT, 1)
        ldi s12, #18
        alu s12, s1, s12, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, yslot
        nop()
        nop()
}

; One packet (specs/mp3.md, the sm1 side): the frame on the stream decoded into ring slot
; Y[MP_OSL] (MP_RSL words each from OUTY), samples x nch words, zeros when its main data is not
; at hand (twin: ref/dsp/mp3/decoder.zig), published (lib/ring.sm). Needs lib/ring.sm.
.macro mp3_packet() {
        stream_on()
        ybits_init()
        mp3_header()
        mp3_sideinfo()
        mp3_main()
        lde e7, #MP_OSL
        ldy s1, e7
        ldi s12, #MP_RSL
        x18.mpy s1, s0, s1, s12
        ldi s12, #OUTY
        alu s1, s1, s12, #OP_ADD
        mp3_put(MP_OUT, 1)
        lde e7, #MP_OK
        ldy s12, e7
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, mute
        nop()
        nop()
        mp3_granules()
        jmp #ALWAYS, #0, keep
        nop()
        nop()
mute:   mp3_plen(s6)
        lde e7, #MP_OUT
        ldy s1, e7
        alu s1, s1, s14, #OP_SUB
        x17.mve e7, s1
        ldi s3, #0
zero:   x17.styi e7, #3, #0, e7
        alu s6, s6, s14, #OP_SUB
        alu s12, s6, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, zero
        nop()
        nop()
keep:   mp3_keep()
        mp3_plen(s7)
        ring_publish(MP_OSL)
}

; dst = the frame's PCM words: 576 x granules x channels. Uses s12, e7.
.macro mp3_plen(dst) {
        lde e7, #MH_MP1
        ldy dst, e7
        alu dst, dst, s14, #OP_ADD
        ldi s12, #576
        x18.mpy dst, s0, dst, s12
        lde e7, #MH_NCH
        ldy s12, e7
        x18.mpy dst, s0, dst, s12
}
