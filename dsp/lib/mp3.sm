; Twin: ref/mp3/header.zig, ref/mp3/sideinfo.zig; ISO/IEC 11172-3 2.4.1.3 and 2.4.1.7, 13818-3
; 2.4.1.7. MPEG Layer III on sm1: the frame's intake from the input stream and its side
; information (specs/mp3.md). Needs lib/ybits.sm and lib/stream.sm.
;
; Each packet is one whole frame (specs/mp3.md). mp3_header reads its 4 header bytes, takes the
; frame length from MP_FLEN (the host's rule: 144 or 72 x kbps x 1000 / rate, free format as
; 128 kbps), then copies the CRC and side information to MP_SIDE + 4 and the main data to
; MP_MAIN, right after the reservoir's bytes (one byte per Y word, as ybits reads them).

.const MP_HDR  = 0x1280         ; header fields, then what follows from them (MH_*)
.const MH_VER  = MP_HDR + 1     ; version bits: 3 MPEG-1, 2 MPEG-2, 0 MPEG-2.5
.const MH_PROT = MP_HDR + 2     ; protection_bit: 0 = a CRC word follows the header
.const MH_BR   = MP_HDR + 3
.const MH_SR   = MP_HDR + 4
.const MH_PAD  = MP_HDR + 5
.const MH_MODE = MP_HDR + 6
.const MH_EXT  = MP_HDR + 7
.const MH_NCH  = MP_HDR + 8
.const MH_MP1  = MP_HDR + 9     ; 1 for MPEG-1 (two granules)
.const MH_FLEN = MP_HDR + 10    ; frame bytes
.const MH_SIDE = MP_HDR + 11    ; CRC and side information bytes
.const MH_MAIN = MP_HDR + 12    ; main data bytes in this frame
.const MP_SI   = 0x1290         ; main_data_begin, scfsi[0], scfsi[1], then the granules
.const MP_GR0  = MP_SI + 3      ; granule (gr, ch) at MP_GR0 + (2 gr + ch) MP_GR
.const MP_GR   = 18
.const MP_FLEN = 0x1300         ; 135 words: [MPEG-1, 2, 2.5][sr_index][bitrate_index]
.const MP_SIDE = 0x1390         ; the header, CRC and side information bytes (<= 38)
.const MP_RES  = 0x1400         ; the reservoir: up to 511 bytes ending at MP_MAIN - 1
.const MP_MAIN = 0x1600         ; this frame's main data (<= 1440 bytes)

; A granule record, word by word (ref/mp3/sideinfo.zig Granule): part2_3_length, big_values,
; global_gain, scalefac_compress, window_switching, block_type, mixed, table_select[3],
; subblock_gain[3], region0_count, region1_count, preflag, scalefac_scale, count1_table_b.

; Y[s1 ..] <- the next s2 stream bytes. Uses s2, s3, s12, s13, e7, A1, A15.
.macro mp3_copy() {
        alu s13, s1, s14, #OP_SUB
        x17.mve e7, s13         ; e7 = s1
more:   alu s12, s2, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; nothing left
        jmp #3, #3, done
        nop()
        nop()
        sbyte(s3)
        x17.styi e7, #3, #0, e7
        alu s2, s2, s14, #OP_SUB
        jmp #ALWAYS, #0, more
        nop()
        nop()
done:
}

; Y[addr] <- r (r not s0 or s8). Uses e7.
.macro mp3_put(addr, r) {
        lde e7, #addr
        x17.sty e7, #(r & 7), #(r >> 3)
}

; The frame's header and the bytes after it. Uses s1..s5, s7, s8 and the reader's registers.
.macro mp3_header() {
        ldi s1, #MP_SIDE
        ldi s2, #4
        mp3_copy()
        ldi s1, #MP_SIDE
        ybits_at(s1)
        getbits(s8, 11)         ; sync
        getbits(s1, 2)          ; version
        getbits(s8, 2)          ; layer (III: the host admits no other)
        getbits(s2, 1)          ; protection_bit
        getbits(s3, 4)          ; bitrate_index
        getbits(s4, 2)          ; sampling_frequency
        getbits(s5, 1)          ; padding_bit
        getbits(s8, 1)          ; private_bit
        getbits(s7, 2)          ; mode
        getbits(s13, 2)         ; mode_extension
        mp3_put(MH_EXT, 13)
        getbits(s8, 4)          ; copyright, original, emphasis
        mp3_put(MH_VER, 1)
        mp3_put(MH_PROT, 2)
        mp3_put(MH_BR, 3)
        mp3_put(MH_SR, 4)
        mp3_put(MH_PAD, 5)
        mp3_put(MH_MODE, 7)
        ; the table row: MPEG-1 0, MPEG-2 1, MPEG-2.5 2 = 3 - version, less 1 for version 0
        ldi s12, #3
        alu s8, s12, s1, #OP_SUB
        alu s12, s1, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST ; MPEG-2.5
        jmp #IF_NOT, #3, row
        nop()
        nop()
        alu s8, s8, s14, #OP_SUB
row:    ldi s12, #45
        x18.mpy s8, s0, s8, s12 ; row * 45 (x18.mpy's low product)
        ldi s12, #15
        x18.mpy s4, s0, s4, s12 ; sr * 15
        alu s8, s8, s4, #OP_ADD
        alu s8, s8, s3, #OP_ADD
        ldi s12, #MP_FLEN - 1
        alu s13, s8, s12, #OP_ADD
        x17.mve e7, s13
        ldy s3, e7              ; slots (the bitrate's table entry)
        alu s3, s3, s5, #OP_ADD ; + padding: the frame's bytes
        mp3_put(MH_FLEN, 3)
        ; channels: mode 3 is one, the rest two
        ldi s12, #3
        alu s12, s7, s12, #OP_SUB
        ptst p3, s0, #EQ12, #PTST
        ldi s4, #2
        jmp #IF_NOT, #3, stereo
        nop()
        nop()
        ldi s4, #1
stereo: mp3_put(MH_NCH, 4)
        ; side information: MPEG-1 17 / 32 bytes, MPEG-2 and 2.5 9 / 17
        ldi s12, #3
        alu s12, s1, s12, #OP_SUB
        ptst p3, s0, #EQ12, #PTST ; MPEG-1
        ldi s5, #0
        jmp #IF_NOT, #3, lsf
        ldi s7, #9              ; (delay slot) MPEG-2 mono
        ldi s8, #17             ; (delay slot) MPEG-2 stereo
        ldi s5, #1
        ldi s7, #17
        ldi s8, #32
lsf:    mp3_put(MH_MP1, 5)
        alu s12, s4, s14, #OP_SUB
        alu s12, s12, s14, #OP_SUB
        ptst p3, s0, #EQ12, #PTST ; stereo
        jmp #IF_NOT, #3, mono
        nop()
        nop()
        alu s7, s8, s0, #OP_ADD
mono:   alu s12, s2, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST ; protection_bit 0: a CRC word
        jmp #IF_NOT, #3, nocrc
        nop()
        nop()
        ldi s12, #2
        alu s7, s7, s12, #OP_ADD
nocrc:  mp3_put(MH_SIDE, 7)
        ldi s12, #4
        alu s3, s3, s12, #OP_SUB
        alu s3, s3, s7, #OP_SUB ; main data bytes
        mp3_put(MH_MAIN, 3)
        ldi s1, #MP_SIDE + 4
        alu s2, s7, s0, #OP_ADD
        mp3_copy()
        lde e7, #MH_MAIN
        ldy s2, e7
        ldi s1, #MP_MAIN
        mp3_copy()
}

; Granule fields in record order through e5 (x17.styi). Uses s3, the reader's registers.
.macro gfield(k) {
        getbits(s3, k)
        x17.styi e5, #3, #0, e5
}

.macro gzero() {
        ldi s3, #0
        x17.styi e5, #3, #0, e5
}

; The side information from MP_SIDE + 4 (after the CRC word, if any) into MP_SI.
; Uses s1..s5, s7, s8, e5, e7 and the reader's registers.
.macro mp3_sideinfo() {
        ldi s12, #MP_SIDE + 4
        alu s1, s12, s0, #OP_ADD
        lde e7, #MH_PROT
        ldy s12, e7
        ptst p3, s0, #EQ12, #PTST ; a CRC word to skip
        jmp #IF_NOT, #3, at
        nop()
        nop()
        ldi s12, #2
        alu s1, s1, s12, #OP_ADD
at:     ybits_at(s1)
        lde e7, #MH_NCH
        ldy s2, e7              ; nch
        lde e7, #MH_MP1
        ldy s1, e7              ; MPEG-1
        lde e5, #MP_SI
        alu s12, s1, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST ; MPEG-2 / 2.5
        jmp #3, #3, lsf
        alu s12, s2, s14, #OP_SUB ; (delay slot) nch - 1
        nop()
        gfield(9)               ; main_data_begin
        alu s12, s2, s14, #OP_SUB
        ptst p3, s0, #EQ12, #PTST ; mono
        jmp #IF_NOT, #3, priv2
        nop()
        nop()
        getbits(s3, 5)          ; private bits, mono
        gfield(4)               ; scfsi[0]
        gzero()
        jmp #ALWAYS, #0, grans
        nop()
        nop()
priv2:  getbits(s3, 3)
        gfield(4)
        gfield(4)
        jmp #ALWAYS, #0, grans
        nop()
        nop()
lsf:    gfield(8)
        alu s12, s2, s14, #OP_SUB
        ptst p3, s0, #EQ12, #PTST ; mono
        jmp #IF_NOT, #3, priv3
        nop()
        nop()
        getbits(s3, 1)
        jmp #ALWAYS, #0, lsfz
        nop()
        nop()
priv3:  getbits(s3, 2)
lsfz:   gzero()
        gzero()
        ; granules: s4 = granules left, s5 = this granule's first record
grans:  alu s4, s1, s14, #OP_ADD ; MPEG-1 2, else 1
        ldi s5, #MP_GR0
gr:     alu s12, s4, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, done
        alu s7, s2, s0, #OP_ADD ; (delay slot) channels left
        alu s13, s5, s14, #OP_SUB ; (delay slot)
        x17.mve e5, s13         ; e5 = the record
ch:     gfield(12)              ; part2_3_length
        gfield(9)               ; big_values
        gfield(8)               ; global_gain
        alu s12, s1, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, sfc9
        nop()
        nop()
        gfield(4)               ; scalefac_compress, MPEG-1
        jmp #ALWAYS, #0, ws
        nop()
        nop()
sfc9:   gfield(9)               ; scalefac_compress, MPEG-2
ws:     getbits(s8, 1)          ; window_switching_flag
        alu s3, s8, s0, #OP_ADD
        x17.styi e5, #3, #0, e5
        ptst p3, s0, #EQ8, #PTST
        jmp #3, #3, plain
        nop()
        nop()
        getbits(s8, 2)          ; block_type
        alu s3, s8, s0, #OP_ADD
        x17.styi e5, #3, #0, e5
        getbits(s3, 1)          ; mixed_block_flag
        x17.styi e5, #3, #0, e5
        ; region0_count: 8 for a short block that is not mixed, else 7
        alu s8, s8, s14, #OP_SUB
        alu s8, s8, s14, #OP_SUB ; block_type - 2
        alu s8, s8, s3, #OP_ADD ; + mixed: 0 for short, not mixed
        gfield(5)               ; table_select[0]
        gfield(5)               ; table_select[1]
        gzero()
        gfield(3)               ; subblock_gain[0..2]
        gfield(3)
        gfield(3)
        ldi s3, #7
        alu s12, s8, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, r0
        nop()
        nop()
        ldi s3, #8
r0:     x17.styi e5, #3, #0, e5
        ldi s3, #31
        x17.styi e5, #3, #0, e5
        jmp #ALWAYS, #0, tail
        nop()
        nop()
plain:  gzero()                 ; block_type
        gzero()                 ; mixed
        gfield(5)
        gfield(5)
        gfield(5)
        gzero()
        gzero()
        gzero()
        gfield(4)               ; region0_count
        gfield(3)               ; region1_count
tail:   alu s12, s1, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, nopre
        nop()
        nop()
        gfield(1)               ; preflag, MPEG-1
        jmp #ALWAYS, #0, scs
        nop()
        nop()
nopre:  gzero()
scs:    gfield(1)               ; scalefac_scale
        gfield(1)               ; count1table_select
        alu s7, s7, s14, #OP_SUB
        alu s12, s7, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, ch     ; the next channel's record follows
        nop()
        nop()
        ldi s12, #2 * MP_GR
        alu s5, s5, s12, #OP_ADD
        alu s4, s4, s14, #OP_SUB
        jmp #ALWAYS, #0, gr
        nop()
        nop()
done:
}

; ---------------------------------------------------------------------------
; Scale factors (ref/mp3/scalefactors.zig; ISO/IEC 11172-3 2.4.2.7, 13818-3 2.4.3.2): one per
; band entry, 40 per granule and channel at MP_SF, the rest of the 40 zeroed. MPEG-2 marks an
; intensity position at its slen's largest value (no intensity) with MP_ILL added.

.const MP_SLEN = 0x1C00         ; slen1[16], then slen2[16]
.const MP_PART = 0x1C20         ; partition entry counts [long, mixed, short][28]
.const MP_GMOD = 0x1C80         ; MPEG-2 partition radices [24]
.const MP_SF   = 0x1CA0         ; [2 gr + ch][40]
.const MP_PRE  = 0x1D40         ; MPEG-2's derived preflag, [2 gr + ch]
.const MP_CK   = 0x1D44         ; the granule and channel at hand: 2 gr + ch
.const MP_CCH  = 0x1D45         ; its channel
.const MP_CSZ  = 0x1D46         ; its four partition slens
.const MP_CCNT = 0x1D4A         ; the address of its four partition counts
.const MP_ILL  = 0x100

; s<dst> = Y[addr + r] (r a register, not s13). Uses e7.
.macro yidx(dst, addr, r) {
        ldi s13, #addr - 1
        alu s13, s13, r, #OP_ADD
        x17.mve e7, s13
        ldy dst, e7
}

; q, x <- floor(x / d), x mod d, d >= 2 in a register (repeated subtraction: MPEG-2 only).
; Uses s12.
.macro divmod(q, x, d) {
        ldi q, #0
more:   alu s12, x, d, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, done
        nop()
        nop()
        alu x, s12, s0, #OP_ADD
        alu q, q, s14, #OP_ADD
        jmp #ALWAYS, #0, more
        nop()
        nop()
done:
}

; The granule and channel in MP_CK, MP_CCH: their scale factors from the reader's position.
; Uses s1..s5, s7, s8, e4, e5, e7 and the reader's registers.
.macro mp3_sf() {
        lde e7, #MP_CK
        ldy s1, e7              ; k = 2 gr + ch
        ldi s12, #MP_GR
        x18.mpy s2, s0, s1, s12
        ldi s12, #MP_GR0 + 2
        alu s13, s2, s12, #OP_ADD
        x17.mve e7, s13         ; the record's scalefac_compress
        ldy s3, e7
        ldi s12, #MP_GR0 + 4
        alu s13, s2, s12, #OP_ADD
        x17.mve e7, s13
        ldy s4, e7              ; block_type (0 without window switching)
        ldi s12, #MP_GR0 + 5
        alu s13, s2, s12, #OP_ADD
        x17.mve e7, s13
        ldy s5, e7              ; mixed
        ; row: 0 long, 1 mixed, 2 short (short = block_type 2)
        ldi s7, #0
        ldi s12, #2
        alu s12, s4, s12, #OP_SUB
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, rowd
        nop()
        nop()
        ldi s7, #2
        alu s7, s7, s5, #OP_SUB
rowd:   ldi s12, #28
        x18.mpy s7, s0, s7, s12
        ldi s12, #MP_PART
        alu s7, s7, s12, #OP_ADD ; the row's counts
        lde e7, #MH_MP1
        ldy s12, e7
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, lsf
        nop()
        nop()
        ; MPEG-1: slen1 twice, slen2 twice; scfsi in granule 1 of a block that is not short
        yidx(s5, MP_SLEN, s3)
        lde e7, #MP_CSZ
        x17.styi e7, #5, #0, e7
        x17.styi e7, #5, #0, e7
        yidx(s5, MP_SLEN + 16, s3)
        lde e7, #MP_CSZ + 2
        x17.styi e7, #5, #0, e7
        x17.styi e7, #5, #0, e7
        mp3_put(MP_CCNT, 7)
        ldi s5, #0              ; scfsi
        ldi s12, #2
        alu s12, s1, s12, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; granule 0
        jmp #3, #3, m1pre
        nop()
        nop()
        ldi s12, #2
        alu s12, s4, s12, #OP_SUB
        ptst p3, s0, #EQ12, #PTST ; short
        jmp #3, #3, m1pre
        nop()
        nop()
        lde e7, #MP_CCH
        ldy s12, e7
        yidx(s5, MP_SI + 1, s12)
m1pre:  ldi s7, #0              ; not MPEG-2
        ldi s8, #0              ; preflag
        jmp #ALWAYS, #0, store
        nop()
        nop()
        ; MPEG-2: intensity's right channel halves scalefac_compress and uses radices 12..23
lsf:    ldi s4, #0              ; radix base
        ldi s8, #1              ; preflag possible
        lde e7, #MH_MODE
        ldy s12, e7
        alu s12, s12, s14, #OP_SUB
        ptst p3, s0, #EQ12, #PTST ; joint stereo
        jmp #IF_NOT, #3, noist
        nop()
        nop()
        lde e7, #MH_EXT
        ldy s12, e7
        x18.and s12, s12, s14
        ptst p3, s0, #EQ12, #PTST ; no intensity
        jmp #3, #3, noist
        nop()
        nop()
        lde e7, #MP_CCH
        ldy s12, e7
        ptst p3, s0, #EQ12, #PTST ; left channel
        jmp #3, #3, noist
        nop()
        nop()
        alu s3, s14, s3, #ASR   ; scalefac_compress >> 1 (fact 774)
        ldi s4, #12
        ldi s8, #0
        ; the group: subtract each group's radix product while scalefac_compress reaches it
noist:  ldi s5, #0              ; group
grp:    yidx(s1, MP_GMOD, s4)
        yidx(s2, MP_GMOD + 1, s4)
        x18.mpy s1, s0, s1, s2
        yidx(s2, MP_GMOD + 2, s4)
        x18.mpy s1, s0, s1, s2
        yidx(s2, MP_GMOD + 3, s4)
        x18.mpy s1, s0, s1, s2 ; the group's product
        alu s12, s3, s1, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, ingrp
        nop()
        nop()
        alu s3, s12, s0, #OP_ADD
        ldi s12, #4
        alu s4, s4, s12, #OP_ADD
        alu s5, s5, s14, #OP_ADD
        jmp #ALWAYS, #0, grp
        nop()
        nop()
        ; the slens: scalefac_compress's mixed-radix digits, the last radix least significant
ingrp:  ldi s2, #3
dig:    alu s12, s4, s2, #OP_ADD
        yidx(s1, MP_GMOD, s12)  ; the radix
        alu s12, s1, s14, #OP_SUB
        ptst p3, s0, #EQ12, #PTST ; radix 1: digit 0
        jmp #IF_NOT, #3, div
        ldi s12, #0             ; (delay slot)
        nop()
        jmp #ALWAYS, #0, put
        nop()
        nop()
div:    divmod(s13, s3, s1)
        alu s1, s3, s0, #OP_ADD ; the digit
        alu s3, s13, s0, #OP_ADD ; the rest
        alu s12, s1, s0, #OP_ADD
put:    ldi s13, #MP_CSZ - 1
        alu s13, s13, s2, #OP_ADD
        x17.mve e7, s13
        x17.sty e7, #4, #1      ; s12
        alu s2, s2, s14, #OP_SUB
        alu s12, s2, s0, #OP_ADD
        ptst p3, s0, #LT12, #PTST
        jmp #IF_NOT, #3, dig
        nop()
        nop()
        ; counts one group past the radices (ref: partitions[row][k + 4]); preflag for group 2
        alu s7, s7, s4, #OP_ADD
        ldi s12, #4
        alu s7, s7, s12, #OP_ADD
        mp3_put(MP_CCNT, 7)
        ldi s12, #2
        alu s12, s5, s12, #OP_SUB
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, g2
        nop()
        nop()
        ldi s8, #0
g2:     ldi s5, #0              ; no scfsi
        ldi s7, #1              ; MPEG-2
        ; s5 scfsi, s7 MPEG-2, s8 preflag
store:  lde e7, #MP_CK
        ldy s1, e7
        ldi s13, #MP_PRE - 1
        alu s13, s13, s1, #OP_ADD
        x17.mve e7, s13
        alu s13, s8, s0, #OP_ADD
        x17.sty e7, #5, #1      ; MP_PRE[k] = preflag (via s13: x17.sty takes no s8)
        alu s8, s7, s0, #OP_ADD ; s8 = MPEG-2 from here; s7 carries the values
        ; out: MP_SF + 40 k; scfsi's source: granule 0's, MP_SF + 40 ch
        ldi s12, #40
        x18.mpy s2, s0, s1, s12
        ldi s13, #MP_SF - 1
        alu s13, s13, s2, #OP_ADD
        x17.mve e5, s13
        lde e7, #MP_CCH
        ldy s1, e7
        x18.mpy s2, s0, s1, s12
        ldi s13, #MP_SF - 1
        alu s13, s13, s2, #OP_ADD
        x17.mve e4, s13
        ldi s1, #0              ; partition
        ldi s4, #40             ; entries left to write
part:   ldi s12, #4
        alu s12, s1, s12, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #IF_NOT, #3, zero
        nop()
        nop()
        lde e7, #MP_CCNT
        ldy s12, e7
        alu s13, s12, s1, #OP_ADD
        alu s13, s13, s14, #OP_SUB
        x17.mve e7, s13
        ldy s2, e7              ; this partition's entries
        alu s12, s2, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, zero
        nop()
        nop()
        yidx(s3, MP_CSZ, s1)    ; its slen
        ; reuse: scfsi bit 8 >> partition
        ldi s12, #3
        alu s12, s12, s1, #OP_SUB
        alu s12, s12, s5, #ASR  ; scfsi >> (3 - part) (fact 774)
        x18.and s12, s12, s14
        alu s4, s4, s2, #OP_SUB
        ptst p3, s0, #EQ12, #PTST ; read, not reused
        jmp #3, #3, ent
        nop()
        nop()
        ; reused: copy granule 0's
rcopy:  x19.ld s7, #2, e4, #2
        x17.styi e5, #7, #0, e5
        alu s2, s2, s14, #OP_SUB
        alu s12, s2, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, rcopy
        nop()
        nop()
        jmp #ALWAYS, #0, pnext
        nop()
        nop()
ent:    alu s12, s3, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST ; slen 0: zeros
        ldi s7, #0
        jmp #3, #3, put0
        nop()
        nop()
        alu s11, s3, s0, #OP_ADD
        getbits_s(s7)
        alu s12, s8, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST ; MPEG-1: no intensity mark
        jmp #3, #3, put0
        nop()
        nop()
        x19.alu s13, s14, s3, #SHIFT ; 2^slen
        alu s13, s13, s14, #OP_SUB
        alu s12, s7, s13, #OP_SUB
        ptst p3, s0, #EQ12, #PTST ; the largest value
        jmp #IF_NOT, #3, put0
        nop()
        nop()
        ldi s13, #MP_ILL
        alu s7, s7, s13, #OP_ADD
put0:   x17.styi e5, #7, #0, e5
        x19.ld s12, #2, e4, #2  ; keep e4 in step with e5
        alu s2, s2, s14, #OP_SUB
        alu s12, s2, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, ent
        nop()
        nop()
pnext:  alu s1, s1, s14, #OP_ADD
        jmp #ALWAYS, #0, part
        nop()
        nop()
zero:   ldi s7, #0
zl:     alu s12, s4, s0, #OP_ADD
        ptst p3, s0, #LE12, #PTST
        jmp #3, #3, done
        nop()
        nop()
        x17.styi e5, #7, #0, e5
        alu s4, s4, s14, #OP_SUB
        jmp #ALWAYS, #0, zl
        nop()
        nop()
done:
}

; ---------------------------------------------------------------------------
; The bit reservoir (ref/mp3/decoder.zig Parser; ISO/IEC 11172-3 2.4.3.4.4): the last 512
; bytes of main data end at MP_MAIN - 1, so a frame's main data, copied to MP_MAIN, continues
; them, and its granules start at bit 8 (MP_MAIN - main_data_begin - MP_PB) from Y:MP_PB.

; Huffman decoding and band tables, staged by dsp/mp3/tables.zig (Y words below 0x8000: ldy
; sign-extends).
.const MP_HT   = 0x1D60         ; [table_select 0..31, count1 A, count1 B]: the tree's address, 0 none
.const MP_HR   = 0x1D82         ; the same: the tree's root width
.const MP_LIN  = 0x1DA4         ; [table_select]: linbits
.const MP_BP   = 0x1DC4         ; [(version bits * 3 + sr_index) * 3 + long / short / mixed]: widths
.const MP_BW   = 0x1DE8         ; the band width lists, each ending in a 0
.const MP_PRET = 0x20A0         ; pretab[22] (ISO/IEC 11172-3 Table B.6)
.const MP_Q    = 0x20C0         ; requantisation slots (MP_Q*)
.const MP_QLST = MP_Q + 0       ; the granule's band list (mp3_spec)
.const MP_QKIND = MP_Q + 1      ; 0 long, 1 short, 2 mixed
.const MP_QE   = MP_Q + 2       ; the entry at hand's list address
.const MP_QW   = MP_Q + 3       ; its window, 0..2, once past the long entries
.const MP_QNL  = MP_Q + 4       ; long entries left
.const MP_QT0  = MP_Q + 5       ; global_gain - 210
.const MP_QSH  = MP_Q + 6       ; scalefac shift, 1 + scalefac_scale (as a left shift: negative)
.const MP_QPF  = MP_Q + 7       ; the pretab address, or MP_QZ without preflag
.const MP_QSF  = MP_Q + 8       ; the entry's scale factor address
.const MP_QREC = MP_Q + 9       ; the granule record's offset
.const MP_QZ   = MP_Q + 10      ; 40 zeros: no pretab
.const MP_SMB  = MP_Q + 50      ; stereo: max_band[3] (-1: none)
.const MP_SN   = MP_Q + 53      ; entries in the list
.const MP_SGR  = MP_Q + 54      ; the granule at hand
.const MP_SE   = MP_Q + 55      ; entry index
.const MP_SW   = MP_Q + 56      ; entry index mod 3
.const MP_SPOS = MP_Q + 57      ; 40 words: the right channel's positions, bit 8 illegal
.const MP_SSH  = MP_Q + 97      ; MPEG-2: scalefac_compress & 1
.const MP_SLP  = MP_Q + 98      ; list pointer
.const MP_XST  = 0x1980         ; X: pan[7][2] (MPEG-1 kl, kr), quarter[4] (MPEG-2), Q22; 1/sqrt 2 Q23
.const MP_XDUM = 0x0000         ; X: the taps' unused loads walk from here
.const MP_HUFF = 0x2300         ; the trees (lib/huffman.sm format), past lib/dequant.sm's Y
.const MP_YEND = 0x2E80         ; the host writes Y below here

.const MP_RE   = 0x1D51         ; the three regions' ends, in coefficients (576 the last)
.const MP_BIG  = 0x1D54         ; 2 big_values
.const MP_I    = 0x1D55         ; coefficients decoded
.const MP_LIM  = 0x1D56         ; the granule's last bit + 1, from Y:MP_PB
.const MP_TB   = 0x1D57         ; the region's tree, 0 none
.const MP_TR   = 0x1D58         ; its root width
.const MP_TL   = 0x1D59         ; its linbits
.const MP_N    = 0x1D5A         ; pairs left in the region
.const MP_RG   = 0x1D5B         ; the region at hand
.const MP_XS   = 0x0400         ; X: the spectrum of granule and channel k at MP_XS + 576 k

.const MP_RLEN = 0x1D4E         ; reservoir bytes, 0..512 (0 at the stream's start)
.const MP_OK   = 0x1D4F         ; 1: main_data_begin within the reservoir, the frame decodes
.const MP_P    = 0x1D50         ; the granule at hand's first bit, in bits from Y:MP_PB
.const MP_PB   = 0x1000         ; MP_P's origin: Y words load sign-extended from 16 bits, so a
                                ; bit address from Y:0 would turn negative past Y:0x1000

; MP_OK and MP_P for this frame. Uses s1, s2, s12, e7.
.macro mp3_main() {
        lde e7, #MP_SI
        ldy s1, e7              ; main_data_begin
        lde e7, #MP_RLEN
        ldy s2, e7
        alu s12, s2, s1, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; reaches past the reservoir
        ldi s2, #0
        jmp #3, #3, ok
        nop()
        nop()
        ldi s2, #1
ok:     mp3_put(MP_OK, 2)
        ldi s12, #MP_MAIN - MP_PB
        alu s1, s12, s1, #OP_SUB
        ldi s12, #-3
        alu s1, s12, s1, #ASR   ; * 8 (fact 774)
        mp3_put(MP_P, 1)
}

; The reader at bit s1 from Y:MP_PB (s1 not s13). Uses s1, s2, the reader's registers.
.macro mp3_seek() {
        ldi s12, #3
        alu s2, s12, s1, #ASR   ; the byte from MP_PB
        ldi s12, #-3
        alu s12, s12, s2, #ASR
        alu s1, s1, s12, #OP_SUB ; the bits into it
        ldi s12, #MP_PB
        alu s2, s2, s12, #OP_ADD
        ybits_at(s2)
        alu s11, s1, s0, #OP_ADD
        getbits_s(s1)
}

; The reservoir after the frame: its last min(512, MP_RLEN + MH_MAIN) bytes moved to end at
; MP_MAIN - 1. Uses s1..s3, s12, s13, e7, e8.
.macro mp3_keep() {
        lde e7, #MP_RLEN
        ldy s1, e7
        lde e7, #MH_MAIN
        ldy s2, e7
        alu s1, s1, s2, #OP_ADD
        ldi s12, #512
        alu s12, s1, s12, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; under 512
        jmp #3, #3, fits
        nop()
        nop()
        ldi s1, #512
fits:   mp3_put(MP_RLEN, 1)
        ldi s12, #MP_MAIN - 1
        alu s13, s12, s2, #OP_ADD
        alu s13, s13, s1, #OP_SUB ; source - 1: MP_MAIN + main - n - 1
        x17.mve e8, s13
        alu s13, s12, s1, #OP_SUB ; destination - 1: MP_MAIN - n - 1
        x17.mve e7, s13
        alu s12, s2, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST ; no new bytes: nothing moves
        jmp #3, #3, done
        nop()
        nop()
mv:     alu s12, s1, s0, #OP_ADD
        ptst p3, s0, #LE12, #PTST
        jmp #3, #3, done
        nop()
        nop()
        x19.ld s3, #4, e8, #2
        x17.styi e7, #3, #0, e7
        alu s1, s1, s14, #OP_SUB
        jmp #ALWAYS, #0, mv
        nop()
        nop()
done:
}

; Each granule and channel in order (k = 2 gr + ch, the absent ones skipped): the reader at
; its first bit, its scale factors and spectrum, then MP_P past its part2_3_length bits.
; Uses s1..s5, s7, s8, e4, e5, e7, e8 and the reader's registers.
.macro mp3_granules() {
        ldi s1, #0
        mp3_put(MP_CK, 1)
gc:     lde e7, #MP_CK
        ldy s1, e7
        x18.and s2, s1, s14     ; ch
        alu s3, s14, s1, #ASR   ; gr (fact 774)
        mp3_put(MP_CCH, 2)
        lde e7, #MH_NCH
        ldy s12, e7
        alu s12, s2, s12, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; ch < nch
        jmp #IF_NOT, #3, next
        nop()
        nop()
        lde e7, #MH_MP1
        ldy s12, e7
        alu s12, s3, s12, #OP_SUB
        alu s12, s12, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; gr < granules
        jmp #IF_NOT, #3, next
        nop()
        nop()
        lde e7, #MP_CK
        ldy s1, e7
        ldi s12, #MP_GR
        x18.mpy s1, s0, s1, s12
        yidx(s2, MP_GR0, s1)    ; part2_3_length
        lde e7, #MP_P
        ldy s1, e7
        alu s2, s1, s2, #OP_ADD
        mp3_put(MP_LIM, 2)
        mp3_seek()
        mp3_sf()
        mp3_spec()
        mp3_requant()
        lde e7, #MP_LIM
        ldy s1, e7
        mp3_put(MP_P, 1)
next:   lde e7, #MP_CK
        ldy s1, e7
        alu s1, s1, s14, #OP_ADD
        mp3_put(MP_CK, 1)
        ldi s12, #4
        alu s12, s1, s12, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, gc
        nop()
        nop()
}

; ---------------------------------------------------------------------------
; The spectrum (ref/mp3/spectrum.zig; ISO/IEC 11172-3 2.4.2.7, 2.4.3.4.6): big_values pairs in
; three regions by table_select, then count1 quadruples while bits of part2_3_length remain,
; then zeros to 576, as integers to X:MP_XS + 576 k. Pair leaves hold x * 16 + y, quadruple
; leaves vwxy (dsp/mp3/tables.zig). Tables 0, 4 and 14 read nothing and give zeros (ref fails
; on 4 and 14: no stream uses them). Needs lib/huffman.sm, lib/mem.sm.

; s2 = the band list of granule and channel s1 (MP_BP[(version * 3 + sr) * 3 + kind]), s6 =
; its kind: 0 long, 1 short, 2 mixed. Uses s3, s4, s5, s7, s8, s12, s13, e7.
.macro mp3_blist() {
        ldi s12, #MP_GR
        x18.mpy s3, s0, s1, s12 ; the record's offset
        yidx(s4, MP_GR0 + 5, s3) ; block_type
        yidx(s5, MP_GR0 + 6, s3) ; mixed
        ldi s6, #0
        ldi s12, #2
        alu s12, s4, s12, #OP_SUB
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, kind
        nop()
        nop()
        alu s6, s14, s5, #OP_ADD ; short: 1, mixed: 2
kind:   lde e7, #MH_VER
        ldy s7, e7
        ldi s12, #3
        x18.mpy s7, s0, s7, s12
        lde e7, #MH_SR
        ldy s8, e7
        alu s7, s7, s8, #OP_ADD
        x18.mpy s7, s0, s7, s12
        alu s7, s7, s6, #OP_ADD
        yidx(s2, MP_BP, s7)     ; the list's address
}

; s<x> += linbits bits when x = 15 (with linbits 0 the read takes nothing). Uses s5, s11, s12.
.macro mp3_lin(x) {
        ldi s12, #15
        alu s12, x, s12, #OP_SUB
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, done
        nop()
        nop()
        lde e7, #MP_TL
        ldy s11, e7
        getbits_s(s5)
        alu x, x, s5, #OP_ADD
done:
}

; One quadruple bit: s2 = bit b of s1, its sign, to X. Uses s2, s4, s8 and the reader's.
.macro mp3_qbit(b) {
        ldi s12, #b
        alu s2, s12, s1, #ASR
        x18.and s2, s2, s14
        spec_sign(s2)
        spec_put(s2)
}

; s<dst> = the reader's position in bits from Y:MP_PB. Uses s13.
.macro mp3_pos(dst) {
        ybits_pos(dst)
        ldi s13, #MP_PB
        alu dst, dst, s13, #OP_SUB
        ldi s13, #MP_PB * 8 - MP_PB
        alu dst, dst, s13, #OP_SUB
}

; The granule and channel in MP_CK, the reader after its scale factors, MP_LIM set.
; Uses s1..s8, s11..s13, e6, e7, A6, A14, R7 and the reader's registers.
.macro mp3_spec() {
        lde e7, #MP_CK
        ldy s1, e7
        ldi s12, #576
        x18.mpy s2, s0, s1, s12
        ldi s12, #MP_XS
        alu s2, s2, s12, #OP_ADD
        amov(A6, s2)
        mp3_blist()
        ldi s12, #MP_GR
        x18.mpy s3, s0, s1, s12 ; the record's offset
        mp3_put(MP_QLST, 2)
        mp3_put(MP_QKIND, 6)
        ; region ends: the sum of widths through entry region0_count, and through
        ; region0_count + region1_count + 1; 576 where the list ends first
        yidx(s4, MP_GR0 + 13, s3) ; region0_count
        yidx(s5, MP_GR0 + 14, s3) ; region1_count
        alu s5, s5, s4, #OP_ADD
        alu s5, s5, s14, #OP_ADD
        ldi s1, #576
        mp3_put(MP_RE, 1)
        mp3_put(MP_RE + 1, 1)
        mp3_put(MP_RE + 2, 1)
        ldi s6, #0              ; entry
        ldi s7, #0              ; sum
        ldi s13, #-1
        alu s13, s13, s2, #OP_ADD
        x17.mve e5, s13         ; e5 = the list
bw:     ldy s8, e5
        alu s12, s8, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST ; the list's end
        jmp #3, #3, bdone
        nop()
        nop()
        alu s7, s7, s8, #OP_ADD
        alu s12, s6, s4, #OP_SUB
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, b1
        nop()
        nop()
        mp3_put(MP_RE, 7)
b1:     alu s12, s6, s5, #OP_SUB
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, b2
        nop()
        nop()
        mp3_put(MP_RE + 1, 7)
b2:     alu s6, s6, s14, #OP_ADD
        x17.mve e5, s2          ; e5 = list + entry: e5 = s2 + 1, so step s2
        alu s2, s2, s14, #OP_ADD
        jmp #ALWAYS, #0, bw
        nop()
        nop()
bdone:  yidx(s1, MP_GR0 + 1, s3) ; big_values
        alu s1, s1, s1, #OP_ADD
        mp3_put(MP_BIG, 1)
        ldi s1, #0
        mp3_put(MP_I, 1)
        mp3_put(MP_RG, 1)
        ; each region: (min(end, big) - i) / 2 pairs from its table
reg:    lde e7, #MP_RG
        ldy s1, e7
        yidx(s2, MP_RE, s1)
        lde e7, #MP_BIG
        ldy s4, e7
        alu s12, s2, s4, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, rmin
        nop()
        nop()
        alu s2, s4, s0, #OP_ADD ; min(end, big)
rmin:   lde e7, #MP_I
        ldy s4, e7
        alu s12, s2, s4, #OP_SUB
        ptst p3, s0, #LE12, #PTST ; nothing in this region
        jmp #3, #3, rnext
        nop()
        nop()
        alu s5, s14, s12, #ASR  ; pairs (fact 774)
        mp3_put(MP_N, 5)
        mp3_put(MP_I, 2)        ; i = the region's end
        lde e7, #MP_CK
        ldy s3, e7
        ldi s12, #MP_GR
        x18.mpy s3, s0, s3, s12
        alu s3, s3, s1, #OP_ADD
        yidx(s4, MP_GR0 + 7, s3) ; table_select[region]
        yidx(s5, MP_HT, s4)
        mp3_put(MP_TB, 5)
        yidx(s5, MP_HR, s4)
        mp3_put(MP_TR, 5)
        yidx(s5, MP_LIN, s4)
        mp3_put(MP_TL, 5)
        lde e7, #MP_TB
        ldy s12, e7
        ptst p3, s0, #EQ12, #PTST ; no tree: zeros
        jmp #3, #3, rzero
        nop()
        nop()
pair:   lde e7, #MP_TB
        ldy s1, e7
        lde e7, #MP_TR
        ldy s11, e7
        huff_decode(s1)
        field(s2, s3, s1, 4, 0)
        mp3_lin(s2)
        spec_sign(s2)
        mp3_lin(s3)
        spec_sign(s3)
        spec_put(s2)
        spec_put(s3)
        lde e7, #MP_N
        ldy s1, e7
        alu s1, s1, s14, #OP_SUB
        mp3_put(MP_N, 1)
        alu s12, s1, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, pair
        nop()
        nop()
        jmp #ALWAYS, #0, rnext
        nop()
        nop()
rzero:  lde e7, #MP_N
        ldy s1, e7
        ldi s2, #0              ; stx from s0 stores the xd latch (fact 709)
rz:     spec_put(s2)
        spec_put(s2)
        alu s1, s1, s14, #OP_SUB
        alu s12, s1, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, rz
        nop()
        nop()
rnext:  lde e7, #MP_RG
        ldy s1, e7
        alu s1, s1, s14, #OP_ADD
        mp3_put(MP_RG, 1)
        ldi s12, #3
        alu s12, s1, s12, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, reg
        nop()
        nop()
        ; count1: quadruples while i + 4 <= 576 and bits remain; one ending past them is dropped
        lde e7, #MP_CK
        ldy s3, e7
        ldi s12, #MP_GR
        x18.mpy s3, s0, s3, s12
        yidx(s4, MP_GR0 + 17, s3) ; count1table_select
        ldi s12, #32
        alu s4, s4, s12, #OP_ADD
        yidx(s5, MP_HT, s4)
        mp3_put(MP_TB, 5)
        yidx(s5, MP_HR, s4)
        mp3_put(MP_TR, 5)
quad:   lde e7, #MP_I
        ldy s1, e7
        ldi s12, #572
        alu s12, s12, s1, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; i > 572
        jmp #3, #3, tail
        nop()
        nop()
        mp3_pos(s2)
        lde e7, #MP_LIM
        ldy s4, e7
        alu s12, s2, s4, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; pos < limit
        jmp #IF_NOT, #3, tail
        nop()
        nop()
        lde e7, #MP_TB
        ldy s1, e7
        lde e7, #MP_TR
        ldy s11, e7
        huff_decode(s1)
        mp3_pos(s2)
        lde e7, #MP_LIM
        ldy s4, e7
        alu s12, s4, s2, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; past the limit: dropped
        jmp #3, #3, tail
        nop()
        nop()
        mp3_qbit(3)
        mp3_qbit(2)
        mp3_qbit(1)
        mp3_qbit(0)
        lde e7, #MP_I
        ldy s1, e7
        ldi s12, #4
        alu s1, s1, s12, #OP_ADD
        mp3_put(MP_I, 1)
        jmp #ALWAYS, #0, quad
        nop()
        nop()
        ; zeros to 576
tail:   lde e7, #MP_I
        ldy s1, e7
        ldi s2, #0
tl:     ldi s12, #576
        alu s12, s1, s12, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #IF_NOT, #3, done
        nop()
        nop()
        spec_put(s2)
        alu s1, s1, s14, #OP_ADD
        jmp #ALWAYS, #0, tl
        nop()
        nop()
done:
}

; ---------------------------------------------------------------------------
; Requantisation (twin: ref/dsp/mp3/requant.zig; ISO/IEC 11172-3 2.4.3.4.7): each line of
; X:MP_XS + 576 k in place, q -> sign(q) |q|^(4/3) 2^(t / 4) as a Q21 word, t per band entry:
; global_gain - 210 - 8 subblock_gain[window] - (sf + preflag pretab) << (1 + scalefac_scale).
; |q|^(4/3) = m 2^em 2^(rem / 3) by lib/dequant.sm's dq_mant, P = round(m G / 2^23) with G
; = X:DQ_G[4 rem + b], b = t mod 4, then one alu asrrs by -(em + floor(t / 4) + 23), clamped
; to 24 either way: rounding right, saturating left, as the twin. Needs lib/dequant.sm's
; tables (X DQ_D, DQ_IT, DQ_G; Y DQ_IE, DQ_IR).

; s<r> = clamp(s<r>, -24, 24). Uses s12, s13.
.macro mp3_clamp24(r) {
        ldi s13, #24
        alu s12, s13, r, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; r > 24
        jmp #IF_NOT, #3, lo
        nop()
        nop()
        alu r, s13, s0, #OP_ADD
lo:     alu s12, r, s13, #OP_ADD
        ptst p3, s0, #LT12, #PTST ; r < -24
        jmp #IF_NOT, #3, done
        nop()
        nop()
        alu r, s0, s13, #OP_SUB
done:
}

; The granule and channel in MP_CK, after mp3_spec. Uses every s register but s14, s15 (the
; reader's state is dropped: each granule seeks afresh), e6, e7, A8, A10 and amov's registers.
.macro mp3_requant() {
        lde e7, #MP_CK
        ldy s1, e7
        ldi s12, #576
        x18.mpy s2, s0, s1, s12
        ldi s12, #MP_XS
        alu s2, s2, s12, #OP_ADD
        amov(A10, s2)
        ldi s12, #40
        x18.mpy s2, s0, s1, s12
        ldi s12, #MP_SF
        alu s2, s2, s12, #OP_ADD
        mp3_put(MP_QSF, 2)
        ldi s12, #MP_GR
        x18.mpy s3, s0, s1, s12
        mp3_put(MP_QREC, 3)
        yidx(s2, MP_GR0 + 2, s3) ; global_gain
        ldi s12, #210
        alu s2, s2, s12, #OP_SUB
        mp3_put(MP_QT0, 2)
        yidx(s2, MP_GR0 + 16, s3) ; scalefac_scale
        alu s2, s0, s2, #OP_SUB
        alu s2, s2, s14, #OP_SUB ; -(1 + scalefac_scale)
        mp3_put(MP_QSH, 2)
        ; long entries: all (99) for a long block, none for short, 8 or 6 for mixed
        lde e7, #MP_QKIND
        ldy s4, e7
        ldi s2, #99
        alu s12, s4, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, nl
        nop()
        nop()
        ldi s2, #0
        alu s12, s4, s14, #OP_SUB
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, nl
        nop()
        nop()
        lde e7, #MH_MP1
        ldy s2, e7
        alu s2, s2, s2, #OP_ADD
        ldi s12, #6
        alu s2, s2, s12, #OP_ADD ; 6 + 2 MPEG-1
nl:     mp3_put(MP_QNL, 2)
        ; preflag: the side information's or MPEG-2's, long blocks only
        ldi s2, #MP_QZ
        alu s12, s4, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, pf
        nop()
        nop()
        yidx(s5, MP_GR0 + 15, s3) ; preflag
        lde e7, #MP_CK
        ldy s1, e7
        yidx(s6, MP_PRE, s1)
        alu s12, s5, s6, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, pf
        nop()
        nop()
        ldi s2, #MP_PRET
pf:     mp3_put(MP_QPF, 2)
        ldi s1, #0
        mp3_put(MP_QW, 1)
        lde e7, #MP_QLST
        ldy s1, e7
        mp3_put(MP_QE, 1)
        ; each entry: t, then its lines
ent:    lde e7, #MP_QE
        ldy s1, e7
        alu s13, s1, s14, #OP_SUB
        x17.mve e7, s13
        ldy s9, e7              ; width
        alu s12, s9, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST ; the list's end
        jmp #3, #3, done
        nop()
        nop()
        lde e7, #MP_QT0
        ldy s10, e7             ; t
        lde e7, #MP_QNL
        ldy s2, e7
        alu s12, s2, s0, #OP_ADD
        ptst p3, s0, #LE12, #PTST ; past the long entries: a window's
        jmp #3, #3, win
        nop()
        nop()
        alu s2, s2, s14, #OP_SUB
        mp3_put(MP_QNL, 2)
        jmp #ALWAYS, #0, sf
        nop()
        nop()
win:    lde e7, #MP_QW
        ldy s1, e7
        lde e7, #MP_QREC
        ldy s2, e7
        alu s2, s2, s1, #OP_ADD
        yidx(s3, MP_GR0 + 10, s2) ; subblock_gain[window]
        ldi s12, #-3
        alu s3, s12, s3, #ASR
        alu s10, s10, s3, #OP_SUB ; - 8 subblock_gain
        alu s1, s1, s14, #OP_ADD
        ldi s12, #3
        alu s12, s1, s12, #OP_SUB
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, wput
        nop()
        nop()
        ldi s1, #0
wput:   mp3_put(MP_QW, 1)
sf:     lde e7, #MP_QSF
        ldy s1, e7
        alu s13, s1, s14, #OP_SUB
        x17.mve e7, s13
        ldy s2, e7              ; sf (an intensity mark at 0x100 dropped)
        ldi s12, #0xFF
        x18.and s2, s2, s12
        alu s1, s1, s14, #OP_ADD
        mp3_put(MP_QSF, 1)
        lde e7, #MP_QPF
        ldy s1, e7
        alu s13, s1, s14, #OP_SUB
        x17.mve e7, s13
        ldy s3, e7              ; pretab or 0
        alu s2, s2, s3, #OP_ADD
        alu s1, s1, s14, #OP_ADD
        mp3_put(MP_QPF, 1)
        lde e7, #MP_QSH
        ldy s3, e7
        alu s2, s3, s2, #ASR    ; << shift
        alu s10, s10, s2, #OP_SUB ; t
        ldi s12, #2
        alu s2, s12, s10, #ASR  ; sh = floor(t / 4)
        ldi s12, #-2
        alu s3, s12, s2, #ASR
        alu s3, s10, s3, #OP_SUB ; b
        ldi s11, #DQ_G
        alu s11, s11, s3, #OP_ADD ; DQ_G + b
        ldi s12, #23
        alu s10, s2, s12, #OP_ADD ; sh + 23
        lde e7, #MP_QE
        ldy s1, e7
        alu s1, s1, s14, #OP_ADD
        mp3_put(MP_QE, 1)
        ; the lines: s9 left, s10 = sh + 23, s11 = DQ_G + b
line:   x19.xrd s1, #10         ; q
        alu s12, s1, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, next
        nop()
        nop()
        ptst p3, s0, #LT12, #PTST
        jmp #IF_NOT, #3, mag
        nop()
        nop()
        alu s1, s0, s1, #OP_SUB ; |q|
mag:    dq_mant()
        alu s4, s11, s5, #OP_ADD
        amov_e(4, s4)
        x19.xrd s7, #8          ; G
        x02.mpy s8, s2, s7      ; P = round(m G / 2^23)
        alu s3, s3, s10, #OP_ADD ; em + sh + 23
        mp3_clamp24(s3)
        alu s12, s0, s3, #OP_SUB
        alu s8, s12, s8, #ASRRS ; rshr, or saturating shl (fact 774)
        x19.xrd s4, #10
        ptst p3, s0, #LT4, #PTST
        jmp #IF_NOT, #3, put
        nop()
        nop()
        alu s8, s0, s8, #OP_SUB
put:    stx A10, s8
next:   x02.ainc #10, #10
        alu s9, s9, s14, #OP_SUB
        alu s12, s9, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, line
        nop()
        nop()
        jmp #ALWAYS, #0, ent
        nop()
        nop()
done:
}

; ---------------------------------------------------------------------------
; Joint stereo (twin: ref/dsp/mp3/stereo.zig; ISO/IEC 11172-3 2.4.3.4.9, 13818-3 2.4.3.2) on
; granule MP_SGR's two channels, X:MP_XS + 576 (2 gr) and + 576 (2 gr + 1). M/S: l, r =
; rshr(2 (m c +- s c), 24), c = 1/sqrt 2 in Q23, two x03.tap sums (exact 48 bits, 790..794)
; read back as hi + [lo < 0]. Intensity: l, r = rshr(rshr(2 x k, 23), d), k Q22 from MP_XST.
; The taps' X loads are unused: they walk A11 from MP_XDUM.

; acc {hi, lo} read back: dst = rshr(acc, 24) = hi + [lo < 0]. Uses s12, s13.
.macro mp3_rd24(dst, hi, lo) {
        ldi s12, #23
        alu s13, s12, lo, #ASR  ; -1 when lo < 0
        alu dst, hi, s13, #OP_SUB
}

; M/S on s9 line pairs at A8 (m -> l), A9 (s -> r). Uses s1..s13, A10, R7.
.macro mp3_ms_lines() {
        aimm_e(5, MP_XST + 18)
        x19.xrd s4, #10         ; 1/sqrt 2, Q23 (A10)
        alu s5, s0, s4, #OP_SUB
ml:     x19.xrd s1, #8          ; m
        x19.xrd s7, #9          ; s
        alu s6, s1, s0, #OP_ADD
        alu s8, s7, s0, #OP_ADD
        x03.tap0 s1, #11, s4, s2, s3 ; 2 m c
        x03.tap s7, #11, s4, s2, s3 ; + 2 s c
        x03.tap0 s6, #11, s4, s10, s11 ; 2 m c
        x03.tap s8, #11, s5, s10, s11 ; - 2 s c
        mp3_rd24(s1, s2, s3)
        mp3_rd24(s7, s10, s11)
        stx A8, s1
        stx A9, s7
        x02.ainc #8, #8
        x02.ainc #9, #9
        alu s9, s9, s14, #OP_SUB
        alu s12, s9, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, ml
        nop()
        nop()
}

; Intensity on s9 line pairs: x at A8, l = gain(x, s4, s6), r = gain(x, s5, s7) to A8, A9.
; gain(x, k, d) = rshr(rshr(2 x k, 23), d), d in 0..24. Uses s1..s3, s8, s10..s13.
.macro mp3_is_lines() {
il:     x19.xrd s1, #8          ; x
        alu s8, s1, s0, #OP_ADD
        x03.tap0 s1, #11, s4, s2, s3 ; 2 x kl
        x03.tap0 s8, #11, s5, s10, s11 ; 2 x kr
        ; rshr(acc, 23) = 2 (hi + [lo < 0]) + rshr(lo, 23)
        mp3_rd24(s1, s2, s3)
        alu s1, s1, s1, #OP_ADD
        ldi s12, #23
        alu s13, s12, s3, #ASRRS
        alu s1, s1, s13, #OP_ADD
        alu s1, s6, s1, #ASRRS  ; rshr by dl
        mp3_rd24(s8, s10, s11)
        alu s8, s8, s8, #OP_ADD
        ldi s12, #23
        alu s13, s12, s11, #ASRRS
        alu s8, s8, s13, #OP_ADD
        alu s8, s7, s8, #ASRRS  ; rshr by dr
        stx A8, s1
        stx A9, s8
        x02.ainc #8, #8
        x02.ainc #9, #9
        alu s9, s9, s14, #OP_SUB
        alu s12, s9, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, il
        nop()
        nop()
}

; The granule in MP_SGR. Uses every s register but s14, s15, e5, e7, A8..A11 and amov's.
.macro mp3_stereo() {
        lde e7, #MH_NCH
        ldy s12, e7
        ldi s13, #2
        alu s12, s12, s13, #OP_SUB
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, done
        nop()
        nop()
        lde e7, #MH_MODE
        ldy s12, e7
        alu s12, s12, s14, #OP_SUB
        ptst p3, s0, #EQ12, #PTST ; joint stereo
        jmp #IF_NOT, #3, done
        nop()
        nop()
        aimm(A11, MP_XDUM)
        lde e7, #MP_SGR
        ldy s1, e7
        ldi s12, #1152
        x18.mpy s2, s0, s1, s12
        ldi s12, #MP_XS
        alu s2, s2, s12, #OP_ADD
        amov(A8, s2)
        ldi s12, #576
        alu s2, s2, s12, #OP_ADD
        amov(A9, s2)
        lde e7, #MH_EXT
        ldy s1, e7
        x18.and s12, s1, s14
        ptst p3, s0, #EQ12, #PTST ; no intensity
        jmp #IF_NOT, #3, ist
        nop()
        nop()
        ldi s12, #2
        x18.and s12, s1, s12
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, done
        nop()
        nop()
        ldi s9, #576
        mp3_ms_lines()
        jmp #ALWAYS, #0, done
        nop()
        nop()
        ; intensity: max_band[e mod 3], the last entry whose right lines are not all zero
ist:    lde e7, #MP_SGR
        ldy s1, e7
        alu s1, s1, s1, #OP_ADD ; k = 2 gr
        mp3_blist()
        mp3_put(MP_SLP, 2)
        mp3_put(MP_QKIND, 6)
        ldi s1, #-1
        mp3_put(MP_SMB, 1)
        mp3_put(MP_SMB + 1, 1)
        mp3_put(MP_SMB + 2, 1)
        lde e7, #MP_SGR
        ldy s1, e7
        ldi s12, #1152
        x18.mpy s2, s0, s1, s12
        ldi s12, #MP_XS + 576
        alu s2, s2, s12, #OP_ADD
        amov(A10, s2)
        ldi s3, #0              ; e
        ldi s4, #0              ; e mod 3
        lde e7, #MP_SLP
        ldy s5, e7              ; list pointer
scan:   alu s13, s5, s14, #OP_SUB
        x17.mve e7, s13
        ldy s9, e7              ; width
        alu s12, s9, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, scand
        nop()
        nop()
        ldi s6, #0              ; any non-zero
sl:     x19.xrd s1, #10
        x02.ainc #10, #10
        alu s12, s1, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, sz
        nop()
        nop()
        ldi s6, #1
sz:     alu s9, s9, s14, #OP_SUB
        alu s12, s9, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, sl
        nop()
        nop()
        alu s12, s6, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, snext
        nop()
        nop()
        ldi s13, #MP_SMB - 1
        alu s13, s13, s4, #OP_ADD
        x17.mve e7, s13
        x17.sty e7, #3, #0      ; max_band[e mod 3] = e
snext:  alu s3, s3, s14, #OP_ADD
        alu s4, s4, s14, #OP_ADD
        ldi s12, #3
        alu s12, s4, s12, #OP_SUB
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, s3ok
        nop()
        nop()
        ldi s4, #0
s3ok:   alu s5, s5, s14, #OP_ADD
        jmp #ALWAYS, #0, scan
        nop()
        nop()
scand:  mp3_put(MP_SN, 3)
        ; a block with long entries (long, mixed) takes the largest of the three
        lde e7, #MP_QKIND
        ldy s6, e7
        alu s12, s6, s14, #OP_SUB
        ptst p3, s0, #EQ12, #PTST ; short
        jmp #3, #3, mbok
        nop()
        nop()
        lde e7, #MP_SMB
        ldy s1, e7
        lde e7, #MP_SMB + 1
        ldy s2, e7
        alu s12, s1, s2, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #IF_NOT, #3, m1
        nop()
        nop()
        alu s1, s2, s0, #OP_ADD
m1:     lde e7, #MP_SMB + 2
        ldy s2, e7
        alu s12, s1, s2, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #IF_NOT, #3, m2
        nop()
        nop()
        alu s1, s2, s0, #OP_ADD
m2:     mp3_put(MP_SMB, 1)
        mp3_put(MP_SMB + 1, 1)
        mp3_put(MP_SMB + 2, 1)
        ; positions: the right channel's scale factors, the top entries per block extended
mbok:   lde e7, #MP_SGR
        ldy s1, e7
        alu s1, s1, s1, #OP_ADD
        alu s1, s1, s14, #OP_ADD ; k = 2 gr + 1
        ldi s12, #40
        x18.mpy s2, s0, s1, s12
        ldi s13, #MP_SF - 1
        alu s13, s13, s2, #OP_ADD
        x17.mve e5, s13
        lde e7, #MP_SPOS
        ldi s9, #40
pc:     ldy s3, e5
        alu s13, s13, s14, #OP_ADD
        x17.mve e5, s13
        x17.styi e7, #3, #0, e7
        alu s9, s9, s14, #OP_SUB
        alu s12, s9, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, pc
        nop()
        nop()
        ldi s12, #MP_GR
        x18.mpy s2, s0, s1, s12
        yidx(s3, MP_GR0 + 3, s2) ; the right granule's scalefac_compress
        x18.and s3, s3, s14
        mp3_put(MP_SSH, 3)
        ; blocks = 3 with short entries (short, mixed), else 1
        ldi s7, #1
        alu s12, s6, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, blk
        nop()
        nop()
        ldi s7, #3
blk:    ldi s8, #0              ; i
top:    lde e7, #MP_SN
        ldy s2, e7
        alu s2, s2, s7, #OP_SUB
        alu s2, s2, s8, #OP_ADD ; top = n - blocks + i
        alu s3, s2, s7, #OP_SUB ; prev = top - blocks
        yidx(s4, MP_SMB, s8)
        alu s12, s4, s3, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; max_band[i] < prev: copy prev
        jmp #3, #3, cpy
        nop()
        nop()
        lde e7, #MH_MP1
        ldy s5, e7
        alu s4, s5, s5, #OP_ADD
        alu s5, s4, s5, #OP_ADD ; 3 MPEG-1, else 0; legal
        jmp #ALWAYS, #0, tput
        nop()
        nop()
cpy:    yidx(s5, MP_SPOS, s3)
tput:   ldi s13, #MP_SPOS - 1
        alu s13, s13, s2, #OP_ADD
        x17.mve e7, s13
        x17.sty e7, #5, #0
        alu s8, s8, s14, #OP_ADD
        alu s12, s8, s7, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #3, #3, top
        nop()
        nop()
        ; each entry: intensity above max_band[e mod 3] where legal, else M/S if on
        ldi s1, #0
        mp3_put(MP_SE, 1)
        mp3_put(MP_SW, 1)
ent:    lde e7, #MP_SLP
        ldy s1, e7
        alu s13, s1, s14, #OP_SUB
        x17.mve e7, s13
        ldy s9, e7              ; width
        alu s12, s9, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, done
        nop()
        nop()
        alu s1, s1, s14, #OP_ADD
        mp3_put(MP_SLP, 1)
        lde e7, #MP_SE
        ldy s2, e7
        lde e7, #MP_SW
        ldy s3, e7
        yidx(s4, MP_SMB, s3)
        alu s12, s4, s2, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; e > max_band
        jmp #IF_NOT, #3, nois
        nop()
        nop()
        yidx(s1, MP_SPOS, s2)   ; p, bit 8 illegal
        lde e7, #MH_MP1
        ldy s12, e7
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, m2pos
        nop()
        nop()
        ldi s12, #7
        alu s12, s1, s12, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; p < 7
        jmp #IF_NOT, #3, nois
        nop()
        nop()
        ; MPEG-1: kl, kr = pan[p]
        alu s2, s1, s1, #OP_ADD
        ldi s12, #MP_XST
        alu s2, s2, s12, #OP_ADD
        amov_e(5, s2)           ; A10 (A8, A9 hold the lines)
        x19.xrd s4, #10
        x02.ainc #10, #10
        x19.xrd s5, #10
        ldi s6, #0
        ldi s7, #0
        jmp #ALWAYS, #0, isgo
        nop()
        nop()
m2pos:  ldi s12, #0x100
        alu s12, s1, s12, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; legal
        jmp #IF_NOT, #3, nois
        nop()
        nop()
        ; MPEG-2: nq = ((p + 1) >> 1) << sh, k = quarter[nq & 3] down nq >> 2, on the side p
        ; picks (odd: left), 1 on the other
        alu s2, s1, s14, #OP_ADD
        alu s2, s14, s2, #ASR
        lde e7, #MP_SSH
        ldy s3, e7
        alu s3, s0, s3, #OP_SUB
        alu s2, s3, s2, #ASR    ; nq
        ldi s12, #3
        x18.and s3, s2, s12
        ldi s12, #2
        alu s2, s12, s2, #ASR   ; nq >> 2
        ldi s12, #24
        alu s12, s12, s2, #OP_SUB
        ptst p3, s0, #LT12, #PTST
        jmp #IF_NOT, #3, dok
        nop()
        nop()
        ldi s2, #24
dok:    ldi s12, #MP_XST + 14
        alu s3, s3, s12, #OP_ADD
        amov_e(5, s3)
        x19.xrd s8, #10         ; quarter[nq & 3]
        aimm_e(5, MP_XST + 14)
        x19.xrd s10, #10        ; quarter[0] = 1
        x18.and s12, s1, s14
        ptst p3, s0, #EQ12, #PTST ; p even: right
        jmp #3, #3, rside
        nop()
        nop()
        alu s4, s8, s0, #OP_ADD
        alu s6, s0, s2, #OP_SUB
        alu s5, s10, s0, #OP_ADD
        ldi s7, #0
        jmp #ALWAYS, #0, isgo
        nop()
        nop()
rside:  alu s4, s10, s0, #OP_ADD
        ldi s6, #0
        alu s5, s8, s0, #OP_ADD
        alu s7, s0, s2, #OP_SUB
isgo:   alu s6, s0, s6, #OP_SUB ; dl, dr (negated above)
        alu s7, s0, s7, #OP_SUB
        mp3_is_lines()
        jmp #ALWAYS, #0, enext
        nop()
        nop()
nois:   lde e7, #MH_EXT
        ldy s1, e7
        ldi s12, #2
        x18.and s12, s1, s12
        ptst p3, s0, #EQ12, #PTST
        jmp #3, #3, skip
        nop()
        nop()
        mp3_ms_lines()
        jmp #ALWAYS, #0, enext
        nop()
        nop()
skip:   alu s1, s9, s0, #OP_ADD
sk:     x02.ainc #8, #8
        x02.ainc #9, #9
        alu s1, s1, s14, #OP_SUB
        alu s12, s1, s0, #OP_ADD
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, sk
        nop()
        nop()
enext:  lde e7, #MP_SE
        ldy s1, e7
        alu s1, s1, s14, #OP_ADD
        mp3_put(MP_SE, 1)
        lde e7, #MP_SW
        ldy s1, e7
        alu s1, s1, s14, #OP_ADD
        ldi s12, #3
        alu s12, s1, s12, #OP_SUB
        ptst p3, s0, #EQ12, #PTST
        jmp #IF_NOT, #3, wok
        nop()
        nop()
        ldi s1, #0
wok:    mp3_put(MP_SW, 1)
        jmp #ALWAYS, #0, ent
        nop()
        nop()
done:
}

; Joint stereo on each granule of the frame. Uses mp3_stereo's registers.
.macro mp3_joint() {
        ldi s1, #0
        mp3_put(MP_SGR, 1)
jg:     mp3_stereo()
        lde e7, #MP_SGR
        ldy s1, e7
        alu s1, s1, s14, #OP_ADD
        mp3_put(MP_SGR, 1)
        lde e7, #MH_MP1
        ldy s12, e7
        alu s12, s1, s12, #OP_SUB
        alu s12, s12, s14, #OP_SUB
        ptst p3, s0, #LT12, #PTST ; gr < granules
        jmp #3, #3, jg
        nop()
        nop()
}
